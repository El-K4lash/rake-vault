	local box = new("Frame", { Name = "Box", Position = UDim2.fromScale(0.08, 0.24), Size = UDim2.fromScale(0.84, 0.25), BackgroundColor3 = Color3.fromRGB(20, 26, 36), ZIndex = 2 }, c)
