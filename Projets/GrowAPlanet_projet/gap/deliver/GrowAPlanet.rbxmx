do
	local o = new("Frame", { Name = "Offline", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.36, 0.3), BackgroundTransparency = 1, Visible = false, ZIndex = 15 }, pops)
