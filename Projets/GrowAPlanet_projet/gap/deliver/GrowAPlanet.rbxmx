<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" version="4"><Item class="Folder" referent="RBX54"><Properties><string name="Name">GrowAPlanet_Install</string></Properties><Item class="Folder" referent="RBX19"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX18"><Properties><string name="Name">Shared</string></Properties><Item class="Folder" referent="RBX12"><Properties><string name="Name">Config</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">DailyRewards</string><ProtectedString name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Config/DailyRewards
-- Cycle de 7 jours. Si le joueur rate plus de 48 h, on revient au jour 1.
-- Money = minutes de gains actuels (avec minimum), pour rester utile à tous les niveaux.

return {
	ResetAfterHours = 48,
	Days = {
		{ Type = "Money",  Minutes = 5,  Min = 500 },
		{ Type = "Galaxy", Galaxy = "EmeraldSwirl" },
		{ Type = "Boost",  Boost = "Luck", Duration = 900 },
		{ Type = "Money",  Minutes = 20, Min = 5_000 },
		{ Type = "Galaxy", Galaxy = "AmethystSpiral" },
		{ Type = "Boost",  Boost = "Money", Duration = 1800 },
		{ Type = "Galaxy", Galaxy = "GoldenCrown" },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Galaxies</string><ProtectedString name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Config/Galaxies
-- Une galaxie par rareté. Elles apparaissent sur les spawners de la base.
--   Price      : prix en argent du jeu
--   HatchTime  : durée dans l'enclos avant de pouvoir éclore (secondes)
--   SpawnWeight: poids de tirage sur un spawner (plus c'est grand, plus c'est fréquent)
--   UpgradeChance : chance que la planète soit de la rareté AU-DESSUS (multipliée par la Luck)
--   RobuxOnly  : ne sort pas des spawners, seulement achetable dans le Shop Robux

local Galaxies = {
	Spawn = {
		Interval = 8,      -- une nouvelle galaxie sur chaque spawner libre toutes les 8 s
		Lifetime = 30,     -- si personne ne l'achète, elle disparaît après 30 s
		LuckAffects = true, -- la Luck multiplie le poids des galaxies Rare et au-dessus
	},
	List = {
		{ Id = "DustNebula",    Name = "Dust Nebula",       Rarity = "Common",    Price = 50,         HatchTime = 10,   SpawnWeight = 70,   UpgradeChance = 0.12 },
		{ Id = "EmeraldSwirl",  Name = "Emerald Swirl",     Rarity = "Rare",      Price = 500,        HatchTime = 45,   SpawnWeight = 22,   UpgradeChance = 0.10 },
		{ Id = "AmethystSpiral",Name = "Amethyst Spiral",   Rarity = "Epic",      Price = 5_000,      HatchTime = 180,  SpawnWeight = 6.5,  UpgradeChance = 0.08 },
		{ Id = "GoldenCrown",   Name = "Golden Crown",      Rarity = "Legendary", Price = 75_000,     HatchTime = 600,  SpawnWeight = 1.3,  UpgradeChance = 0.06 },
		{ Id = "CrimsonEye",    Name = "Crimson Eye",       Rarity = "Mythic",    Price = 1_500_000,  HatchTime = 1800, SpawnWeight = 0.19, UpgradeChance = 0.03 },
		{ Id = "PrismCore",     Name = "Prism Singularity", Rarity = "Secret",    Price = 50_000_000, HatchTime = 7200, SpawnWeight = 0.01, UpgradeChance = 0 },
	},
}

-- accès rapide par Id
Galaxies.ById = {}
for _, g in ipairs(Galaxies.List) do
	Galaxies.ById[g.Id] = g
end

return Galaxies
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Gamepasses</string><ProtectedString name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Config/Gamepasses
-- Id = 0 tant que le pass n'est pas créé sur le site Roblox (Creator Hub).

return {
	DoubleMoney = { Id = 0, Name = "x2 Money",       Price = 399 },
	DoubleLuck  = { Id = 0, Name = "x2 Luck",        Price = 299 },
	FastHatch   = { Id = 0, Name = "Fast Hatch",     Price = 249, Value = 0.5 }, -- timers x0.5 (cumulable avec l'upgrade)
	ExtraSlots  = { Id = 0, Name = "+2 Equip Slots", Price = 199, Value = 2 },
	FourthSpawner = { Id = 0, Name = "4th Spawner",  Price = 349 },
	AutoHatch   = { Id = 0, Name = "Auto Hatch",     Price = 149 },
	VIP         = { Id = 0, Name = "VIP",            Price = 499, MoneyBonus = 0.25 }, -- +25 % argent, tag VIP
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">IndexRewards</string><ProtectedString name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Config/IndexRewards
-- Compléter toutes les planètes d'une rareté dans l'Index (sans mutation) débloque
-- un bonus d'argent PERMANENT à réclamer. Bonus = +X (0.05 = +5 %).

return {
	Bonus = {
		Common = 0.05,
		Rare = 0.05,
		Epic = 0.10,
		Legendary = 0.10,
		Mythic = 0.15,
		Secret = 0.25,
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">Mutations</string><ProtectedString name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Config/Mutations
-- Tirées à l'éclosion, une seule possible. Chance de base, multipliée par la Luck (voir LuckFactor).
-- Ordre de test : la plus rare d'abord.

local Mutations = {
	LuckFactor = 0.5, -- Luck x2 → chances de mutation x1.5 (moins fort que sur la rareté)
	List = {
		{ Id = "Rainbow", Name = "Rainbow", Chance = 0.002, Multiplier = 10, Color = Color3.fromRGB(255, 255, 255), Rainbow = true },
		{ Id = "Fire",    Name = "On Fire", Chance = 0.01,  Multiplier = 5,  Color = Color3.fromRGB(255, 110, 30) },
		{ Id = "Frozen",  Name = "Frozen",  Chance = 0.025, Multiplier = 3,  Color = Color3.fromRGB(140, 220, 255) },
		{ Id = "Golden",  Name = "Golden",  Chance = 0.05,  Multiplier = 2,  Color = Color3.fromRGB(255, 205, 50) },
	},
}

Mutations.ById = {}
for _, m in ipairs(Mutations.List) do
	Mutations.ById[m.Id] = m
end

return Mutations
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">Planets</string><ProtectedString name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Config/Planets
-- 5 planètes par rareté. Income = argent par seconde quand elle est équipée.
-- Weight = chance relative DANS sa rareté (35/28/20/12/5 → la 5e est la plus rare et rapporte le plus).
-- Look = indications pour le modèle 3D (couleur principale, anneau, etc.)

local Planets = {
	List = {
		-- COMMON
		{ Id = "RockyPebble",  Name = "Rocky Pebble",   Rarity = "Common", Income = 1,  Weight = 35, Look = { Color = Color3.fromRGB(150, 140, 130) } },
		{ Id = "DustBall",     Name = "Dust Ball",      Rarity = "Common", Income = 2,  Weight = 28, Look = { Color = Color3.fromRGB(200, 170, 120) } },
		{ Id = "MossyMoon",    Name = "Mossy Moon",     Rarity = "Common", Income = 3,  Weight = 20, Look = { Color = Color3.fromRGB(120, 160, 100) } },
		{ Id = "ClayOrb",      Name = "Clay Orb",       Rarity = "Common", Income = 4,  Weight = 12, Look = { Color = Color3.fromRGB(190, 110, 80) } },
		{ Id = "FoggyRock",    Name = "Foggy Rock",     Rarity = "Common", Income = 6,  Weight = 5,  Look = { Color = Color3.fromRGB(170, 180, 200), Ring = true } },
		-- RARE
		{ Id = "OceanBubble",  Name = "Ocean Bubble",   Rarity = "Rare", Income = 8,  Weight = 35, Look = { Color = Color3.fromRGB(40, 140, 255) } },
		{ Id = "JungleSphere", Name = "Jungle Sphere",  Rarity = "Rare", Income = 11, Weight = 28, Look = { Color = Color3.fromRGB(40, 190, 70) } },
		{ Id = "MintRing",     Name = "Mint Ring",      Rarity = "Rare", Income = 14, Weight = 20, Look = { Color = Color3.fromRGB(120, 255, 200), Ring = true } },
		{ Id = "CoralReef",    Name = "Coral Reef",     Rarity = "Rare", Income = 18, Weight = 12, Look = { Color = Color3.fromRGB(255, 130, 120) } },
		{ Id = "LimeComet",    Name = "Lime Comet",     Rarity = "Rare", Income = 25, Weight = 5,  Look = { Color = Color3.fromRGB(190, 255, 60), Tail = true } },
		-- EPIC
		{ Id = "CrystalCore",  Name = "Crystal Core",   Rarity = "Epic", Income = 60,  Weight = 35, Look = { Color = Color3.fromRGB(150, 220, 255), Crystals = true } },
		{ Id = "NeonStorm",    Name = "Neon Storm",     Rarity = "Epic", Income = 80,  Weight = 28, Look = { Color = Color3.fromRGB(0, 255, 230) } },
		{ Id = "AmethystGiant",Name = "Amethyst Giant", Rarity = "Epic", Income = 105, Weight = 20, Look = { Color = Color3.fromRGB(160, 70, 255), Ring = true } },
		{ Id = "VoidJelly",    Name = "Void Jelly",     Rarity = "Epic", Income = 135, Weight = 12, Look = { Color = Color3.fromRGB(90, 30, 160) } },
		{ Id = "PlasmaPearl",  Name = "Plasma Pearl",   Rarity = "Epic", Income = 180, Weight = 5,  Look = { Color = Color3.fromRGB(255, 120, 255), Glow = true } },
		-- LEGENDARY
		{ Id = "GoldenSaturn", Name = "Golden Saturn",  Rarity = "Legendary", Income = 500,  Weight = 35, Look = { Color = Color3.fromRGB(255, 200, 60), Ring = true } },
		{ Id = "SunForge",     Name = "Sun Forge",      Rarity = "Legendary", Income = 650,  Weight = 28, Look = { Color = Color3.fromRGB(255, 140, 30), Glow = true } },
		{ Id = "HoneyNova",    Name = "Honey Nova",     Rarity = "Legendary", Income = 850,  Weight = 20, Look = { Color = Color3.fromRGB(255, 220, 110) } },
		{ Id = "CrownWorld",   Name = "Crown World",    Rarity = "Legendary", Income = 1100, Weight = 12, Look = { Color = Color3.fromRGB(255, 230, 150), Crystals = true } },
		{ Id = "AmberTitan",   Name = "Amber Titan",    Rarity = "Legendary", Income = 1500, Weight = 5,  Look = { Color = Color3.fromRGB(230, 130, 20), Ring = true, Glow = true } },
		-- MYTHIC
		{ Id = "CrimsonEye",   Name = "Crimson Eye",    Rarity = "Mythic", Income = 5_000,  Weight = 35, Look = { Color = Color3.fromRGB(220, 30, 60) } },
		{ Id = "BloodMoon",    Name = "Blood Moon",     Rarity = "Mythic", Income = 6_500,  Weight = 28, Look = { Color = Color3.fromRGB(160, 0, 30), Glow = true } },
		{ Id = "HeartNebula",  Name = "Heart Nebula",   Rarity = "Mythic", Income = 8_500,  Weight = 20, Look = { Color = Color3.fromRGB(255, 90, 160) } },
		{ Id = "InfernoPrime", Name = "Inferno Prime",  Rarity = "Mythic", Income = 11_000, Weight = 12, Look = { Color = Color3.fromRGB(255, 70, 0), Glow = true } },
		{ Id = "RoseQuasar",   Name = "Rose Quasar",    Rarity = "Mythic", Income = 15_000, Weight = 5,  Look = { Color = Color3.fromRGB(255, 40, 120), Ring = true, Glow = true } },
		-- SECRET
		{ Id = "PrismSingularity", Name = "Prism Singularity", Rarity = "Secret", Income = 80_000,  Weight = 35, Look = { Rainbow = true } },
		{ Id = "RainbowAbyss",     Name = "Rainbow Abyss",     Rarity = "Secret", Income = 100_000, Weight = 28, Look = { Rainbow = true, Ring = true } },
		{ Id = "CosmicEgg",        Name = "Cosmic Egg",        Rarity = "Secret", Income = 130_000, Weight = 20, Look = { Rainbow = true, Glow = true } },
		{ Id = "OmegaStar",        Name = "Omega Star",        Rarity = "Secret", Income = 170_000, Weight = 12, Look = { Rainbow = true, Glow = true } },
		{ Id = "TheGlitch",        Name = "The Glitch",        Rarity = "Secret", Income = 250_000, Weight = 5,  Look = { Rainbow = true, Glitch = true } },
	},
}

Planets.ById = {}
Planets.ByRarity = {}
for _, p in ipairs(Planets.List) do
	Planets.ById[p.Id] = p
	Planets.ByRarity[p.Rarity] = Planets.ByRarity[p.Rarity] or {}
	table.insert(Planets.ByRarity[p.Rarity], p)
end

return Planets
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">Products</string><ProtectedString name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Config/Products
-- Developer products (achats répétables). Id = 0 tant que non créés.
-- Les packs d'argent donnent X minutes de gains actuels (minimum garanti) pour rester utiles toute la partie.

return {
	BoostMoney15 = { Id = 0, Name = "x2 Money (15 min)", Price = 49, Boost = "Money", Duration = 900 },
	BoostLuck15  = { Id = 0, Name = "x2 Luck (15 min)",  Price = 49, Boost = "Luck",  Duration = 900 },
	SkipOne      = { Id = 0, Name = "Skip 1 Galaxy",     Price = 25 },
	SkipAll      = { Id = 0, Name = "Skip All",          Price = 99 },
	CashSmall    = { Id = 0, Name = "Cash Pack S", Price = 25,  Minutes = 10,  Min = 1_000 },
	CashMedium   = { Id = 0, Name = "Cash Pack M", Price = 99,  Minutes = 60,  Min = 10_000 },
	CashLarge    = { Id = 0, Name = "Cash Pack L", Price = 399, Minutes = 360, Min = 100_000 },
	StarterPack  = { Id = 0, Name = "Starter Pack", Price = 99, OncePerPlayer = true,
		Gives = { Money = 25_000, Galaxy = "GoldenCrown", Boost = "Money", BoostDuration = 1800 } },
	MythicGalaxy = { Id = 0, Name = "Crimson Eye Galaxy",     Price = 199, Galaxy = "CrimsonEye", ShowOdds = true },
	SecretGalaxy = { Id = 0, Name = "Prism Singularity",      Price = 799, Galaxy = "PrismCore",  ShowOdds = true },
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Rarities</string><ProtectedString name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Config/Rarities
-- Les 6 raretés du jeu, de la plus commune à la plus rare.
-- Order : sert à trier et à savoir quelle rareté est « au-dessus ».
-- Color : utilisée partout (bordures, textes, effets). Secret = arc-en-ciel (Rainbow = true).

local Rarities = {
	List = { "Common", "Rare", "Epic", "Legendary", "Mythic", "Secret" },
	Info = {
		Common    = { Order = 1, Name = "Common",    Color = Color3.fromRGB(190, 195, 205), Dark = Color3.fromRGB(70, 75, 85) },
		Rare      = { Order = 2, Name = "Rare",      Color = Color3.fromRGB(85, 225, 95),   Dark = Color3.fromRGB(20, 95, 35) },
		Epic      = { Order = 3, Name = "Epic",      Color = Color3.fromRGB(170, 85, 255),  Dark = Color3.fromRGB(70, 20, 130) },
		Legendary = { Order = 4, Name = "Legendary", Color = Color3.fromRGB(255, 200, 40),  Dark = Color3.fromRGB(130, 80, 0) },
		Mythic    = { Order = 5, Name = "Mythic",    Color = Color3.fromRGB(255, 70, 120),  Dark = Color3.fromRGB(120, 10, 45) },
		Secret    = { Order = 6, Name = "Secret",    Color = Color3.fromRGB(255, 255, 255), Dark = Color3.fromRGB(40, 20, 70), Rainbow = true },
	},
}

-- rareté juste au-dessus (nil pour Secret)
function Rarities.Next(rarity: string): string?
	local info = Rarities.Info[rarity]
	return info and Rarities.List[info.Order + 1] or nil
end

return Rarities
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">Rebirth</string><ProtectedString name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Config/Rebirth
-- Rebirth : argent remis à 0. On GARDE planètes, upgrades et galaxies dans l'enclos.
-- Gain : multiplicateur d'argent permanent + 1 emplacement d'équipement (max +5).

local Rebirth = {
	Cost = function(rebirths: number): number return math.floor(10_000_000 * 4 ^ rebirths) end,
	Multiplier = function(rebirths: number): number return 1 + 0.5 * rebirths end,
	BonusSlots = function(rebirths: number): number return math.min(rebirths, 5) end,
}

return Rebirth
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">UIAssets</string><ProtectedString name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Config/UIAssets
-- Images de l'interface mises en ligne sur Roblox. 0 = pas encore uploadée
-- (le jeu affiche alors un modèle 3D à la place).
-- ⚠ Il faut l'ID de l'IMAGE, pas celui du Decal (decal Galaxies 137489606724976, Planets 117371785103148).
-- Fichiers sources : deliver/icons/Icon_Galaxies.png et Icon_Planets.png (faits dans Figma).

return {
	IconGalaxies = 102775835546583,
	IconPlanets = 110187389445730,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">Upgrades</string><ProtectedString name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Config/Upgrades
-- Panneau d'upgrades de la base. Cost(level) = prix pour passer au niveau suivant.

local Upgrades = {
	Luck = {
		Name = "Luck", MaxLevel = 10,
		Value = function(level: number): number return 1 + 0.15 * level end, -- x1.00 → x2.50
		Cost = function(level: number): number return math.floor(1_000 * 3 ^ level) end,
	},
	Spawners = {
		Name = "Spawners", MaxLevel = 2, -- niveau 0 = 1 spawner, niveau 2 = 3 spawners (4e = gamepass)
		Value = function(level: number): number return 1 + level end,
		Cost = function(level: number): number return ({ 25_000, 1_000_000 })[level + 1] or math.huge end,
	},
	HatchSpeed = {
		Name = "Hatch Speed", MaxLevel = 10,
		Value = function(level: number): number return 1 - 0.05 * level end, -- temps x1.00 → x0.50
		Cost = function(level: number): number return math.floor(2_000 * 2.8 ^ level) end,
	},
}

-- règles de base du joueur
Upgrades.Base = {
	EquipSlots = 3,       -- planètes équipées au départ
	IncubatorSlots = 6,   -- galaxies en même temps dans l'enclos
	InventoryMax = 200,   -- planètes stockées max
	OfflineRate = 0.5,    -- 50 % des gains pendant l'absence
	OfflineMaxHours = 8,
	SellSeconds = 20,     -- revendre une planète = 20 s de ses gains de base
	AutoHatchInterval = 2, -- gamepass Auto-Éclore : vérifie toutes les 2 s
}

return Upgrades
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX15"><Properties><string name="Name">Util</string></Properties><Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">Format</string><ProtectedString name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Util/Format
-- Mise en forme des nombres et des durées pour l'affichage (client et serveur).

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

-- 1234 -> "1.23K", 1500000 -> "1.5M"
function Format.Number(n: number): string
	if n ~= n then return "0" end
	local negative = n < 0
	n = math.abs(n)
	if n < 1000 then
		local s = tostring(math.floor(n))
		return negative and "-" .. s or s
	end
	local i = 1
	while n >= 1000 and i < #SUFFIXES do
		n /= 1000
		i += 1
	end
	local s
	if n >= 100 then
		s = string.format("%d", math.floor(n))
	elseif n >= 10 then
		s = string.format("%.1f", math.floor(n * 10) / 10)
	else
		s = string.format("%.2f", math.floor(n * 100) / 100)
	end
	if s:find("%.") then s = s:gsub("%.?0+$", "") end
	return (negative and "-" or "") .. s .. SUFFIXES[i]
end

function Format.Money(n: number): string
	return "$" .. Format.Number(n)
end

-- 75 -> "1m 15s", 3700 -> "1h 01m", 9 -> "9s"
function Format.Time(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	if seconds < 60 then
		return seconds .. "s"
	elseif seconds < 3600 then
		return string.format("%dm %02ds", seconds // 60, seconds % 60)
	elseif seconds < 86400 then
		return string.format("%dh %02dm", seconds // 3600, (seconds % 3600) // 60)
	end
	return string.format("%dd %02dh", seconds // 86400, (seconds % 86400) // 3600)
end

-- 0.0123 -> "1.23%", 0.00001 -> "0.001%"
function Format.Percent(p: number): string
	local v = p * 100
	if v >= 10 then return (string.format("%.1f", v):gsub("%.0$", "")) .. "%" end
	if v >= 1 then return (string.format("%.2f", v):gsub("%.?0+$", "")) .. "%" end
	if v >= 0.01 then return (string.format("%.3f", v):gsub("%.?0+$", "")) .. "%" end
	return (string.format("%.4f", v):gsub("%.?0+$", "")) .. "%"
end

return Format
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">Formulas</string><ProtectedString name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Util/Formulas
-- TOUTES les règles de calcul du jeu, au même endroit, utilisées par le serveur
-- (qui décide) et par le client (qui affiche les mêmes chiffres).
-- Ce module ne touche à rien dans le jeu : il calcule seulement.

local Config = script.Parent.Parent:WaitForChild("Config")
local Rarities = require(Config:WaitForChild("Rarities"))
local Galaxies = require(Config:WaitForChild("Galaxies"))
local Planets = require(Config:WaitForChild("Planets"))
local Mutations = require(Config:WaitForChild("Mutations"))
local Upgrades = require(Config:WaitForChild("Upgrades"))
local Rebirth = require(Config:WaitForChild("Rebirth"))
local Gamepasses = require(Config:WaitForChild("Gamepasses"))
local IndexRewards = require(Config:WaitForChild("IndexRewards"))

local Formulas = {}

-- État minimal du joueur dont les calculs ont besoin.
-- Le serveur le construit depuis la sauvegarde, le client depuis ce que le serveur lui envoie.
export type PlayerState = {
	Rebirths: number,
	Upgrades: { [string]: number },
	Passes: { [string]: boolean },
	Boosts: { [string]: number }, -- nom -> os.time() de fin
	IndexClaimed: { [string]: boolean }, -- rareté -> bonus de collection réclamé
	Now: number,
}

local function boostActive(state: PlayerState, name: string): boolean
	local ends = state.Boosts[name]
	return ends ~= nil and ends > state.Now
end
Formulas.BoostActive = boostActive

-- [ ARGENT ] -----------------------------------------------------------------

-- argent/s d'une planète seule (sans les bonus du joueur)
function Formulas.PlanetIncome(planetId: string, mutationId: string?): number
	local p = Planets.ById[planetId]
	if not p then return 0 end
	local mult = 1
	if mutationId and Mutations.ById[mutationId] then
		mult = Mutations.ById[mutationId].Multiplier
	end
	return p.Income * mult
end

-- bonus de collection de l'Index (somme des raretés complétées et réclamées)
function Formulas.IndexBonus(state: PlayerState): number
	local total = 0
	for rarity, claimed in pairs(state.IndexClaimed) do
		if claimed and IndexRewards.Bonus[rarity] then
			total += IndexRewards.Bonus[rarity]
		end
	end
	return total
end

-- multiplicateur total d'argent du joueur
function Formulas.MoneyMultiplier(state: PlayerState): number
	local m = Rebirth.Multiplier(state.Rebirths)
	if state.Passes.DoubleMoney then m *= 2 end
	if boostActive(state, "Money") then m *= 2 end
	if state.Passes.VIP then m *= 1 + Gamepasses.VIP.MoneyBonus end
	m *= 1 + Formulas.IndexBonus(state)
	return m
end

-- [ LUCK ] -------------------------------------------------------------------

function Formulas.Luck(state: PlayerState): number
	local l = Upgrades.Luck.Value(state.Upgrades.Luck or 0)
	if state.Passes.DoubleLuck then l *= 2 end
	if boostActive(state, "Luck") then l *= 2 end
	return l
end

-- [ CAPACITÉS ] --------------------------------------------------------------

function Formulas.EquipSlots(state: PlayerState): number
	local n = Upgrades.Base.EquipSlots + Rebirth.BonusSlots(state.Rebirths)
	if state.Passes.ExtraSlots then n += Gamepasses.ExtraSlots.Value end
	return n
end

function Formulas.SpawnerCount(state: PlayerState): number
	local n = Upgrades.Spawners.Value(state.Upgrades.Spawners or 0)
	if state.Passes.FourthSpawner then n += 1 end
	return n
end

-- durée réelle d'éclosion d'une galaxie (secondes)
function Formulas.HatchDuration(galaxyId: string, state: PlayerState): number
	local g = Galaxies.ById[galaxyId]
	if not g then return 10 end
	local t = g.HatchTime * Upgrades.HatchSpeed.Value(state.Upgrades.HatchSpeed or 0)
	if state.Passes.FastHatch then t *= Gamepasses.FastHatch.Value end
	return math.max(1, math.floor(t + 0.5))
end

-- prix de revente d'une planète (en secondes de gains de base)
function Formulas.SellValue(planetId: string, mutationId: string?): number
	return math.floor(Formulas.PlanetIncome(planetId, mutationId) * Upgrades.Base.SellSeconds)
end

-- [ TIRAGES ] ----------------------------------------------------------------
-- rng = Random.new() côté serveur. Toutes les chances sont calculées ici
-- pour que l'affichage des chances (règle Roblox) soit EXACTEMENT ce qui est tiré.

-- poids d'apparition des galaxies sur un spawner, avec la Luck
function Formulas.GalaxyWeights(luck: number): { { id: string, weight: number } }
	local list = {}
	for _, g in ipairs(Galaxies.List) do
		if not g.RobuxOnly then
			local w = g.SpawnWeight
			if Galaxies.Spawn.LuckAffects and Rarities.Info[g.Rarity].Order >= 2 then
				w *= luck
			end
			table.insert(list, { id = g.Id, weight = w })
		end
	end
	return list
end

local function pickWeighted(rng: Random, list: { { id: string, weight: number } }): string
	local total = 0
	for _, e in ipairs(list) do total += e.weight end
	local r = rng:NextNumber() * total
	for _, e in ipairs(list) do
		r -= e.weight
		if r <= 0 then return e.id end
	end
	return list[#list].id
end
Formulas.PickWeighted = pickWeighted

function Formulas.RollGalaxy(rng: Random, luck: number): string
	return pickWeighted(rng, Formulas.GalaxyWeights(luck))
end

-- chance de monter d'une rareté à l'éclosion (plafonnée à 50 %)
function Formulas.UpgradeChance(galaxyId: string, luck: number): number
	local g = Galaxies.ById[galaxyId]
	if not g or not Rarities.Next(g.Rarity) then return 0 end
	return math.min(0.5, g.UpgradeChance * luck)
end

-- liste complète des planètes possibles d'une galaxie avec leur chance exacte
function Formulas.PlanetOdds(galaxyId: string, luck: number): { { id: string, chance: number } }
	local g = Galaxies.ById[galaxyId]
	local odds = {}
	if not g then return odds end
	local up = Formulas.UpgradeChance(galaxyId, luck)
	local function addRarity(rarity: string, share: number)
		local pool = Planets.ByRarity[rarity]
		if not pool or share <= 0 then return end
		local total = 0
		for _, p in ipairs(pool) do total += p.Weight end
		for _, p in ipairs(pool) do
			table.insert(odds, { id = p.Id, chance = share * p.Weight / total })
		end
	end
	addRarity(g.Rarity, 1 - up)
	local nextRarity = Rarities.Next(g.Rarity)
	if nextRarity then addRarity(nextRarity, up) end
	return odds
end

function Formulas.RollPlanet(rng: Random, galaxyId: string, luck: number): string
	local odds = Formulas.PlanetOdds(galaxyId, luck)
	local list = {}
	for _, o in ipairs(odds) do table.insert(list, { id = o.id, weight = o.chance }) end
	return pickWeighted(rng, list)
end

-- chance de chaque mutation avec la Luck
function Formulas.MutationChance(mutationId: string, luck: number): number
	local m = Mutations.ById[mutationId]
	if not m then return 0 end
	return m.Chance * (1 + (luck - 1) * Mutations.LuckFactor)
end

function Formulas.RollMutation(rng: Random, luck: number): string?
	-- un seul tirage pour toutes les mutations : la plus rare est testée en premier
	local r = rng:NextNumber()
	for _, m in ipairs(Mutations.List) do
		local c = Formulas.MutationChance(m.Id, luck)
		if r < c then return m.Id end
		r -= c
	end
	return nil
end

-- [ UPGRADES / REBIRTH ] -----------------------------------------------------

function Formulas.UpgradeCost(name: string, level: number): number?
	local u = Upgrades[name]
	if not u or not u.MaxLevel or level >= u.MaxLevel then return nil end
	return u.Cost(level)
end

function Formulas.RebirthCost(rebirths: number): number
	return Rebirth.Cost(rebirths)
end

return Formulas
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX17"><Properties><string name="Name">Visuals</string></Properties><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">Models</string><ProtectedString name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Visuals/Models
-- Fabrique les modèles des galaxies et des planètes en BLOCS (style brique avec studs).
-- Chaque planète est une "sphère de briques" : des couches empilées, chacune en forme de croix
-- (octogone en blocs), avec des studs sur le dessus. Puis des détails selon son style :
-- cratères, bandes, continents, nuages, fissures de lave, cristaux, anneaux, lune, visage mignon.
-- Utilisé par le serveur (galaxies sur les spawners / dans l'enclos) et par le client
-- (orbites, Index, inventaire, popup d'éclosion, boutons du HUD).
-- Si un modèle existe dans ReplicatedStorage.Assets.Planets/<Id> (ou Galaxies/<Id>), il est utilisé à la place.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Config = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config")
local Rarities = require(Config.Rarities)
local Galaxies = require(Config.Galaxies)
local Planets = require(Config.Planets)
local Mutations = require(Config.Mutations)

local Models = {}

local STUDS = Enum.SurfaceType.Studs
local INLET = Enum.SurfaceType.Inlet
local SMOOTH = Enum.SurfaceType.Smooth
local INK = Color3.fromRGB(20, 22, 40)

-- [ OUTILS ] -------------------------------------------------------------------

-- une brique : Plastic + studs dessus (sauf Neon / Glass / Ice qui restent lisses)
local function block(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, transparency: number?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	local mat = material or Enum.Material.Plastic
	p.Material = mat
	p.Transparency = transparency or 0
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	if mat == Enum.Material.Plastic then
		p.TopSurface = STUDS
		p.BottomSurface = INLET
	else
		p.TopSurface = SMOOTH
		p.BottomSurface = SMOOTH
	end
	p.Parent = parent
	return p
end

local function sparkles(parent: Instance, color: Color3, rate: number, size: number)
	local att = Instance.new("Attachment")
	att.Parent = parent
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	pe.LightEmission = 1
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	pe.Lifetime = NumberRange.new(0.8, 1.6)
	pe.Speed = NumberRange.new(1, 3)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Rate = rate
	pe.Parent = att
end

local function lighten(c: Color3, a: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), a)
end
local function darken(c: Color3, a: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), a)
end

-- [ SPHÈRE DE BRIQUES ] --------------------------------------------------------
-- n couches de hauteur u. Chaque couche = 2 blocs croisés (forme octogonale).
-- Renvoie la liste des couches { y, half } (half = demi-largeur) pour poser des détails dessus.
type Layer = { y: number, half: number, index: number }

local function brickSphere(model: Model, d: number, n: number, colorAt: (number, number) -> Color3, material: Enum.Material?, name: string?): { Layer }
	local u = d / n
	local R = d / 2
	local layers = {}
	for i = 1, n do
		local y = (i - (n + 1) / 2) * u
		-- rayon au milieu de la couche, un peu "gonflé" pour un look plus rond
		local r = math.sqrt(math.max(R * R - y * y, (u * 0.6) ^ 2)) * 1.04
		local w = 2 * r
		local narrow = w * 0.62
		local col = colorAt(i, n)
		-- croix SANS chevauchement (sinon les studs du dessus clignotent) :
		-- une barre centrale + 2 morceaux devant / derrière
		local side = (w - narrow) / 2
		block(model, name or "Ball", Vector3.new(w, u, narrow), CFrame.new(0, y, 0), col, material)
		block(model, name or "Ball", Vector3.new(narrow, u, side), CFrame.new(0, y, narrow / 2 + side / 2), col, material)
		block(model, name or "Ball", Vector3.new(narrow, u, side), CFrame.new(0, y, -narrow / 2 - side / 2), col, material)
		table.insert(layers, { y = y, half = r, index = i })
	end
	return layers
end

-- point sur la surface d'une couche, dans une direction (angle autour de Y)
-- la croix a des faces plates à 0°, 90°, 180°, 270° (demi-largeur = half) et des pans à 45° (plus près)
local function surfacePoint(layer: Layer, angle: number): (Vector3, number)
	local a = angle % (math.pi * 2)
	local nearAxis = math.abs(((a + math.pi / 4) % (math.pi / 2)) - math.pi / 4) < math.pi / 8
	local dist = nearAxis and layer.half or layer.half * 0.82
	return Vector3.new(math.sin(a) * dist, layer.y, math.cos(a) * dist), dist
end

-- [ STYLES DES PLANÈTES ] ------------------------------------------------------
-- Style + couleur secondaire de chaque planète (sinon déduit de la rareté).
type Style = { kind: string, second: Color3?, moon: boolean? }
local C = Color3.fromRGB
local STYLE: { [string]: Style } = {
	RockyPebble   = { kind = "rock",    second = C(110, 100, 95) },
	DustBall      = { kind = "desert",  second = C(230, 200, 150) },
	MossyMoon     = { kind = "rock",    second = C(80, 120, 70) },
	ClayOrb       = { kind = "desert",  second = C(150, 80, 60) },
	FoggyRock     = { kind = "cloudy",  second = C(230, 235, 245) },
	OceanBubble   = { kind = "earth",   second = C(70, 200, 90) },
	JungleSphere  = { kind = "jungle",  second = C(20, 110, 40) },
	MintRing      = { kind = "gas",     second = C(200, 255, 230) },
	CoralReef     = { kind = "earth",   second = C(255, 200, 150) },
	LimeComet     = { kind = "ice",     second = C(240, 255, 200) },
	CrystalCore   = { kind = "crystal", second = C(220, 245, 255) },
	NeonStorm     = { kind = "gas",     second = C(0, 140, 160) },
	AmethystGiant = { kind = "gas",     second = C(220, 170, 255) },
	VoidJelly     = { kind = "void",    second = C(200, 90, 255) },
	PlasmaPearl   = { kind = "gas",     second = C(255, 220, 255), moon = true },
	GoldenSaturn  = { kind = "gas",     second = C(255, 240, 180) },
	SunForge      = { kind = "lava",    second = C(255, 230, 80) },
	HoneyNova     = { kind = "hive",    second = C(200, 130, 20) },
	CrownWorld    = { kind = "crystal", second = C(255, 210, 60), moon = true },
	AmberTitan    = { kind = "gas",     second = C(255, 210, 120), moon = true },
	CrimsonEye    = { kind = "eye",     second = C(255, 230, 230) },
	BloodMoon     = { kind = "rock",    second = C(90, 0, 15) },
	HeartNebula   = { kind = "candy",   second = C(255, 200, 225) },
	InfernoPrime  = { kind = "lava",    second = C(255, 200, 40), moon = true },
	RoseQuasar    = { kind = "star",    second = C(255, 180, 210) },
	PrismSingularity = { kind = "crystal", second = C(255, 255, 255) },
	RainbowAbyss  = { kind = "gas",     second = C(255, 255, 255) },
	CosmicEgg     = { kind = "egg",     second = C(255, 255, 255) },
	OmegaStar     = { kind = "star",    second = C(255, 255, 255), moon = true },
	TheGlitch     = { kind = "glitch",  second = C(0, 255, 230) },
}

-- [ GALAXIE ] ----------------------------------------------------------------
-- Cœur en briques lumineuses + bras en spirale faits de cubes + étoiles + disque en croix.
-- Taille ~ 7 studs * scale.
function Models.Galaxy(galaxyId: string, scale: number?): Model
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local custom = assets and assets:FindFirstChild("Galaxies") and assets.Galaxies:FindFirstChild(galaxyId)
	if custom and custom:IsA("Model") then
		local m = custom:Clone()
		if scale and scale ~= 1 then m:ScaleTo(scale) end
		CollectionService:AddTag(m, "Spin")
		return m
	end

	local s = scale or 1
	local g = Galaxies.ById[galaxyId]
	local rarity = Rarities.Info[g and g.Rarity or "Common"]
	local color = rarity.Color
	local order = rarity.Order
	local model = Instance.new("Model")
	model.Name = galaxyId
	local rng = Random.new(#galaxyId * 31 + order)

	-- cœur : petite sphère de briques néon + noyau blanc
	local coreD = (1.5 + order * 0.08) * s
	local center = block(model, "Core", Vector3.one * coreD * 0.55, CFrame.new(), Color3.new(1, 1, 1), Enum.Material.Neon)
	model.PrimaryPart = center
	brickSphere(model, coreD, 5, function(i, n)
		return lighten(color, 0.25 + 0.1 * math.abs(i - (n + 1) / 2))
	end, Enum.Material.Neon, "Core")

	-- halo de petits cubes autour du cœur
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		local r = coreD * 0.85
		block(model, "Arm", Vector3.one * 0.22 * s, CFrame.new(math.cos(a) * r, 0, math.sin(a) * r) * CFrame.Angles(0, a, math.rad(45)),
			Color3.new(1, 1, 1), Enum.Material.Neon)
	end

	-- bras en spirale (2 bras, 3 dès Épique)
	local arms = order >= 3 and 3 or 2
	local perArm = 8
	for arm = 0, arms - 1 do
		for i = 1, perArm do
			local t = i / perArm
			local angle = arm * (math.pi * 2 / arms) + t * math.pi * 1.5
			local r = (1.1 + t * 2.5) * s
			local size = (0.75 - t * 0.45) * s
			local cube = block(model, "Arm", Vector3.one * size,
				CFrame.new(math.cos(angle) * r, (rng:NextNumber() - 0.5) * 0.25 * s, math.sin(angle) * r)
					* CFrame.Angles(rng:NextNumber() * 3, rng:NextNumber() * 3, rng:NextNumber() * 3),
				color:Lerp(Color3.new(1, 1, 1), t * 0.55), Enum.Material.Neon, t * 0.25)
			cube.Name = "Arm"
		end
	end

	-- étoiles éparpillées (petits cubes blancs)
	for _ = 1, 10 do
		local a = rng:NextNumber() * math.pi * 2
		local r = rng:NextNumber(1.2, 3.8) * s
		block(model, "Star", Vector3.one * 0.14 * s, CFrame.new(math.cos(a) * r, rng:NextNumber(-0.4, 0.4) * s, math.sin(a) * r),
			Color3.new(1, 1, 1), Enum.Material.Neon)
	end

	-- disque : 2 plaques croisées très transparentes (octogone)
	local dw = 7.6 * s
	block(model, "Disc", Vector3.new(dw, 0.12 * s, dw * 0.62), CFrame.new(), rarity.Dark, Enum.Material.Neon, 0.7)
	local dside = (dw - dw * 0.62) / 2
	block(model, "Disc", Vector3.new(dw * 0.62, 0.12 * s, dside), CFrame.new(0, 0, dw * 0.31 + dside / 2), rarity.Dark, Enum.Material.Neon, 0.7)
	block(model, "Disc", Vector3.new(dw * 0.62, 0.12 * s, dside), CFrame.new(0, 0, -dw * 0.31 - dside / 2), rarity.Dark, Enum.Material.Neon, 0.7)

	-- raretés hautes : anneau doré incliné en blocs
	if order >= 4 then
		local tilt = CFrame.Angles(math.rad(70), 0, math.rad(15))
		for i = 1, 14 do
			local a = i / 14 * math.pi * 2
			local r = coreD * 1.25
			block(model, "Ring", Vector3.new(0.45 * s, 0.18 * s, 0.25 * s), tilt * CFrame.new(math.cos(a) * r, 0, math.sin(a) * r) * CFrame.Angles(0, -a, 0),
				i % 2 == 0 and C(255, 215, 80) or C(255, 245, 200), Enum.Material.Neon)
		end
	end

	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 10 * s
	light.Brightness = 1.6
	light.Parent = center
	sparkles(center, color, 4 + order * 2, 0.35 * s)

	if rarity.Rainbow then model:SetAttribute("Rainbow", true) end
	model:SetAttribute("Spin", 0.6 + order * 0.12)
	CollectionService:AddTag(model, "Spin")
	return model
end

-- [ PLANÈTE ] ----------------------------------------------------------------
function Models.Planet(planetId: string, mutationId: string?, size: number?): Model
	local d = size or 3
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local custom = assets and assets:FindFirstChild("Planets") and assets.Planets:FindFirstChild(planetId)
	local p = Planets.ById[planetId]
	local rarity = Rarities.Info[p and p.Rarity or "Common"]
	local look = p and p.Look or {}
	local style: Style = STYLE[planetId] or { kind = "rock" }
	local model: Model

	local base: Color3 = look.Color or rarity.Color
	local second: Color3 = style.second or lighten(base, 0.4)
	if look.Rainbow then
		base = C(255, 120, 200)
	end
	local material = Enum.Material.Plastic
	if mutationId == "Golden" then
		base = C(255, 200, 50); second = C(255, 235, 140)
	elseif mutationId == "Frozen" then
		base = base:Lerp(C(170, 230, 255), 0.7); second = C(235, 250, 255)
	end

	if custom and custom:IsA("Model") then
		model = custom:Clone()
		model:ScaleTo(d / math.max(model:GetExtentsSize().X, 0.01))
	else
		model = Instance.new("Model")
		local rng = Random.new(#planetId * 97 + string.byte(planetId, 1))
		local n = 7
		local u = d / n
		local kind = style.kind

		-- couleur de chaque couche selon le style
		local function layerColor(i: number, count: number): Color3
			if kind == "gas" or kind == "candy" or kind == "hive" then
				-- bandes : une couche sur deux plus claire
				return i % 2 == 0 and second or base
			elseif kind == "star" or kind == "lava" then
				local mid = math.abs(i - (count + 1) / 2) / count
				return base:Lerp(second, 0.6 - mid)
			elseif kind == "egg" then
				return Color3.fromHSV((i / count) * 0.8, 0.45, 1)
			end
			-- roches : légère variation de teinte d'une couche à l'autre
			return i % 2 == 0 and darken(base, 0.08) or base
		end

		local mat = material
		if kind == "star" then mat = Enum.Material.Neon end
		if mutationId == "Frozen" then mat = Enum.Material.Plastic end
		local layers = brickSphere(model, d, n, layerColor, mat, "Ball")
		local core = block(model, "Core", Vector3.one * d * 0.5, CFrame.new(), base, Enum.Material.Plastic, 1)
		model.PrimaryPart = core

		-- calottes polaires (bloc plat au sommet / en bas)
		local function cap(layer: Layer, color: Color3, mat2: Enum.Material?)
			local w = layer.half * 1.25
			local y = layer.y + u * 0.5 * math.sign(layer.y)
			local nw = w * 0.62
			local side = (w - nw) / 2
			block(model, "Spot", Vector3.new(w, u * 0.35, nw), CFrame.new(0, y, 0), color, mat2)
			block(model, "Spot", Vector3.new(nw, u * 0.35, side), CFrame.new(0, y, nw / 2 + side / 2), color, mat2)
			block(model, "Spot", Vector3.new(nw, u * 0.35, side), CFrame.new(0, y, -nw / 2 - side / 2), color, mat2)
		end

		-- taches posées sur la surface (cratères, continents, nuages...)
		local function patch(count: number, color: Color3, w: number, h: number, mat2: Enum.Material?, nameIt: string?, sink: number?)
			for _ = 1, count do
				local layer = layers[rng:NextInteger(2, n - 1)]
				local a = rng:NextNumber() * math.pi * 2
				-- on évite la face avant (le visage)
				if math.abs(((a + math.pi) % (math.pi * 2)) - math.pi) < 0.7 then a += math.pi end
				local pos, dist = surfacePoint(layer, a)
				local out = Vector3.new(math.sin(a), 0, math.cos(a))
				local cf = CFrame.lookAt(pos + out * (u * (0.12 - (sink or 0))), pos + out * 2) * CFrame.new(0, (rng:NextNumber() - 0.5) * u * 0.6, 0)
				block(model, nameIt or "Spot", Vector3.new(w * u * rng:NextNumber(0.8, 1.3), h * u, u * 0.4), cf, color, mat2)
				local _ = dist
			end
		end

		if kind == "rock" or kind == "desert" then
			patch(5, darken(base, 0.3), 1.1, 0.9, nil, "Spot")
			patch(3, lighten(second, 0.1), 0.8, 0.5, nil, "Spot")
		elseif kind == "earth" or kind == "jungle" then
			patch(kind == "jungle" and 7 or 5, second, 1.6, 1.0, nil, "Land")
			patch(3, Color3.new(1, 1, 1), 1.4, 0.45, nil, "Cloud")
			cap(layers[n], Color3.new(1, 1, 1))
			cap(layers[1], Color3.new(1, 1, 1))
		elseif kind == "cloudy" then
			patch(7, second, 1.8, 0.6, nil, "Cloud")
		elseif kind == "ice" then
			cap(layers[n], second)
			cap(layers[1], second)
			patch(4, lighten(base, 0.5), 0.9, 0.9, Enum.Material.Ice, "Spot")
		elseif kind == "lava" then
			patch(7, second, 1.2, 0.3, Enum.Material.Neon, "Lava")
			patch(3, darken(base, 0.5), 1.0, 0.9, nil, "Spot")
		elseif kind == "void" then
			patch(6, second, 0.6, 0.6, Enum.Material.Neon, "Spot")
		elseif kind == "hive" then
			patch(6, second, 0.9, 0.9, nil, "Spot")
		elseif kind == "candy" then
			patch(6, Color3.new(1, 1, 1), 0.5, 0.5, nil, "Spot")
		elseif kind == "gas" then
			-- grosse tempête
			patch(1, darken(second, 0.2), 1.8, 1.0, nil, "Spot")
		end

		-- pointes de cristal
		if kind == "crystal" or look.Crystals then
			for i = 1, 6 do
				local layer = layers[(i % 2 == 0) and n or rng:NextInteger(2, n - 1)]
				local a = rng:NextNumber() * math.pi * 2
				local pos = surfacePoint(layer, a)
				local out = (pos.Unit + Vector3.new(0, 0.6, 0)).Unit
				local len = u * rng:NextNumber(1.4, 2.4)
				block(model, "Crystal", Vector3.new(u * 0.55, len, u * 0.55),
					CFrame.lookAt(pos + out * len * 0.35, pos + out * 3) * CFrame.Angles(math.rad(90), 0, math.rad(45)),
					lighten(second, 0.2), Enum.Material.Neon, 0.1)
			end
		end

		-- œil géant (Crimson Eye) : remplace le visage
		local face = true
		if kind == "eye" then
			face = false
			local z = layers[4].half
			block(model, "Spot", Vector3.new(u * 3.2, u * 2.2, u * 0.3), CFrame.new(0, 0, z + u * 0.1), second)
			block(model, "Spot", Vector3.new(u * 1.4, u * 1.4, u * 0.3), CFrame.new(0, 0, z + u * 0.25), C(255, 200, 0), Enum.Material.Neon)
			block(model, "Eye", Vector3.new(u * 0.7, u * 0.9, u * 0.3), CFrame.new(0, 0, z + u * 0.4), INK)
		end

		-- étoile : rayons en blocs
		if kind == "star" then
			for i = 1, 8 do
				local a = i / 8 * math.pi * 2
				block(model, "Ring", Vector3.new(u * 0.6, u * 0.6, u * 2.2),
					CFrame.Angles(0, a, 0) * CFrame.new(0, 0, d * 0.62) * CFrame.Angles(math.rad(45), 0, 0),
					second, Enum.Material.Neon)
			end
		end

		-- œuf cosmique : coquille craquée en zigzag
		if kind == "egg" then
			for i = 1, 10 do
				local a = i / 10 * math.pi * 2
				local layer = layers[(i % 2 == 0) and 5 or 4]
				local pos = surfacePoint(layer, a)
				block(model, "Spot", Vector3.new(u * 0.9, u * 0.3, u * 0.3), CFrame.lookAt(pos * 1.04, pos * 2), Color3.new(1, 1, 1), Enum.Material.Neon)
			end
		end

		-- glitch : cubes décalés magenta / cyan
		if kind == "glitch" or look.Glitch then
			for i = 1, 9 do
				local v = rng:NextUnitVector() * d * rng:NextNumber(0.35, 0.65)
				block(model, "Glitch", Vector3.new(u * rng:NextNumber(0.6, 1.8), u * rng:NextNumber(0.3, 0.8), u * 0.5), CFrame.new(v),
					i % 2 == 0 and C(255, 0, 200) or C(0, 255, 230), Enum.Material.Neon)
			end
			model:SetAttribute("Glitch", true)
		end

		-- anneau en briques (studs dessus), 2 couleurs alternées
		if look.Ring then
			local tilt = CFrame.Angles(math.rad(18), 0, math.rad(10))
			local segs = 18
			local r = d * 0.86
			local segLen = 2 * math.pi * r / segs * 1.02
			for i = 1, segs do
				local a = (i / segs) * math.pi * 2
				block(model, "Ring", Vector3.new(segLen, u * 0.35, u * 1.3),
					tilt * CFrame.new(math.cos(a) * r, 0, math.sin(a) * r) * CFrame.Angles(0, -a + math.pi / 2, 0),
					i % 2 == 0 and lighten(base, 0.45) or second)
			end
		end

		-- petite lune en briques
		if style.moon then
			local m = Instance.new("Model")
			m.Name = "Moon"
			brickSphere(m, d * 0.28, 3, function(i) return i % 2 == 0 and C(200, 200, 215) or C(170, 170, 185) end, nil, "Spot")
			m:PivotTo(CFrame.new(d * 0.75, d * 0.42, -d * 0.2))
			m.Parent = model
		end

		-- halo lumineux pour les raretés hautes
		if look.Glow or rarity.Order >= 4 then
			local hw = d * 1.15
			block(model, "Glow", Vector3.new(hw, hw * 0.92, hw * 0.62), CFrame.new(), lighten(base, 0.3), Enum.Material.Neon, 0.85)
			block(model, "Glow", Vector3.new(hw * 0.62, hw * 0.92, hw), CFrame.new(), lighten(base, 0.3), Enum.Material.Neon, 0.85)
		end

		if look.Tail then
			sparkles(core, base, 10, d * 0.2)
		end

		-- visage mignon en blocs : yeux, reflets, joues, bouche
		if face then
			local zMid = layers[4].half
			for _, side in ipairs({ -1, 1 }) do
				block(model, "Eye", Vector3.new(u * 0.75, u * 1.15, u * 0.3), CFrame.new(side * u * 1.05, u * 0.3, zMid + u * 0.08), INK)
				block(model, "Glint", Vector3.new(u * 0.3, u * 0.3, u * 0.12), CFrame.new(side * u * 1.05 + u * 0.15, u * 0.6, zMid + u * 0.26), Color3.new(1, 1, 1), Enum.Material.Neon)
				block(model, "Cheek", Vector3.new(u * 0.65, u * 0.35, u * 0.2), CFrame.new(side * u * 1.9, -u * 0.35, zMid - u * 0.02), C(255, 120, 160))
			end
			block(model, "Mouth", Vector3.new(u * 0.7, u * 0.22, u * 0.2), CFrame.new(0, -u * 0.5, zMid + u * 0.06), INK)
			block(model, "Mouth", Vector3.new(u * 0.22, u * 0.22, u * 0.2), CFrame.new(-u * 0.45, -u * 0.38, zMid + u * 0.06), INK)
			block(model, "Mouth", Vector3.new(u * 0.22, u * 0.22, u * 0.2), CFrame.new(u * 0.45, -u * 0.38, zMid + u * 0.06), INK)
		end

		-- mutations : glaçons (Frozen), braises (Fire)
		if mutationId == "Frozen" then
			for i = 1, 6 do
				local a = i / 6 * math.pi * 2
				block(model, "Spot", Vector3.new(u * 0.4, u * 1.2, u * 0.4), CFrame.new(math.sin(a) * d * 0.3, -d * 0.48, math.cos(a) * d * 0.3), C(220, 245, 255), Enum.Material.Ice, 0.2)
			end
		elseif mutationId == "Fire" then
			patch(5, C(255, 140, 20), 0.9, 0.4, Enum.Material.Neon, "Lava")
		elseif mutationId == "Golden" then
			patch(4, C(255, 250, 200), 0.5, 0.5, Enum.Material.Neon, "Spot")
		end

		if look.Rainbow then model:SetAttribute("Rainbow", true) end
	end

	model.Name = planetId
	local root = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")

	-- effets de mutation
	if root then
		if mutationId == "Golden" then
			sparkles(root, C(255, 220, 80), 8, d * 0.15)
		elseif mutationId == "Frozen" then
			sparkles(root, C(200, 240, 255), 8, d * 0.15)
		elseif mutationId == "Fire" then
			local fire = Instance.new("Fire")
			fire.Size = d * 1.4
			fire.Heat = 4
			fire.Color = C(255, 120, 20)
			fire.SecondaryColor = C(255, 220, 60)
			fire.Parent = root
		elseif mutationId == "Rainbow" then
			model:SetAttribute("Rainbow", true)
			sparkles(root, Color3.new(1, 1, 1), 12, d * 0.15)
		end
		if rarity.Order >= 3 then
			local light = Instance.new("PointLight")
			light.Color = base
			light.Range = d * 3
			light.Brightness = 1.2
			light.Parent = root
		end
	end

	model:SetAttribute("PlanetId", planetId)
	model:SetAttribute("Mutation", mutationId or "")
	model:SetAttribute("Spin", 0.5)
	CollectionService:AddTag(model, "Spin")
	return model
end

-- couleur d'une mutation (pour les textes)
function Models.MutationColor(mutationId: string?): Color3?
	local m = mutationId and Mutations.ById[mutationId]
	return m and m.Color or nil
end

-- outils réutilisés par le MapBuilder (même style de briques partout)
Models.Block = block
Models.BrickSphere = brickSphere

return Models
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="Folder" referent="RBX35"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX23"><Properties><string name="Name">Lib</string></Properties><Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--!strict
-- ServerScriptService/Lib/Net
-- Crée les Remotes et protège TOUTES les demandes du client :
--   * une seule RemoteEvent "Request" (client -> serveur) : Net.On("Equip", handler, {limit})
--   * une RemoteFunction "Invoke" pour les demandes qui attendent une réponse (codes)
--   * "Sync" (serveur -> client) : envoie les données du joueur
--   * "Notify" (serveur -> client) : petits messages à l'écran
--   * "Event" (serveur -> client) : événements (éclosion, achat...)
-- Chaque action a une limite de fréquence par joueur. Les arguments sont vérifiés
-- par le handler lui-même (types attendus), jamais trusted.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local function make(class: string, name: string): any
	local r = Instance.new(class)
	r.Name = name
	r.Parent = folder
	return r
end

local request = make("RemoteEvent", "Request") :: RemoteEvent
local invoke = make("RemoteFunction", "Invoke") :: RemoteFunction
Net.Sync = make("RemoteEvent", "Sync") :: RemoteEvent
Net.NotifyRemote = make("RemoteEvent", "Notify") :: RemoteEvent
Net.EventRemote = make("RemoteEvent", "Event") :: RemoteEvent
folder.Parent = ReplicatedStorage

type Handler = (player: Player, ...any) -> ...any
type Entry = { fn: Handler, perSecond: number, burst: number }
local handlers: { [string]: Entry } = {}
local functions: { [string]: Entry } = {}

-- seau de jetons par joueur et par action : "burst" demandes d'un coup, puis "perSecond"/s
local buckets: { [Player]: { [string]: { tokens: number, t: number } } } = {}
local function allow(player: Player, action: string, e: Entry): boolean
	local pb = buckets[player]
	if not pb then pb = {}; buckets[player] = pb end
	local now = os.clock()
	local b = pb[action]
	if not b then b = { tokens = e.burst, t = now }; pb[action] = b end
	b.tokens = math.min(e.burst, b.tokens + (now - b.t) * e.perSecond)
	b.t = now
	if b.tokens < 1 then return false end
	b.tokens -= 1
	return true
end
Players.PlayerRemoving:Connect(function(p) buckets[p] = nil end)

-- enregistre une action "client -> serveur" sans réponse
function Net.On(action: string, fn: Handler, perSecond: number?, burst: number?)
	handlers[action] = { fn = fn, perSecond = perSecond or 4, burst = burst or 6 }
end

-- enregistre une action qui renvoie une réponse au client
function Net.OnInvoke(action: string, fn: Handler, perSecond: number?, burst: number?)
	functions[action] = { fn = fn, perSecond = perSecond or 2, burst = burst or 3 }
end

request.OnServerEvent:Connect(function(player: Player, action: any, ...)
	if type(action) ~= "string" then return end
	local e = handlers[action]
	if not e or not allow(player, action, e) then return end
	local ok, err = pcall(e.fn, player, ...)
	if not ok then warn("[Net] " .. action .. " : " .. tostring(err)) end
end)

invoke.OnServerInvoke = function(player: Player, action: any, ...)
	if type(action) ~= "string" then return nil end
	local e = functions[action]
	if not e then return nil end
	if not allow(player, action, e) then return { ok = false, msg = "Slow down!" } end
	local ok, res = pcall(e.fn, player, ...)
	if not ok then
		warn("[Net] " .. action .. " : " .. tostring(res))
		return { ok = false, msg = "Error" }
	end
	return res
end

-- serveur -> client
function Net.Notify(player: Player, text: string, kind: string?)
	Net.NotifyRemote:FireClient(player, text, kind or "info")
end

function Net.Fire(player: Player, name: string, payload: any)
	Net.EventRemote:FireClient(player, name, payload)
end

-- petites vérifications d'arguments
function Net.IsString(v: any, maxLen: number?): boolean
	return type(v) == "string" and #v > 0 and #v <= (maxLen or 64)
end

function Net.IsInt(v: any, min: number, max: number): boolean
	return type(v) == "number" and v == v and math.floor(v) == v and v >= min and v <= max
end

return Net
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">Rewards</string><ProtectedString name="Source"><![CDATA[--!strict
-- ServerScriptService/Lib/Rewards
-- Donne une récompense décrite dans la Config (daily, codes, packs) :
--   { Type = "Money", Amount = 1000 } ou { Type = "Money", Minutes = 10, Min = 1000 }
--   { Type = "Galaxy", Galaxy = "GoldenCrown" }
--   { Type = "Boost", Boost = "Luck", Duration = 900 }
-- Renvoie un petit texte pour l'affichage.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Util.Format)
local Galaxies = require(Shared.Config.Galaxies)

local Services = script.Parent.Parent.Services
local DataService = require(Services.DataService)
local IncomeService = require(Services.IncomeService)
local IncubatorService = require(Services.IncubatorService)

local Rewards = {}

function Rewards.AddBoost(player: Player, boost: string, duration: number)
	local data = DataService.Get(player)
	if not data then return end
	local now = os.time()
	data.Boosts[boost] = math.max(data.Boosts[boost] or 0, now) + duration
	DataService.Push(player, "Boosts")
end

function Rewards.Give(player: Player, reward: any): string
	if reward.Type == "Money" then
		local amount = reward.Amount
		if not amount then
			amount = math.max(reward.Min or 0, math.floor(IncomeService.PerSecond(player) * (reward.Minutes or 1) * 60))
		end
		IncomeService.Give(player, amount)
		return Format.Money(amount)
	elseif reward.Type == "Galaxy" then
		IncubatorService.Give(player, reward.Galaxy)
		local g = Galaxies.ById[reward.Galaxy]
		return (g and g.Name or reward.Galaxy) .. " Galaxy"
	elseif reward.Type == "Boost" then
		Rewards.AddBoost(player, reward.Boost, reward.Duration)
		return "x2 " .. reward.Boost .. " (" .. Format.Time(reward.Duration) .. ")"
	end
	return ""
end

return Rewards
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[--!strict
-- ServerScriptService/Lib/State
-- Construit l'état "calculable" d'un joueur pour Formulas, à partir de sa sauvegarde
-- et de ses gamepasses (attributs Pass_<Nom> posés par ShopService).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Gamepasses = require(ReplicatedStorage.Shared.Config.Gamepasses)

local State = {}

function State.Build(player: Player, data: any)
	local passes = {}
	for name in pairs(Gamepasses) do
		passes[name] = player:GetAttribute("Pass_" .. name) == true
	end
	return {
		Rebirths = data.Rebirths,
		Upgrades = data.Upgrades,
		Passes = passes,
		Boosts = data.Boosts,
		IndexClaimed = data.IndexClaimed,
		Now = os.time(),
	}
end

return State
]]></ProtectedString></Properties></Item></Item><Item class="Script" referent="RBX24"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!strict
-- ServerScriptService/Main
-- Démarre tous les services du jeu dans le bon ordre.

local Services = script.Parent:WaitForChild("Services")

local order = {
	"DataService",
	"PlotService",
	"IndexService",
	"PlanetService",
	"IncubatorService",
	"SpawnerService",
	"IncomeService",
	"ProgressService",
	"ShopService",
}

for _, name in ipairs(order) do
	local ok, err = pcall(function()
		local service = require(Services:WaitForChild(name)) :: any
		if service.Start then service.Start() end
	end)
	if not ok then
		warn("[Main] " .. name .. " n'a pas démarré : " .. tostring(err))
	end
end

print("[Grow a Planet] serveur prêt")
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX34"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[--!strict
-- ServerScriptService/Services/DataService
-- Sauvegarde des joueurs, fiable :
--   * verrou de session : une même sauvegarde ne peut pas être ouverte par 2 serveurs
--     (sinon duplication / perte). Le verrou est rafraîchi à chaque autosave.
--   * retry avec attente progressive si DataStore échoue
--   * autosave toutes les 60 s + sauvegarde à la sortie + BindToClose (arrêt serveur)
--   * Version du format : les nouvelles clés sont ajoutées automatiquement aux vieilles sauvegardes
-- Le reste du jeu utilise : DataService.Get(player) -> data (table), DataService.Push(player, key)

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Net = require(script.Parent.Parent.Lib.Net)

local DataService = {}

local STORE_NAME = "GrowAPlanet_Players_v1"
local VERSION = 1
local AUTOSAVE = 60
local LOCK_STALE = 180 -- un verrou plus vieux que ça = serveur mort, on peut le reprendre
local MAX_RECEIPTS = 100

-- données de départ d'un nouveau joueur
local function template()
	return {
		Version = VERSION,
		Money = 0,
		TotalEarned = 0,
		Rebirths = 0,
		Upgrades = { Luck = 0, Spawners = 0, HatchSpeed = 0 },
		Incubator = {},      -- liste { Uid, Galaxy, EndsAt }
		Planets = {},        -- [uid] = { Id, Mut, Eq, Lock }
		NextUid = 1,
		Index = {},          -- ["PlanetId"] = true, ["PlanetId:Golden"] = true
		IndexClaimed = {},   -- [rareté] = true
		Boosts = {},         -- [nom] = os.time() de fin
		Daily = { Day = 0, Last = 0 },
		Codes = {},
		Receipts = {},       -- derniers PurchaseId traités (anti double achat)
		StarterPack = false,
		Settings = { Music = true, Sfx = true, LowGfx = false },
		Stats = { Hatched = 0, Playtime = 0, Joins = 0 },
		Tutorial = 0,
		LastOnline = 0,
		GivenGalaxies = {},  -- galaxies offertes (daily, codes, Robux) en attente de place dans l'enclos
	}
end

-- ajoute les clés manquantes (nouvelles versions du jeu) sans toucher aux existantes
local function reconcile(data: any, tpl: any)
	for k, v in pairs(tpl) do
		if data[k] == nil then
			data[k] = if type(v) == "table" then table.clone(v) else v
		elseif type(v) == "table" and type(data[k]) == "table" and next(v) ~= nil then
			reconcile(data[k], v)
		end
	end
end

local store: DataStore? = nil
local ok = pcall(function()
	store = DataStoreService:GetDataStore(STORE_NAME)
end)
if not ok then warn("[DataService] DataStore indisponible : les données ne seront PAS sauvegardées (active l'accès API dans Studio).") end

type Profile = { Data: any, Player: Player, Loaded: boolean, Released: boolean, Saving: boolean }
local profiles: { [Player]: Profile } = {}
local releasing: { [number]: boolean } = {} -- sauvegarde de sortie en cours (par UserId)

-- dans Studio sans accès API, DataStore refuse tout : on joue sans sauvegarde
local function studioNoAccess(err: any): boolean
	local msg = tostring(err)
	return RunService:IsStudio() and (msg:find("403") ~= nil or msg:find("StudioAccessToApisNotAllowed") ~= nil or msg:find("not allowed") ~= nil)
end
local loadedCallbacks: { (Player, any) -> () } = {}
local releaseCallbacks: { (Player, any) -> () } = {}

local function key(userId: number): string
	return "P_" .. userId
end

-- appel DataStore avec retry (attente 1, 2, 4, 8 s)
local function retry<T>(fn: () -> T, tries: number?): (boolean, T?)
	local wait = 1
	for i = 1, tries or 5 do
		local okCall, res = pcall(fn)
		if okCall then return true, res end
		if studioNoAccess(res) then
			warn("[DataService] Studio sans accès API : partie SANS sauvegarde (Game Settings > Security > Enable Studio Access to API Services)")
			store = nil
			return false, nil
		end
		warn("[DataService] essai " .. i .. " raté : " .. tostring(res))
		task.wait(wait)
		wait *= 2
	end
	return false, nil
end

local function load(player: Player): any?
	if not store then
		return template()
	end
	local jobId = game.JobId ~= "" and game.JobId or "studio"
	for attempt = 1, 8 do
		local lockedByOther = false
		local okLoad, result = retry(function()
			return (store :: DataStore):UpdateAsync(key(player.UserId), function(old)
				lockedByOther = false
				old = old or { Data = nil, Lock = nil }
				local lock = old.Lock
				if lock and lock.Job ~= jobId and os.time() - (lock.Time or 0) < LOCK_STALE then
					lockedByOther = true
					return nil -- ne rien écrire
				end
				old.Lock = { Job = jobId, Time = os.time() }
				return old
			end)
		end)
		if not okLoad then
			if not store then return template() end -- Studio sans API
			return nil
		end
		if not lockedByOther and result then
			local data = result.Data or template()
			reconcile(data, template())
			data.Version = VERSION
			return data
		end
		-- l'autre serveur est en train de sauvegarder : on attend un peu
		task.wait(4)
		if not player.Parent then return nil end
	end
	return nil
end

local function save(profile: Profile, release: boolean): boolean
	if not store then return true end
	-- une seule sauvegarde à la fois : on attend celle en cours
	local waited = 0
	while profile.Saving and waited < 30 do
		task.wait(0.1)
		waited += 0.1
	end
	profile.Saving = true
	local jobId = game.JobId ~= "" and game.JobId or "studio"
	local data = profile.Data
	data.LastOnline = os.time()
	local stolen = false
	local okSave = retry(function()
		return (store :: DataStore):UpdateAsync(key(profile.Player.UserId), function(old)
			stolen = false
			old = old or {}
			if old.Lock and old.Lock.Job ~= jobId then
				stolen = true
				return nil -- un autre serveur a pris la main : on n'écrase pas
			end
			old.Data = data
			old.Lock = if release then nil else { Job = jobId, Time = os.time() }
			return old
		end)
	end)
	profile.Saving = false
	if stolen then warn("[DataService] verrou perdu pour " .. profile.Player.Name) end
	return okSave and not stolen
end

local function onPlayerAdded(player: Player)
	-- s'il vient de quitter CE serveur, on attend la fin de sa sauvegarde de sortie
	local t = 0
	while releasing[player.UserId] and t < 30 do
		task.wait(0.2)
		t += 0.2
	end
	local data = load(player)
	if not player.Parent then
		-- parti pendant le chargement : on libère le verrou tout de suite
		if data and store then
			save({ Data = data, Player = player, Loaded = true, Released = true, Saving = false }, true)
		end
		return
	end
	if not data then
		player:Kick("Your data could not be loaded. Please rejoin in a moment!")
		return
	end
	data.Stats.Joins += 1
	local profile: Profile = { Data = data, Player = player, Loaded = true, Released = false, Saving = false }
	profiles[player] = profile
	for _, cb in ipairs(loadedCallbacks) do
		task.spawn(cb, player, data)
	end
	player:SetAttribute("DataLoaded", true)
end

local function release(player: Player)
	local profile = profiles[player]
	if not profile or profile.Released then return end
	profile.Released = true
	releasing[player.UserId] = true
	for _, cb in ipairs(releaseCallbacks) do
		pcall(cb, player, profile.Data)
	end
	save(profile, true) -- attend une éventuelle autosave en cours avant d'écrire
	profiles[player] = nil
	releasing[player.UserId] = nil
end

-- [ API ] --------------------------------------------------------------------

function DataService.Get(player: Player): any?
	local p = profiles[player]
	return p and not p.Released and p.Data or nil
end

-- envoie une clé (ou tout) au client
function DataService.Push(player: Player, k: string?)
	local data = DataService.Get(player)
	if not data then return end
	if k then
		Net.Sync:FireClient(player, k, data[k])
	else
		Net.Sync:FireClient(player, "*", data)
	end
end

function DataService.OnLoaded(cb: (Player, any) -> ())
	table.insert(loadedCallbacks, cb)
	for player, p in pairs(profiles) do
		task.spawn(cb, player, p.Data)
	end
end

function DataService.OnRelease(cb: (Player, any) -> ())
	table.insert(releaseCallbacks, cb)
end

-- sauvegarde immédiate (après un achat Robux)
function DataService.SaveNow(player: Player): boolean
	local p = profiles[player]
	if not p then return false end
	return save(p, false)
end

-- reçu déjà traité ? (achats Robux idempotents)
function DataService.HasReceipt(data: any, purchaseId: string): boolean
	return table.find(data.Receipts, purchaseId) ~= nil
end

function DataService.AddReceipt(data: any, purchaseId: string)
	table.insert(data.Receipts, purchaseId)
	while #data.Receipts > MAX_RECEIPTS do
		table.remove(data.Receipts, 1)
	end
end

function DataService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, p)
	end
	Players.PlayerRemoving:Connect(release)

	-- autosave
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE)
			for _, profile in pairs(profiles) do
				if not profile.Released then
					task.spawn(save, profile, false)
				end
			end
		end
	end)

	-- arrêt du serveur : on sauvegarde tout le monde en parallèle
	game:BindToClose(function()
		if RunService:IsStudio() and not store then return end
		for player in pairs(profiles) do
			task.spawn(release, player)
		end
		-- attend que TOUTES les sauvegardes soient finies (y compris celles lancées par PlayerRemoving)
		local t = os.clock()
		while (next(profiles) ~= nil or next(releasing) ~= nil) and os.clock() - t < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">IncomeService</string><ProtectedString name="Source"><![CDATA[--!strict
-- ServerScriptService/Services/IncomeService
-- Toutes les secondes : argent += gains des planètes équipées x multiplicateurs.
-- À l'arrivée : gains hors ligne (50 % pendant 8 h max, réglable dans Config/Upgrades).
-- Affiche aussi l'argent dans le classement (leaderstats).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Formulas = require(Shared.Util.Formulas)
local Format = require(Shared.Util.Format)
local Upgrades = require(Shared.Config.Upgrades)

local Net = require(script.Parent.Parent.Lib.Net)
local State = require(script.Parent.Parent.Lib.State)
local DataService = require(script.Parent.DataService)
local PlanetService = require(script.Parent.PlanetService)

local IncomeService = {}

-- argent/s actuel du joueur, tous bonus compris
function IncomeService.PerSecond(player: Player): number
	local data = DataService.Get(player)
	if not data then return 0 end
	return PlanetService.BaseIncome(data) * Formulas.MoneyMultiplier(State.Build(player, data))
end

function IncomeService.Give(player: Player, amount: number)
	local data = DataService.Get(player)
	if not data or amount <= 0 then return end
	data.Money += amount
	data.TotalEarned += amount
	DataService.Push(player, "Money")
end

local function setupLeaderstats(player: Player, data: any)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local money = Instance.new("StringValue")
	money.Name = "Money"
	money.Value = Format.Money(data.Money)
	money.Parent = ls
	local reb = Instance.new("IntValue")
	reb.Name = "Rebirths"
	reb.Value = data.Rebirths
	reb.Parent = ls
	ls.Parent = player
end

function IncomeService.Start()
	DataService.OnLoaded(function(player, data)
		setupLeaderstats(player, data)
		-- gains hors ligne
		if data.LastOnline > 0 then
			local away = math.min(os.time() - data.LastOnline, Upgrades.Base.OfflineMaxHours * 3600)
			if away > 60 then
				local rate = IncomeService.PerSecond(player)
				local gain = math.floor(rate * away * Upgrades.Base.OfflineRate)
				if gain > 0 then
					IncomeService.Give(player, gain)
					Net.Fire(player, "Offline", { Amount = gain, Seconds = away })
				end
			end
		end
		DataService.Push(player) -- envoie toutes les données au client
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				local data = DataService.Get(player)
				if data then
					local rate = IncomeService.PerSecond(player)
					player:SetAttribute("Income", rate)
					data.Stats.Playtime += 1
					if rate > 0 then
						data.Money += rate
						data.TotalEarned += rate
						DataService.Push(player, "Money")
					end
					local ls = player:FindFirstChild("leaderstats")
					if ls then
						(ls :: any).Money.Value = Format.Money(data.Money);
						(ls :: any).Rebirths.Value = data.Rebirths
					end
				end
			end
		end
	end)
end

return IncomeService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">IncubatorService</string><ProtectedString name="Source"><![CDATA[--!strict
-- ServerScriptService/Services/IncubatorService
-- L'enclos : les galaxies achetées y attendent leur timer, puis on les fait éclore.
--   * le timer = heure de fin (os.time) sauvegardée → continue même hors ligne
--   * éclosion : tirage de la planète + mutation par le SERVEUR
--   * galaxies offertes (daily, codes, Robux) : si l'enclos est plein, elles attendent dans une file

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Formulas = require(Shared.Util.Formulas)
local Galaxies = require(Shared.Config.Galaxies)
local Planets = require(Shared.Config.Planets)
local Rarities = require(Shared.Config.Rarities)
local Upgrades = require(Shared.Config.Upgrades)
local Models = require(Shared.Visuals.Models)
local Format = require(Shared.Util.Format)

local Net = require(script.Parent.Parent.Lib.Net)
local State = require(script.Parent.Parent.Lib.State)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local PlanetService = require(script.Parent.PlanetService)

local IncubatorService = {}
local rng = Random.new()

local function slotPart(plot: Model, index: number): BasePart?
	local slots = plot:FindFirstChild("Slots")
	local s = slots and slots:FindFirstChild("Slot" .. index)
	return if s and s:IsA("BasePart") then s else nil
end

-- redessine toutes les galaxies de l'enclos du joueur
function IncubatorService.Render(player: Player)
	local data = DataService.Get(player)
	local plot = PlotService.Get(player)
	if not data or not plot then return end
	local dyn = plot:FindFirstChild("Dynamic") :: Folder
	local folder = dyn:FindFirstChild("Incubator")
	if folder then folder:Destroy() end
	folder = Instance.new("Folder")
	folder.Name = "Incubator"
	folder.Parent = dyn

	for i, entry in ipairs(data.Incubator) do
		local slot = slotPart(plot, i)
		if slot then
			local g = Galaxies.ById[entry.Galaxy]
			local model = Models.Galaxy(entry.Galaxy, 0.55)
			model:PivotTo(CFrame.new(slot.Position + Vector3.new(0, slot.Size.X / 2 + 3, 0)))
			model:SetAttribute("Uid", entry.Uid)
			model:SetAttribute("EndsAt", entry.EndsAt)
			model:SetAttribute("OwnerId", player.UserId)

			-- étiquette au-dessus (le client met à jour le compte à rebours)
			local bb = Instance.new("BillboardGui")
			bb.Name = "Timer"
			bb.Size = UDim2.fromScale(6, 2)
			bb.StudsOffsetWorldSpace = Vector3.new(0, 3.6, 0)
			bb.AlwaysOnTop = false
			bb.MaxDistance = 80
			bb.LightInfluence = 0
			local name = Instance.new("TextLabel")
			name.Name = "GalaxyName"
			name.BackgroundTransparency = 1
			name.Size = UDim2.fromScale(1, 0.45)
			name.Font = Enum.Font.GothamBlack
			name.TextScaled = true
			name.Text = g and g.Name or entry.Galaxy
			name.TextColor3 = Rarities.Info[g and g.Rarity or "Common"].Color
			name.TextStrokeTransparency = 0
			name.Parent = bb
			local timer = Instance.new("TextLabel")
			timer.Name = "Time"
			timer.BackgroundTransparency = 1
			timer.Position = UDim2.fromScale(0, 0.48)
			timer.Size = UDim2.fromScale(1, 0.52)
			timer.Font = Enum.Font.GothamBlack
			timer.TextScaled = true
			timer.TextColor3 = Color3.new(1, 1, 1)
			timer.TextStrokeTransparency = 0
			timer.Text = Format.Time(entry.EndsAt - os.time())
			timer.Parent = bb
			bb.Parent = model.PrimaryPart

			-- bouton "Hatch" dans le monde (actif quand c'est prêt, le client gère l'affichage)
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "HatchPrompt"
			prompt.ActionText = "Hatch"
			prompt.ObjectText = g and g.Name or ""
			prompt.HoldDuration = 0.3
			prompt.MaxActivationDistance = 12
			prompt.RequiresLineOfSight = false
			prompt.Parent = model.PrimaryPart
			local uid = entry.Uid
			prompt.Triggered:Connect(function(who)
				if who == player then IncubatorService.Hatch(player, uid) end
			end)

			model.Parent = folder
		end
	end
end

function IncubatorService.FreeSlots(player: Player): number
	local data = DataService.Get(player)
	if not data then return 0 end
	return Upgrades.Base.IncubatorSlots - #data.Incubator
end

-- ajoute une galaxie dans l'enclos (déjà payée). Renvoie false si plein.
function IncubatorService.Add(player: Player, galaxyId: string): boolean
	local data = DataService.Get(player)
	if not data or not Galaxies.ById[galaxyId] then return false end
	if #data.Incubator >= Upgrades.Base.IncubatorSlots then return false end
	local state = State.Build(player, data)
	local uid = tostring(data.NextUid)
	data.NextUid += 1
	table.insert(data.Incubator, {
		Uid = uid,
		Galaxy = galaxyId,
		EndsAt = os.time() + Formulas.HatchDuration(galaxyId, state),
	})
	DataService.Push(player, "Incubator")
	IncubatorService.Render(player)
	return true
end

-- donne une galaxie gratuite : dans l'enclos si possible, sinon en file d'attente
function IncubatorService.Give(player: Player, galaxyId: string)
	local data = DataService.Get(player)
	if not data then return end
	if not IncubatorService.Add(player, galaxyId) then
		table.insert(data.GivenGalaxies, galaxyId)
		DataService.Push(player, "GivenGalaxies")
		Net.Notify(player, "Incubator full! Your galaxy is waiting for a free slot.", "warn")
	end
end

-- vide la file d'attente dès qu'il y a de la place
local function flushQueue(player: Player)
	local data = DataService.Get(player)
	if not data then return end
	local changed = false
	while #data.GivenGalaxies > 0 and #data.Incubator < Upgrades.Base.IncubatorSlots do
		local id = table.remove(data.GivenGalaxies, 1)
		if id and IncubatorService.Add(player, id) then changed = true end
	end
	if changed then DataService.Push(player, "GivenGalaxies") end
end

local function findIndex(data: any, uid: string): number?
	for i, e in ipairs(data.Incubator) do
		if e.Uid == uid then return i end
	end
	return nil
end

-- fait éclore une galaxie prête. Renvoie la planète obtenue.
function IncubatorService.Hatch(player: Player, uid: string, silent: boolean?): boolean
	local data = DataService.Get(player)
	if not data then return false end
	local i = findIndex(data, uid)
	if not i then return false end
	local entry = data.Incubator[i]
	if os.time() < entry.EndsAt then
		if not silent then Net.Notify(player, "Not ready yet!", "warn") end
		return false
	end
	if PlanetService.Count(data) >= Upgrades.Base.InventoryMax then
		if not silent then Net.Notify(player, "Planet inventory full! Sell some planets first.", "error") end
		return false
	end

	local state = State.Build(player, data)
	local luck = Formulas.Luck(state)
	local planetId = Formulas.RollPlanet(rng, entry.Galaxy, luck)
	local mutation = Formulas.RollMutation(rng, luck)
	table.remove(data.Incubator, i)

	local planetUid, isNew = PlanetService.Add(player, planetId, mutation)
	data.Stats.Hatched += 1

	DataService.Push(player, "Incubator")
	IncubatorService.Render(player)
	flushQueue(player)

	local p = Planets.ById[planetId]
	Net.Fire(player, "Hatched", {
		Galaxy = entry.Galaxy,
		Planet = planetId,
		Mutation = mutation,
		Uid = planetUid,
		New = isNew,
		Rarity = p and p.Rarity,
	})
	return true
end

function IncubatorService.HatchAll(player: Player)
	local data = DataService.Get(player)
	if not data then return end
	local now = os.time()
	local ready = {}
	for _, e in ipairs(data.Incubator) do
		if now >= e.EndsAt then table.insert(ready, e.Uid) end
	end
	if #ready == 0 then
		Net.Notify(player, "Nothing is ready to hatch.", "warn")
		return
	end
	for _, uid in ipairs(ready) do
		IncubatorService.Hatch(player, uid, true)
	end
end

-- termine le timer tout de suite (achat Robux "Skip")
function IncubatorService.Skip(player: Player, uid: string?): boolean
	local data = DataService.Get(player)
	if not data or #data.Incubator == 0 then return false end
	local target
	if uid then
		local i = findIndex(data, uid)
		target = i and data.Incubator[i]
	end
	if not target then
		-- par défaut : celle qui a le plus de temps restant
		for _, e in ipairs(data.Incubator) do
			if not target or e.EndsAt > target.EndsAt then target = e end
		end
	end
	if not target then return false end
	target.EndsAt = os.time()
	DataService.Push(player, "Incubator")
	IncubatorService.Render(player)
	return true
end

function IncubatorService.SkipAll(player: Player): boolean
	local data = DataService.Get(player)
	if not data or #data.Incubator == 0 then return false end
	for _, e in ipairs(data.Incubator) do
		e.EndsAt = math.min(e.EndsAt, os.time())
	end
	DataService.Push(player, "Incubator")
	IncubatorService.Render(player)
	return true
end

-- recalcule les timers en cours quand la vitesse d'éclosion change (upgrade / gamepass)
function IncubatorService.Rescale(player: Player, oldFactor: number, newFactor: number)
	local data = DataService.Get(player)
	if not data or oldFactor <= 0 then return end
	local now = os.time()
	for _, e in ipairs(data.Incubator) do
		local left = e.EndsAt - now
		if left > 0 then
			e.EndsAt = now + math.ceil(left * newFactor / oldFactor)
		end
	end
	DataService.Push(player, "Incubator")
	IncubatorService.Render(player)
end

function IncubatorService.Start()
	DataService.OnLoaded(function(player)
		-- la base est attribuée dans le même événement : on attend qu'elle existe
		local t = 0
		while not PlotService.Get(player) and t < 10 and player.Parent do
			task.wait(0.2); t += 0.2
		end
		IncubatorService.Render(player)
		flushQueue(player)
	end)

	Net.On("Hatch", function(player, uid)
		if Net.IsString(uid, 16) then IncubatorService.Hatch(player, uid) end
	end, 6, 10)
	Net.On("HatchAll", function(player)
		IncubatorService.HatchAll(player)
	end, 1, 3)

	-- gamepass Auto-Éclore
	task.spawn(function()
		while true do
			task.wait(Upgrades.Base.AutoHatchInterval)
			for _, player in ipairs(Players:GetPlayers()) do
				local data = DataService.Get(player)
				if data and player:GetAttribute("Pass_AutoHatch") and data.Settings.AutoHatch ~= false then
					local now = os.time()
					for _, e in ipairs(table.clone(data.Incubator)) do
						if now >= e.EndsAt then IncubatorService.Hatch(player, e.Uid, true) end
					end
				end
			end
		end
	end)
end

return IncubatorService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">IndexService</string><ProtectedString name="Source"><![CDATA[--!strict
-- ServerScriptService/Services/IndexService
-- L'Index retient chaque planète découverte (et chaque version mutée).
-- Compléter une rareté (les 5 planètes, version normale) = bonus d'argent permanent à réclamer.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Planets = require(Shared.Config.Planets)
local IndexRewards = require(Shared.Config.IndexRewards)
local Format = require(Shared.Util.Format)

local Net = require(script.Parent.Parent.Lib.Net)
local DataService = require(script.Parent.DataService)

local IndexService = {}

-- marque une planète comme découverte. Renvoie true si c'est une nouvelle entrée.
function IndexService.Mark(player: Player, planetId: string, mutation: string?): boolean
	local data = DataService.Get(player)
	if not data then return false end
	local isNew = false
	if not data.Index[planetId] then
		data.Index[planetId] = true
		isNew = true
	end
	if mutation then
		local k = planetId .. ":" .. mutation
		if not data.Index[k] then
			data.Index[k] = true
			isNew = true
		end
	end
	if isNew then DataService.Push(player, "Index") end
	return isNew
end

function IndexService.IsComplete(data: any, rarity: string): boolean
	local pool = Planets.ByRarity[rarity]
	if not pool then return false end
	for _, p in ipairs(pool) do
		if not data.Index[p.Id] then return false end
	end
	return true
end

function IndexService.Start()
	Net.On("ClaimIndex", function(player, rarity)
		if not Net.IsString(rarity, 16) or not IndexRewards.Bonus[rarity] then return end
		local data = DataService.Get(player)
		if not data or data.IndexClaimed[rarity] then return end
		if not IndexService.IsComplete(data, rarity) then
			Net.Notify(player, "Discover every " .. rarity .. " planet first!", "warn")
			return
		end
		data.IndexClaimed[rarity] = true
		DataService.Push(player, "IndexClaimed")
		Net.Notify(player, rarity .. " collection complete! +" .. Format.Percent(IndexRewards.Bonus[rarity]) .. " money forever!", "success")
		Net.Fire(player, "IndexClaimed", rarity)
	end, 1, 3)
end

return IndexService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">PlanetService</string><ProtectedString name="Source"><![CDATA[--!strict
-- ServerScriptService/Services/PlanetService
-- Inventaire des planètes : ajouter, équiper / déséquiper, équiper les meilleures,
-- verrouiller (protège de la vente), vendre.
-- Les planètes équipées sont affichées en orbite (attribut "Equipped" sur la base, lu par le client).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Formulas = require(Shared.Util.Formulas)
local Format = require(Shared.Util.Format)
local Planets = require(Shared.Config.Planets)
local Rarities = require(Shared.Config.Rarities)

local Net = require(script.Parent.Parent.Lib.Net)
local State = require(script.Parent.Parent.Lib.State)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local IndexService = require(script.Parent.IndexService)

local PlanetService = {}

function PlanetService.Count(data: any): number
	local n = 0
	for _ in pairs(data.Planets) do n += 1 end
	return n
end

local function equippedCount(data: any): number
	local n = 0
	for _, p in pairs(data.Planets) do
		if p.Eq then n += 1 end
	end
	return n
end

local function slots(player: Player, data: any): number
	return Formulas.EquipSlots(State.Build(player, data))
end

-- met à jour l'orbite visible (liste "Id:Mutation" séparée par des virgules)
function PlanetService.RefreshOrbit(player: Player)
	local data = DataService.Get(player)
	local plot = PlotService.Get(player)
	if not data or not plot then return end
	local list = {}
	for _, p in pairs(data.Planets) do
		if p.Eq then table.insert(list, p.Id .. ":" .. (p.Mut or "")) end
	end
	table.sort(list)
	plot:SetAttribute("Equipped", table.concat(list, ","))
end

-- argent/s de base de toutes les planètes équipées (sans multiplicateurs)
function PlanetService.BaseIncome(data: any): number
	local total = 0
	for _, p in pairs(data.Planets) do
		if p.Eq then total += Formulas.PlanetIncome(p.Id, p.Mut) end
	end
	return total
end

local function changed(player: Player)
	DataService.Push(player, "Planets")
	PlanetService.RefreshOrbit(player)
end

-- ajoute une planète. Équipe automatiquement s'il reste un emplacement.
function PlanetService.Add(player: Player, planetId: string, mutation: string?): (string?, boolean)
	local data = DataService.Get(player)
	if not data or not Planets.ById[planetId] then return nil, false end
	local uid = tostring(data.NextUid)
	data.NextUid += 1
	local entry = { Id = planetId, Mut = mutation, Eq = false, Lock = false }
	data.Planets[uid] = entry
	if equippedCount(data) < slots(player, data) then
		entry.Eq = true
	end
	local isNew = IndexService.Mark(player, planetId, mutation)
	changed(player)
	return uid, isNew
end

local function get(data: any, uid: any): any?
	if type(uid) ~= "string" or #uid > 16 then return nil end
	return data.Planets[uid]
end

function PlanetService.EquipBest(player: Player)
	local data = DataService.Get(player)
	if not data then return end
	local list = {}
	for uid, p in pairs(data.Planets) do
		p.Eq = false
		table.insert(list, { uid = uid, income = Formulas.PlanetIncome(p.Id, p.Mut) })
	end
	table.sort(list, function(a, b) return a.income > b.income end)
	for i = 1, math.min(#list, slots(player, data)) do
		data.Planets[list[i].uid].Eq = true
	end
	changed(player)
end

function PlanetService.Start()
	DataService.OnLoaded(function(player, data)
		-- si des emplacements ont disparu (ex. gamepass remboursé), on retire l'excédent
		local maxSlots = slots(player, data)
		if equippedCount(data) > maxSlots then
			PlanetService.EquipBest(player)
		end
		local t = 0
		while not PlotService.Get(player) and t < 10 and player.Parent do
			task.wait(0.2); t += 0.2
		end
		PlanetService.RefreshOrbit(player)
	end)

	Net.On("Equip", function(player, uid)
		local data = DataService.Get(player)
		local p = data and get(data, uid)
		if not p or p.Eq then return end
		if equippedCount(data) >= slots(player, data) then
			Net.Notify(player, "All slots are full! Unequip a planet first.", "warn")
			return
		end
		p.Eq = true
		changed(player)
	end, 8, 12)

	Net.On("Unequip", function(player, uid)
		local data = DataService.Get(player)
		local p = data and get(data, uid)
		if not p or not p.Eq then return end
		p.Eq = false
		changed(player)
	end, 8, 12)

	Net.On("EquipBest", function(player)
		PlanetService.EquipBest(player)
	end, 1, 3)

	Net.On("Lock", function(player, uid)
		local data = DataService.Get(player)
		local p = data and get(data, uid)
		if not p then return end
		p.Lock = not p.Lock
		DataService.Push(player, "Planets")
	end, 6, 10)

	Net.On("Sell", function(player, uid)
		local data = DataService.Get(player)
		local p = data and get(data, uid)
		if not p then return end
		if p.Eq or p.Lock then
			Net.Notify(player, "Unequip / unlock this planet before selling it.", "warn")
			return
		end
		local value = Formulas.SellValue(p.Id, p.Mut)
		data.Planets[uid] = nil
		data.Money += value
		DataService.Push(player, "Money")
		changed(player)
		Net.Notify(player, "Sold for " .. Format.Money(value), "money")
	end, 8, 12)

	-- vend toutes les planètes NON équipées, NON verrouillées, jusqu'à une rareté donnée
	Net.On("SellAll", function(player, maxOrder)
		if not Net.IsInt(maxOrder, 1, #Rarities.List) then return end
		local data = DataService.Get(player)
		if not data then return end
		local total, n = 0, 0
		for uid, p in pairs(data.Planets) do
			local planet = Planets.ById[p.Id]
			if not p.Eq and not p.Lock and planet and Rarities.Info[planet.Rarity].Order <= maxOrder then
				total += Formulas.SellValue(p.Id, p.Mut)
				data.Planets[uid] = nil
				n += 1
			end
		end
		if n == 0 then
			Net.Notify(player, "Nothing to sell.", "warn")
			return
		end
		data.Money += total
		DataService.Push(player, "Money")
		changed(player)
		Net.Notify(player, "Sold " .. n .. " planets for " .. Format.Money(total), "money")
	end, 1, 2)
end

return PlanetService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">PlotService</string><ProtectedString name="Source"><![CDATA[--!strict
-- ServerScriptService/Services/PlotService
-- 8 bases autour du hub (Workspace.Map.Plots.Plot1..8). À l'arrivée, chaque joueur reçoit
-- la première base libre, son nom s'affiche sur le panneau, et il y apparaît.
-- Tout ce qui est créé pendant la partie (galaxies, planètes en orbite) va dans Plot.Dynamic
-- et est vidé quand le joueur part.

local Players = game:GetService("Players")

local Net = require(script.Parent.Parent.Lib.Net)
local DataService = require(script.Parent.DataService)

local PlotService = {}

local plotsFolder: Folder
local owners: { [Player]: Model } = {}

local function plotList(): { Model }
	local list = {}
	for _, p in ipairs(plotsFolder:GetChildren()) do
		if p:IsA("Model") then table.insert(list, p) end
	end
	table.sort(list, function(a, b) return (a:GetAttribute("Index") or 0) < (b:GetAttribute("Index") or 0) end)
	return list
end

local function setSign(plot: Model, text: string)
	local sign = plot:FindFirstChild("Sign")
	local label = sign and sign:FindFirstChild("Label", true)
	if label and label:IsA("TextLabel") then
		label.Text = text
	end
end

local function clearDynamic(plot: Model)
	local dyn = plot:FindFirstChild("Dynamic")
	if dyn then dyn:ClearAllChildren() end
end

local function spawnCFrame(plot: Model): CFrame
	local s = plot:FindFirstChild("Spawn")
	if s and s:IsA("BasePart") then
		return s.CFrame + Vector3.new(0, 3, 0)
	end
	return plot:GetPivot() + Vector3.new(0, 5, 0)
end

function PlotService.Get(player: Player): Model?
	return owners[player]
end

function PlotService.TeleportHome(player: Player)
	local plot = owners[player]
	local char = player.Character
	if plot and char then
		char:PivotTo(spawnCFrame(plot))
	end
end

local function assign(player: Player)
	for _, plot in ipairs(plotList()) do
		if not plot:GetAttribute("OwnerId") then
			plot:SetAttribute("OwnerId", player.UserId)
			plot:SetAttribute("OwnerName", player.DisplayName)
			owners[player] = plot
			player:SetAttribute("Plot", plot.Name)
			setSign(plot, player.DisplayName .. "'s Base")
			clearDynamic(plot)
			-- le joueur réapparaît toujours dans sa base
			player.RespawnLocation = nil
			if player.Character then
				task.defer(PlotService.TeleportHome, player)
			end
			return plot
		end
	end
	warn("[PlotService] plus de base libre pour " .. player.Name)
	return nil
end

local function free(player: Player)
	local plot = owners[player]
	if not plot then return end
	owners[player] = nil
	plot:SetAttribute("OwnerId", nil)
	plot:SetAttribute("OwnerName", nil)
	plot:SetAttribute("Equipped", nil)
	setSign(plot, "Empty Base")
	clearDynamic(plot)
end

function PlotService.Start()
	plotsFolder = workspace:WaitForChild("Map"):WaitForChild("Plots") :: Folder
	for _, plot in ipairs(plotList()) do
		setSign(plot, "Empty Base")
		if not plot:FindFirstChild("Dynamic") then
			local d = Instance.new("Folder")
			d.Name = "Dynamic"
			d.Parent = plot
		end
	end

	DataService.OnLoaded(function(player)
		assign(player)
	end)
	-- on libère APRÈS la sauvegarde (OnRelease est appelé juste avant)
	Players.PlayerRemoving:Connect(function(player)
		task.defer(free, player)
	end)

	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.wait() -- laisse le personnage se poser
			PlotService.TeleportHome(player)
		end)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		player.CharacterAdded:Connect(function()
			task.wait()
			PlotService.TeleportHome(player)
		end)
	end

	Net.On("TeleportBase", function(player)
		PlotService.TeleportHome(player)
	end, 0.5, 2)
end

return PlotService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">ProgressService</string><ProtectedString name="Source"><![CDATA[--!strict
-- ServerScriptService/Services/ProgressService
-- Upgrades de la base, Rebirth, récompenses quotidiennes, codes et paramètres.
-- (petits systèmes regroupés ici pour garder un seul fichier simple)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Formulas = require(Shared.Util.Formulas)
local Format = require(Shared.Util.Format)
local Upgrades = require(Shared.Config.Upgrades)
local DailyRewards = require(Shared.Config.DailyRewards)
local Codes = require(game:GetService("ServerStorage"):WaitForChild("Config"):WaitForChild("Codes"))

local Net = require(script.Parent.Parent.Lib.Net)
local State = require(script.Parent.Parent.Lib.State)
local Rewards = require(script.Parent.Parent.Lib.Rewards)
local DataService = require(script.Parent.DataService)
local IncubatorService = require(script.Parent.IncubatorService)
local PlanetService = require(script.Parent.PlanetService)

local ProgressService = {}

local DAILY_COOLDOWN = 20 * 3600 -- on peut réclamer toutes les 20 h (pas besoin d'attendre minuit)

local function buyUpgrade(player: Player, name: any)
	if not Net.IsString(name, 20) or not Upgrades[name] or not Upgrades[name].MaxLevel then return end
	local data = DataService.Get(player)
	if not data then return end
	local level = data.Upgrades[name] or 0
	local cost = Formulas.UpgradeCost(name, level)
	if not cost then
		Net.Notify(player, "Already maxed!", "warn")
		return
	end
	if data.Money < cost then
		Net.Notify(player, "Not enough money! You need " .. Format.Money(cost - data.Money) .. " more.", "error")
		return
	end
	local oldFactor = Upgrades.HatchSpeed.Value(data.Upgrades.HatchSpeed or 0)
	data.Money -= cost
	data.Upgrades[name] = level + 1
	DataService.Push(player, "Money")
	DataService.Push(player, "Upgrades")
	if name == "HatchSpeed" then
		IncubatorService.Rescale(player, oldFactor, Upgrades.HatchSpeed.Value(level + 1))
	end
	Net.Fire(player, "Upgraded", { Name = name, Level = level + 1 })
end

local function rebirth(player: Player)
	local data = DataService.Get(player)
	if not data then return end
	local cost = Formulas.RebirthCost(data.Rebirths)
	if data.Money < cost then
		Net.Notify(player, "You need " .. Format.Money(cost) .. " to rebirth!", "error")
		return
	end
	data.Money = 0
	data.Rebirths += 1
	DataService.Push(player, "Money")
	DataService.Push(player, "Rebirths")
	-- nouvel emplacement d'équipement : on remplit avec les meilleures planètes
	PlanetService.EquipBest(player)
	Net.Fire(player, "Rebirthed", { Rebirths = data.Rebirths })
	Net.Notify(player, "REBIRTH! Money x" .. (1 + 0.5 * data.Rebirths) .. " forever!", "success")
end

local function claimDaily(player: Player)
	local data = DataService.Get(player)
	if not data then return end
	local now = os.time()
	if data.Daily.Last > 0 and now - data.Daily.Last < DAILY_COOLDOWN then
		Net.Notify(player, "Come back in " .. Format.Time(DAILY_COOLDOWN - (now - data.Daily.Last)) .. "!", "warn")
		return
	end
	if data.Daily.Last > 0 and now - data.Daily.Last > DailyRewards.ResetAfterHours * 3600 then
		data.Daily.Day = 0 -- série cassée
	end
	data.Daily.Day = data.Daily.Day % #DailyRewards.Days + 1
	data.Daily.Last = now
	local text = Rewards.Give(player, DailyRewards.Days[data.Daily.Day])
	DataService.Push(player, "Daily")
	Net.Fire(player, "DailyClaimed", { Day = data.Daily.Day, Text = text })
end

local function redeem(player: Player, code: any)
	if type(code) ~= "string" or #code > 30 then return { ok = false, msg = "Invalid code" } end
	code = string.upper((code:gsub("%s", "")))
	local data = DataService.Get(player)
	if not data then return { ok = false, msg = "Loading..." } end
	local c = Codes[code]
	if not c then return { ok = false, msg = "Invalid code" } end
	if c.Expires and os.time() > c.Expires then return { ok = false, msg = "Code expired" } end
	if data.Codes[code] then return { ok = false, msg = "Already redeemed" } end
	data.Codes[code] = true
	local text = Rewards.Give(player, c.Reward)
	DataService.Push(player, "Codes")
	return { ok = true, msg = "+" .. text }
end

local SETTINGS = { Music = true, Sfx = true, LowGfx = true, AutoHatch = true }

function ProgressService.Start()
	Net.On("BuyUpgrade", buyUpgrade, 4, 6)
	Net.On("Rebirth", rebirth, 0.5, 1)
	Net.On("ClaimDaily", claimDaily, 0.5, 2)
	Net.OnInvoke("Redeem", redeem, 0.5, 3)
	Net.On("Setting", function(player, key, value)
		if not Net.IsString(key, 16) or not SETTINGS[key] or type(value) ~= "boolean" then return end
		local data = DataService.Get(player)
		if not data then return end
		data.Settings[key] = value
		DataService.Push(player, "Settings")
	end, 4, 8)
	Net.On("Tutorial", function(player, step)
		local data = DataService.Get(player)
		if data and Net.IsInt(step, 0, 50) and step > data.Tutorial then
			data.Tutorial = step
		end
	end, 2, 4)
	local _ = State
end

return ProgressService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[--!strict
-- ServerScriptService/Services/ShopService
-- Achats Robux.
--   * Gamepasses : vérifiés à l'arrivée + après achat → attribut Pass_<Nom> sur le joueur
--   * Developer products : ProcessReceipt IDEMPOTENT. Chaque reçu (PurchaseId) est noté dans
--     la sauvegarde : un achat n'est jamais donné 2 fois, et jamais perdu (si la sauvegarde
--     échoue, Roblox redemandera plus tard).

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Gamepasses = require(Shared.Config.Gamepasses)
local Products = require(Shared.Config.Products)
local Upgrades = require(Shared.Config.Upgrades)
local Gamepass = Gamepasses

local Net = require(script.Parent.Parent.Lib.Net)
local Rewards = require(script.Parent.Parent.Lib.Rewards)
local DataService = require(script.Parent.DataService)
local IncubatorService = require(script.Parent.IncubatorService)
local PlanetService = require(script.Parent.PlanetService)

local ShopService = {}

local skipTarget: { [Player]: string } = {}

-- justBought = true seulement juste après un achat (pas à chaque connexion :
-- les timers sauvegardés tiennent déjà compte du pass)
local function setPass(player: Player, name: string, owned: boolean, justBought: boolean?)
	local before = player:GetAttribute("Pass_" .. name) == true
	player:SetAttribute("Pass_" .. name, owned)
	if owned and not before and justBought then
		if name == "FastHatch" then
			IncubatorService.Rescale(player, 1, Gamepass.FastHatch.Value)
		elseif name == "ExtraSlots" then
			PlanetService.EquipBest(player)
		end
	end
end

local function checkPasses(player: Player)
	for name, info in pairs(Gamepasses) do
		if info.Id and info.Id ~= 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, info.Id)
			if ok and owns then setPass(player, name, true) end
		end
	end
end

-- produit -> ce qu'il donne
local function grant(player: Player, key: string, info: any, data: any): boolean
	if info.Boost and info.Duration then
		Rewards.AddBoost(player, info.Boost, info.Duration)
	elseif key == "SkipOne" then
		if not IncubatorService.Skip(player, skipTarget[player]) then
			-- rien à accélérer : on rend la valeur en argent pour ne pas perdre l'achat
			Rewards.Give(player, { Type = "Money", Minutes = 10, Min = 1000 })
		end
		skipTarget[player] = nil
	elseif key == "SkipAll" then
		if not IncubatorService.SkipAll(player) then
			Rewards.Give(player, { Type = "Money", Minutes = 30, Min = 5000 })
		end
	elseif info.Minutes then
		Rewards.Give(player, { Type = "Money", Minutes = info.Minutes, Min = info.Min })
	elseif key == "StarterPack" then
		local g = info.Gives
		Rewards.Give(player, { Type = "Money", Amount = g.Money })
		if not data.StarterPack then
			IncubatorService.Give(player, g.Galaxy)
			Rewards.AddBoost(player, g.Boost, g.BoostDuration)
		end
		data.StarterPack = true
		DataService.Push(player, "StarterPack")
	elseif info.Galaxy then
		IncubatorService.Give(player, info.Galaxy)
	else
		return false
	end
	return true
end

local productById: { [number]: string } = {}
for key, info in pairs(Products) do
	if info.Id and info.Id ~= 0 then productById[info.Id] = key end
end

MarketplaceService.ProcessReceipt = function(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then return Enum.ProductPurchaseDecision.NotProcessedYet end
	local data = DataService.Get(player)
	if not data then return Enum.ProductPurchaseDecision.NotProcessedYet end
	local purchaseId = tostring(receipt.PurchaseId)
	if DataService.HasReceipt(data, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local key = productById[receipt.ProductId]
	if not key then
		warn("[ShopService] produit inconnu " .. receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, granted = pcall(grant, player, key, Products[key], data)
	if not ok or not granted then
		warn("[ShopService] échec " .. key .. " : " .. tostring(granted))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	DataService.AddReceipt(data, purchaseId)
	-- la sauvegarde DOIT réussir avant de dire "accordé" ; sinon Roblox redemandera
	-- (le reçu est déjà noté en mémoire : pas de double don dans cette session)
	if not DataService.SaveNow(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	Net.Fire(player, "Purchased", { Key = key })
	Net.Notify(player, "Thanks for your purchase! (" .. Products[key].Name .. ")", "success")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function ShopService.Start()
	DataService.OnLoaded(function(player)
		checkPasses(player)
	end)
	Players.PlayerRemoving:Connect(function(p) skipTarget[p] = nil end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then return end
		for name, info in pairs(Gamepasses) do
			if info.Id == passId then
				setPass(player, name, true, true)
				Net.Notify(player, "You now own " .. info.Name .. "!", "success")
			end
		end
	end)

	-- le client dit quelle galaxie il veut accélérer juste avant d'acheter "Skip"
	Net.On("SkipTarget", function(player, uid)
		if Net.IsString(uid, 16) then skipTarget[player] = uid end
	end, 4, 6)

	-- TESTS dans Studio uniquement : argent / pass gratuits pour essayer le jeu
	if RunService:IsStudio() then
		Net.On("Debug", function(player, what, value)
			local data = DataService.Get(player)
			if not data then return end
			if what == "Money" and Net.IsInt(value, 0, 1e15) then
				data.Money += value
				DataService.Push(player, "Money")
			elseif what == "Pass" and type(value) == "string" and Gamepasses[value] then
				setPass(player, value, not player:GetAttribute("Pass_" .. value), true)
			elseif what == "Product" and type(value) == "string" and Products[value] then
				grant(player, value, Products[value], data)
			elseif what == "SkipAll" then
				IncubatorService.SkipAll(player)
			end
		end, 10, 20)
	end
	local _ = Upgrades
end

return ShopService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">SpawnerService</string><ProtectedString name="Source"><![CDATA[--!strict
-- ServerScriptService/Services/SpawnerService
-- Les spawners de la base : une galaxie apparaît sur chaque spawner libre.
-- Le joueur l'achète avec le bouton "Buy" (ProximityPrompt vérifié par le serveur).
-- Ces offres ne sont pas sauvegardées : elles se renouvellent tout le temps.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Formulas = require(Shared.Util.Formulas)
local Format = require(Shared.Util.Format)
local Galaxies = require(Shared.Config.Galaxies)
local Rarities = require(Shared.Config.Rarities)
local Models = require(Shared.Visuals.Models)

local Net = require(script.Parent.Parent.Lib.Net)
local State = require(script.Parent.Parent.Lib.State)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local IncubatorService = require(script.Parent.IncubatorService)

local SpawnerService = {}
local MAX_PADS = 4

type Offer = { Galaxy: string, Expires: number, Model: Model }
type PlayerPads = { offers: { [number]: Offer? }, nextAt: { [number]: number } }
local pads: { [Player]: PlayerPads } = {}
local rng = Random.new()

local function padPart(plot: Model, i: number): BasePart?
	local f = plot:FindFirstChild("Pads")
	local p = f and f:FindFirstChild("Pad" .. i)
	return if p and p:IsA("BasePart") then p else nil
end

local function clearOffer(player: Player, i: number)
	local pp = pads[player]
	if not pp then return end
	local o = pp.offers[i]
	if o and o.Model then o.Model:Destroy() end
	pp.offers[i] = nil
	pp.nextAt[i] = os.clock() + Galaxies.Spawn.Interval
end

local function buy(player: Player, i: number)
	local pp = pads[player]
	local data = DataService.Get(player)
	local o = pp and pp.offers[i]
	if not o or not data then return end
	local g = Galaxies.ById[o.Galaxy]
	if not g then return end
	-- le joueur doit être à côté du spawner
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or not o.Model.PrimaryPart or (root.Position - o.Model.PrimaryPart.Position).Magnitude > 20 then return end
	if data.Money < g.Price then
		Net.Notify(player, "Not enough money! You need " .. Format.Money(g.Price - data.Money) .. " more.", "error")
		return
	end
	if IncubatorService.FreeSlots(player) <= 0 then
		Net.Notify(player, "Your incubator is full! Hatch a galaxy first.", "warn")
		return
	end
	data.Money -= g.Price
	DataService.Push(player, "Money")
	clearOffer(player, i)
	IncubatorService.Add(player, g.Id)
	Net.Fire(player, "GalaxyBought", { Galaxy = g.Id })
end

local function spawnOffer(player: Player, plot: Model, i: number)
	local pad = padPart(plot, i)
	local data = DataService.Get(player)
	if not pad or not data then return end
	local luck = Formulas.Luck(State.Build(player, data))
	local galaxyId = Formulas.RollGalaxy(rng, luck)
	local g = Galaxies.ById[galaxyId]
	local rarity = Rarities.Info[g.Rarity]

	local model = Models.Galaxy(galaxyId, 0.75)
	-- les pads sont des cylindres couchés : la hauteur est Size.X
	model:PivotTo(CFrame.new(pad.Position + Vector3.new(0, pad.Size.X / 2 + 4, 0)))
	model:SetAttribute("OwnerId", player.UserId)
	model:SetAttribute("Expires", os.time() + Galaxies.Spawn.Lifetime)
	model:SetAttribute("Rarity", g.Rarity)

	local bb = Instance.new("BillboardGui")
	bb.Name = "Info"
	bb.Size = UDim2.fromScale(7, 3)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 4.5, 0)
	bb.MaxDistance = 90
	bb.LightInfluence = 0
	local function line(name: string, text: string, y: number, h: number, color: Color3)
		local l = Instance.new("TextLabel")
		l.Name = name
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromScale(0, y)
		l.Size = UDim2.fromScale(1, h)
		l.Font = Enum.Font.GothamBlack
		l.TextScaled = true
		l.Text = text
		l.TextColor3 = color
		l.TextStrokeTransparency = 0
		l.Parent = bb
	end
	line("Rarity", string.upper(rarity.Name), 0, 0.26, rarity.Color)
	line("GalaxyName", g.Name, 0.26, 0.3, Color3.new(1, 1, 1))
	line("Price", Format.Money(g.Price), 0.56, 0.3, Color3.fromRGB(120, 255, 100))
	line("Time", "", 0.86, 0.18, Color3.fromRGB(220, 220, 230))
	bb.Parent = model.PrimaryPart

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "BuyPrompt"
	prompt.ActionText = "Buy " .. Format.Money(g.Price)
	prompt.ObjectText = g.Name
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = model.PrimaryPart
	prompt.Triggered:Connect(function(who)
		if who == player then buy(player, i) end
	end)

	local dyn = plot:FindFirstChild("Dynamic")
	model.Parent = dyn
	pads[player].offers[i] = { Galaxy = galaxyId, Expires = os.time() + Galaxies.Spawn.Lifetime, Model = model }

	-- annonce serveur pour les galaxies très rares
	if rarity.Order >= 5 then
		for _, other in ipairs(Players:GetPlayers()) do
			Net.Notify(other, player.DisplayName .. " got a " .. string.upper(rarity.Name) .. " galaxy: " .. g.Name .. "!", "rare")
		end
	end
end

local function tick()
	local now = os.clock()
	for _, player in ipairs(Players:GetPlayers()) do
		local data = DataService.Get(player)
		local plot = PlotService.Get(player)
		if data and plot then
			local pp = pads[player]
			if not pp then
				pp = { offers = {}, nextAt = {} }
				pads[player] = pp
			end
			local count = Formulas.SpawnerCount(State.Build(player, data))
			for i = 1, MAX_PADS do
				local pad = padPart(plot, i)
				if pad then pad:SetAttribute("Locked", i > count) end
				local o = pp.offers[i]
				if i > count then
					if o then clearOffer(player, i) end
				elseif o then
					if os.time() >= o.Expires then clearOffer(player, i) end
				elseif now >= (pp.nextAt[i] or 0) then
					spawnOffer(player, plot, i)
				end
			end
		end
	end
end

function SpawnerService.Start()
	Players.PlayerRemoving:Connect(function(player)
		pads[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(tick)
			if not ok then warn("[SpawnerService] " .. tostring(err)) end
		end
	end)
end

return SpawnerService
]]></ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="RBX38"><Properties><string name="Name">ServerStorage</string></Properties><Item class="Folder" referent="RBX37"><Properties><string name="Name">Config</string></Properties><Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">Codes</string><ProtectedString name="Source"><![CDATA[--!strict
-- ServerStorage/Config/Codes (côté serveur : les joueurs ne peuvent pas lire la liste)
-- Codes promo (majuscules). Un code ne marche qu'une fois par joueur. Expires = os.time() ou nil.

return {
	LAUNCH = { Reward = { Type = "Money", Amount = 1_000 } },
	GALAXY = { Reward = { Type = "Galaxy", Galaxy = "EmeraldSwirl" } },
	LUCKY  = { Reward = { Type = "Boost", Boost = "Luck", Duration = 600 } },
}
]]></ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="RBX50"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX49"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX39"><Properties><string name="Name">GalaxiesController</string><ProtectedString name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Client/GalaxiesController
-- Panneau "Incubator" : les galaxies de l'enclos avec leur timer,
-- bouton HATCH quand c'est prêt, sinon SKIP (Robux). HATCH ALL / SKIP ALL en bas.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Util.Format)
local Galaxies = require(Shared.Config.Galaxies)
local Rarities = require(Shared.Config.Rarities)
local Products = require(Shared.Config.Products)
local Upgrades = require(Shared.Config.Upgrades)
local Formulas = require(Shared.Util.Formulas)
local Models = require(Shared.Visuals.Models)

local State = require(script.Parent.State)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local panel = UI.Panel("Galaxies")
local content = panel:WaitForChild("Body"):WaitForChild("Content")
local list = content:WaitForChild("List") :: ScrollingFrame
local template = list:WaitForChild("Template") :: Frame
local slotsLabel = content:WaitForChild("Slots") :: TextLabel
local queueLabel = content:WaitForChild("Queue") :: TextLabel
local empty = content:WaitForChild("Empty") :: TextLabel

local cards: { [string]: Frame } = {}

local function promptProduct(key: string)
	local id = Products[key].Id
	if id == 0 then
		UI.Notify("Coming soon!", "warn")
		return
	end
	MarketplaceService:PromptProductPurchase(player, id)
end

local function makeCard(entry: any): Frame
	local g = Galaxies.ById[entry.Galaxy]
	local rarity = g and g.Rarity or "Common"
	local c = template:Clone()
	c.Name = entry.Uid
	c.Visible = true
	local design = c:FindFirstChild("Design") :: ImageLabel
	design.ImageColor3 = UI.RarityColor(rarity):Lerp(Color3.new(1, 1, 1), 0.15)
	UI.Tint(design, rarity, "ImageColor3");
	(c:FindFirstChild("GalaxyName") :: TextLabel).Text = g and g.Name or entry.Galaxy;
	(c:FindFirstChild("Rarity") :: TextLabel).Text = string.upper(rarity)
	UI.Viewport(c:FindFirstChild("View") :: ViewportFrame, Models.Galaxy(entry.Galaxy, 1), 1, 0.85)
	local uid = entry.Uid
	UI.Button(c:FindFirstChild("Hatch") :: Frame, function()
		State.Request("Hatch", uid)
	end)
	UI.Button(c:FindFirstChild("Skip") :: Frame, function()
		State.Request("SkipTarget", uid)
		promptProduct("SkipOne")
	end)
	c.Parent = list
	return c
end

local function refresh()
	local incubator = State.Data.Incubator or {}
	local seen = {}
	for i, entry in ipairs(incubator) do
		seen[entry.Uid] = true
		local c = cards[entry.Uid] or makeCard(entry)
		cards[entry.Uid] = c
		c.LayoutOrder = i
		c:SetAttribute("EndsAt", entry.EndsAt)
		c:SetAttribute("Galaxy", entry.Galaxy)
	end
	for uid, c in pairs(cards) do
		if not seen[uid] then
			c:Destroy()
			cards[uid] = nil
		end
	end
	slotsLabel.Text = #incubator .. "/" .. Upgrades.Base.IncubatorSlots .. " GALAXIES"
	local q = State.Data.GivenGalaxies or {}
	queueLabel.Text = #q > 0 and (#q .. " waiting for a slot") or ""
	empty.Visible = #incubator == 0
end
State.On("Incubator", refresh)
State.On("GivenGalaxies", refresh)

-- timers : barre + texte, bouton Hatch / Skip
task.spawn(function()
	while true do
		if panel.Visible then
			local now = State.Now()
			local s = State.Build()
			for _, c in pairs(cards) do
				local ends = c:GetAttribute("EndsAt") or 0
				local total = Formulas.HatchDuration(c:GetAttribute("Galaxy") or "", s)
				local left = ends - now
				local bar = c:FindFirstChild("Bar") :: Frame
				local fill = bar:FindFirstChild("Fill") :: Frame
				local t = bar:FindFirstChild("Time") :: TextLabel
				local ready = left <= 0
				fill.Size = UDim2.fromScale(math.clamp(1 - left / math.max(total, 1), 0, 1), 1)
				t.Text = ready and "READY!" or Format.Time(left)
				local hatch = c:FindFirstChild("Hatch") :: Frame
				local skip = c:FindFirstChild("Skip") :: Frame
				hatch.Visible = ready
				skip.Visible = not ready
			end
		end
		task.wait(0.25)
	end
end)

UI.Button(content:WaitForChild("HatchAll"), function()
	State.Request("HatchAll")
end)
UI.Button(content:WaitForChild("SkipAll"), function()
	promptProduct("SkipAll")
end)
UI.SetLabel(content.SkipAll, "SKIP ALL " .. Products.SkipAll.Price)
UI.SetLabel(template:WaitForChild("Skip"), tostring(Products.SkipOne.Price))

local _ = Rarities
return {}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX40"><Properties><string name="Name">HUDController</string><ProtectedString name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Client/HUDController
-- Le HUD : argent (compteur qui monte), gain/s, boosts actifs, boutons de gauche / bas / droite,
-- badges "!" quand quelque chose attend le joueur, petit tutoriel.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local MarketplaceService = game:GetService("MarketplaceService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Util.Format)
local Formulas = require(Shared.Util.Formulas)
local Models = require(Shared.Visuals.Models)
local Upgrades = require(Shared.Config.Upgrades)
local Gamepasses = require(Shared.Config.Gamepasses)
local DailyRewards = require(Shared.Config.DailyRewards)

local State = require(script.Parent.State)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local hud = UI.HUD
local top = hud:WaitForChild("Top")
local left = hud:WaitForChild("Left")
local bottom = hud:WaitForChild("Bottom")
local right = hud:WaitForChild("Right")

local HUD = {}

-- [ ARGENT ] : le chiffre affiché rattrape doucement la vraie valeur
local shown = 0
local target = 0
State.On("Money", function(v)
	target = v or 0
	if shown == 0 then shown = target end
end)
local moneyLabel = top:WaitForChild("Money") :: TextLabel
local incomeLabel = top:WaitForChild("Income") :: TextLabel
RunService.RenderStepped:Connect(function(dt)
	if shown ~= target then
		local diff = target - shown
		if math.abs(diff) < 1 then shown = target else shown += diff * math.min(1, dt * 8) end
	end
	moneyLabel.Text = Format.Money(shown)
end)
local function updateIncome()
	incomeLabel.Text = "+" .. Format.Money(player:GetAttribute("Income") or 0) .. "/s"
end
player:GetAttributeChangedSignal("Income"):Connect(updateIncome)
updateIncome()

-- [ BOOSTS ] : petits timers sous l'argent
local boosts = top:WaitForChild("Boosts")
task.spawn(function()
	while true do
		local now = State.Now()
		local b = State.Data.Boosts or {}
		for _, name in ipairs({ "Money", "Luck" }) do
			local f = boosts:FindFirstChild(name) :: Frame?
			if f then
				local left = (b[name] or 0) - now
				f.Visible = left > 0
				if left > 0 then
					UI.SetLabel(f, (name == "Money" and "x2 $ " or "x2 LUCK ") .. Format.Time(left))
				end
			end
		end
		task.wait(0.5)
	end
end)

-- [ BOUTONS ]
UI.Button(left:WaitForChild("Daily"), function() UI.Toggle("Daily") end)
UI.Button(left:WaitForChild("Index"), function() UI.Toggle("Index") end)
UI.Button(left:WaitForChild("Rebirth"), function() UI.Toggle("Rebirth") end)
UI.Button(left:WaitForChild("Codes"), function() UI.Toggle("Codes") end)
UI.Button(left:WaitForChild("Settings"), function() UI.Toggle("Settings") end)
UI.Button(left:WaitForChild("VIP"), function()
	local id = Gamepasses.VIP.Id
	if player:GetAttribute("Pass_VIP") then
		UI.Notify("You are already VIP!", "success")
	elseif id ~= 0 then
		MarketplaceService:PromptGamePassPurchase(player, id)
	else
		UI.Open("Shop")
	end
end)
UI.Button(bottom:WaitForChild("Shop"), function() UI.Toggle("Shop") end)
UI.Button(bottom:WaitForChild("Sell"), function()
	HUD.SellMode = true
	UI.Open("Planets")
end)
UI.Button(bottom:WaitForChild("Base"), function()
	UI.Close()
	State.Request("TeleportBase")
end)
UI.Button(right:WaitForChild("Galaxies"), function() UI.Toggle("Galaxies") end)
UI.Button(right:WaitForChild("Planets"), function()
	HUD.SellMode = false
	UI.Toggle("Planets")
end)

-- icônes 3D des boutons de droite
-- si l'icône image est uploadée (Config/UIAssets), on l'affiche ; sinon modèle 3D
local UIAssets = require(Shared.Config.UIAssets)
for name, id in pairs({ Galaxies = UIAssets.IconGalaxies, Planets = UIAssets.IconPlanets }) do
	local f = right[name]
	local icon = f:FindFirstChild("Icon") :: ImageLabel?
	if icon and id ~= 0 then
		icon.Image = "rbxassetid://" .. id
		icon.Visible = true
		f.View.Visible = false
	end
end
if right.Galaxies.View.Visible then UI.Viewport(right.Galaxies.View, Models.Galaxy("AmethystSpiral", 1), 0.8, 0.8) end
if right.Planets.View.Visible then UI.Viewport(right.Planets.View, Models.Planet("GoldenSaturn", nil, 3), 0.6, 0.9) end

-- VIP : la case devient "OWNED" quand on l'a
local function vipLabel()
	UI.SetLabel(left.VIP, player:GetAttribute("Pass_VIP") and "OWNED" or "VIP")
end
player:GetAttributeChangedSignal("Pass_VIP"):Connect(vipLabel)
vipLabel()

-- [ BADGES "!" ] : vérifiés toutes les secondes
local function setBadge(frame: Instance, on: boolean)
	local b = frame:FindFirstChild("Badge") :: GuiObject?
	if not b then return end
	if on and not b.Visible then
		b.Visible = true
		b.Size = UDim2.fromScale(0.1, 0.1)
		TweenService:Create(b, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromScale(0.34, 0.34) }):Play()
	elseif not on then
		b.Visible = false
	end
end

task.spawn(function()
	while true do
		local d = State.Data
		if State.Loaded then
			local now = State.Now()
			-- galaxies prêtes
			local ready, n = 0, 0
			for _, e in ipairs(d.Incubator or {}) do
				n += 1
				if now >= e.EndsAt then ready += 1 end
			end
			setBadge(right.Galaxies, ready > 0)
			local count = right.Galaxies:FindFirstChild("Count") :: TextLabel?
			if count then count.Text = n .. "/" .. Upgrades.Base.IncubatorSlots end
			local pc = right.Planets:FindFirstChild("Count") :: TextLabel?
			if pc then
				local np = 0
				for _ in pairs(d.Planets or {}) do np += 1 end
				pc.Text = tostring(np)
			end
			-- récompense quotidienne
			local daily = d.Daily or { Last = 0 }
			setBadge(left.Daily, daily.Last == 0 or now - daily.Last >= 20 * 3600)
			-- rebirth possible
			setBadge(left.Rebirth, (d.Money or 0) >= Formulas.RebirthCost(d.Rebirths or 0))
			-- collection complète à réclamer
			local claim = false
			local Planets = require(Shared.Config.Planets)
			for rarity, pool in pairs(Planets.ByRarity) do
				if not (d.IndexClaimed or {})[rarity] then
					local all = true
					for _, p in ipairs(pool) do
						if not (d.Index or {})[p.Id] then all = false break end
					end
					if all then claim = true break end
				end
			end
			setBadge(left.Index, claim)
		end
		task.wait(1)
	end
end)

-- [ TUTORIEL ] : une ligne d'aide sous l'argent pour les nouveaux joueurs
local hint = top:FindFirstChild("Hint") :: TextLabel?
if not hint then
	local h = (top:WaitForChild("Income") :: TextLabel):Clone()
	h.Name = "Hint"
	h.Position = UDim2.fromScale(-0.3, 1.25)
	h.Size = UDim2.fromScale(1.6, 0.26)
	h.TextColor3 = Color3.fromRGB(255, 230, 120)
	h.Text = ""
	h.Parent = top
	hint = h
end
local STEPS = {
	"Walk to a galaxy on your spawner and BUY it!",
	"Your galaxy is in the incubator. Wait for the timer...",
	"Open GALAXIES (right) and press HATCH!",
	"Your planet now makes money! Buy more galaxies!",
}
task.spawn(function()
	while true do
		local d = State.Data
		local step = d.Tutorial or 0
		local h = hint :: TextLabel
		if State.Loaded and step < 4 then
			-- avance tout seul selon ce que le joueur a fait
			local hasIncubator = #(d.Incubator or {}) > 0
			local hasPlanet = next(d.Planets or {}) ~= nil
			local newStep = step
			if hasPlanet then newStep = 4
			elseif hasIncubator then
				local readyOne = false
				for _, e in ipairs(d.Incubator) do if State.Now() >= e.EndsAt then readyOne = true end end
				newStep = readyOne and 3 or 2
			else newStep = 1 end
			if newStep ~= step and newStep > step then State.Request("Tutorial", newStep) ; d.Tutorial = newStep end
			h.Text = newStep < 4 and STEPS[newStep] or ""
			h.Visible = newStep < 4
		else
			h.Visible = false
		end
		task.wait(1)
	end
end)

-- [ MESSAGES DU SERVEUR ]
ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Notify").OnClientEvent:Connect(function(text, kind)
	UI.Notify(text, kind)
end)

-- gains hors ligne
State.OnEvent("Offline", function(p)
	local o = UI.Popups:WaitForChild("Offline") :: Frame;
	(o:WaitForChild("Amount") :: TextLabel).Text = Format.Money(p.Amount);
	(o:WaitForChild("Info") :: TextLabel).Text = "You were away for " .. Format.Time(p.Seconds) .. " and earned"
	o.Visible = true
end)
UI.Button(UI.Popups:WaitForChild("Offline"):WaitForChild("Ok"), function()
	UI.Popups.Offline.Visible = false
end)

local _ = DailyRewards
return HUD
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX41"><Properties><string name="Name">HatchController</string><ProtectedString name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Client/HatchController
-- Popup d'éclosion : la planète apparaît en grand avec des rayons, sa rareté,
-- sa mutation et "NEW!" si elle est nouvelle dans l'Index. File d'attente si plusieurs.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Util.Format)
local Formulas = require(Shared.Util.Formulas)
local Planets = require(Shared.Config.Planets)
local Rarities = require(Shared.Config.Rarities)
local Mutations = require(Shared.Config.Mutations)
local Models = require(Shared.Visuals.Models)

local State = require(script.Parent.State)
local UI = require(script.Parent.UI)

local popup = UI.Popups:WaitForChild("Hatch") :: Frame
local rays = popup:WaitForChild("Rays") :: ImageLabel
local view = popup:WaitForChild("View") :: ViewportFrame

local queue: { any } = {}
local showing = false
local closeSignal = Instance.new("BindableEvent")

UI.Button(popup, function() closeSignal:Fire() end)

RunService.RenderStepped:Connect(function(dt)
	if popup.Visible then rays.Rotation = (rays.Rotation + dt * 25) % 360 end
end)

local function showOne(r: any)
	local p = Planets.ById[r.Planet]
	local rarity = p and p.Rarity or "Common"
	local order = Rarities.Info[rarity].Order;
	(popup:WaitForChild("PlanetName") :: TextLabel).Text = p and p.Name or r.Planet
	local rl = popup:WaitForChild("Rarity") :: TextLabel
	rl.Text = string.upper(rarity)
	UI.Tint(rl, rarity, "TextColor3")
	rays.ImageColor3 = UI.RarityColor(rarity)
	local ml = popup:WaitForChild("Mutation") :: TextLabel
	local m = r.Mutation and Mutations.ById[r.Mutation]
	ml.Text = m and (string.upper(m.Name) .. "  x" .. m.Multiplier) or ""
	ml.TextColor3 = m and m.Color or Color3.new(1, 1, 1);
	(popup:WaitForChild("New") :: TextLabel).Visible = r.New == true
	local mult = Formulas.MoneyMultiplier(State.Build());
	(popup:WaitForChild("Income") :: TextLabel).Text = "+" .. Format.Money(Formulas.PlanetIncome(r.Planet, r.Mutation) * mult) .. "/s"

	UI.Viewport(view, Models.Planet(r.Planet, r.Mutation, 3), 1.2, 0.9)
	popup.Visible = true
	popup.BackgroundTransparency = 1
	view.Size = UDim2.fromScale(0.05, 0.05)
	TweenService:Create(popup, TweenInfo.new(0.2), { BackgroundTransparency = 0.45 }):Play()
	TweenService:Create(view, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.fromScale(0.36, 0.5) }):Play()
	UI.Play(order >= 4 and "Rare" or "Hatch", 0.7)

	-- fermeture : clic, ou automatiquement (plus long pour les raretés hautes)
	local done = false
	local conn = closeSignal.Event:Connect(function() done = true end)
	local t = 0
	local maxTime = order >= 4 and 6 or 2.5
	while not done and t < maxTime do
		t += task.wait()
	end
	conn:Disconnect()
	popup.Visible = false
	UI.Viewport(view, nil)
end

State.OnEvent("Hatched", function(r)
	table.insert(queue, r)
	if showing then return end
	showing = true
	while #queue > 0 do
		local item = table.remove(queue, 1)
		-- si beaucoup d'éclosions d'un coup (Hatch All) : on ne montre que les intéressantes
		local p = Planets.ById[item.Planet]
		local order = p and Rarities.Info[p.Rarity].Order or 1
		if #queue >= 3 and order < 3 and not item.Mutation and not item.New then
			UI.Notify("Hatched " .. (p and p.Name or item.Planet), "info")
		else
			showOne(item)
		end
	end
	showing = false
end)

State.OnEvent("GalaxyBought", function()
	UI.Play("Buy", 0.6)
end)
State.OnEvent("Rebirthed", function()
	UI.Play("Rare", 0.7)
end)

return {}
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX42"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Client/Main
-- Démarre tous les contrôleurs de l'interface et du monde.

local folder = script.Parent
local order = {
	"State", "UI",
	"HUDController", "GalaxiesController", "PlanetsController", "ShopController",
	"MenusController", "HatchController", "WorldController",
}
for _, name in ipairs(order) do
	local ok, err = pcall(require, folder:WaitForChild(name))
	if not ok then warn("[Client] " .. name .. " : " .. tostring(err)) end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX43"><Properties><string name="Name">MenusController</string><ProtectedString name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Client/MenusController
-- Petits menus : Upgrades, Rebirth, Index, Daily, Codes, Settings.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Util.Format)
local Formulas = require(Shared.Util.Formulas)
local Upgrades = require(Shared.Config.Upgrades)
local Rebirth = require(Shared.Config.Rebirth)
local Planets = require(Shared.Config.Planets)
local Rarities = require(Shared.Config.Rarities)
local IndexRewards = require(Shared.Config.IndexRewards)
local DailyRewards = require(Shared.Config.DailyRewards)
local Galaxies = require(Shared.Config.Galaxies)
local Models = require(Shared.Visuals.Models)

local State = require(script.Parent.State)
local UI = require(script.Parent.UI)

local function content(name: string): Instance
	return UI.Panel(name):WaitForChild("Body"):WaitForChild("Content")
end

-- [ UPGRADES ] -------------------------------------------------------------------
do
	local c = content("Upgrades")
	local function effect(name: string, level: number): string
		local u = Upgrades[name]
		if name == "Luck" then return "x" .. string.format("%.2f", u.Value(level)) end
		if name == "Spawners" then return tostring(u.Value(level)) .. " spawners" end
		local pct = math.floor((1 - u.Value(level)) * 100 + 0.5)
		return pct == 0 and "Normal speed" or ("-" .. pct .. "% hatch time")
	end
	local function refresh()
		local lv = State.Data.Upgrades or {}
		local money = State.Data.Money or 0
		for _, name in ipairs({ "Luck", "Spawners", "HatchSpeed" }) do
			local row = c:FindFirstChild(name)
			if row then
				local u = Upgrades[name]
				local level = lv[name] or 0
				local cost = Formulas.UpgradeCost(name, level);
				(row:FindFirstChild("Level") :: TextLabel).Text = "LV " .. level .. "/" .. u.MaxLevel;
				(row:FindFirstChild("Effect") :: TextLabel).Text = cost and (effect(name, level) .. "  >  " .. effect(name, level + 1)) or effect(name, level)
				local buy = row:FindFirstChild("Buy") :: Frame
				UI.SetLabel(buy, cost and Format.Money(cost) or "MAX")
				local d = buy:FindFirstChild("Design") :: ImageLabel
				d.ImageColor3 = (cost and money >= cost) and Color3.new(1, 1, 1) or Color3.fromRGB(150, 150, 150)
			end
		end
	end
	for _, name in ipairs({ "Luck", "Spawners", "HatchSpeed" }) do
		local row = c:WaitForChild(name)
		UI.Button(row:WaitForChild("Buy"), function() State.Request("BuyUpgrade", name) end)
	end
	State.On("Upgrades", refresh)
	State.On("Money", function() if UI.IsOpen("Upgrades") then refresh() end end)
	UI.OnOpen("Upgrades", refresh)
end

-- [ REBIRTH ] --------------------------------------------------------------------
do
	local c = content("Rebirth")
	local function refresh()
		local r = State.Data.Rebirths or 0
		local money = State.Data.Money or 0
		local cost = Formulas.RebirthCost(r);
		(c:FindFirstChild("Before") :: TextLabel).Text = "x" .. Rebirth.Multiplier(r);
		(c:FindFirstChild("After") :: TextLabel).Text = "x" .. Rebirth.Multiplier(r + 1)
		local bar = c:FindFirstChild("Bar") :: Frame;
		(bar:FindFirstChild("Fill") :: Frame).Size = UDim2.fromScale(math.clamp(money / cost, 0, 1), 1);
		(bar:FindFirstChild("Label") :: TextLabel).Text = Format.Money(money) .. " / " .. Format.Money(cost)
		local doBtn = c:FindFirstChild("Do") :: Frame;
		(doBtn:FindFirstChild("Design") :: ImageLabel).ImageColor3 = money >= cost and Color3.new(1, 1, 1) or Color3.fromRGB(150, 150, 150)
		local bonus = Rebirth.BonusSlots(r + 1) > Rebirth.BonusSlots(r);
		(c:FindFirstChild("Info") :: TextLabel).Text = "Money multiplier forever" .. (bonus and " + 1 equip slot" or "") .. ".\nYour money resets. You KEEP your planets!"
	end
	UI.Button(c:WaitForChild("Do"), function() State.Request("Rebirth") end)
	State.On("Rebirths", refresh)
	State.On("Money", function() if UI.IsOpen("Rebirth") then refresh() end end)
	UI.OnOpen("Rebirth", refresh)
end

-- [ INDEX ] ----------------------------------------------------------------------
do
	local c = content("Index")
	local grid = c:WaitForChild("Grid") :: ScrollingFrame
	local template = grid:WaitForChild("Template") :: Frame
	local tabs = c:WaitForChild("Tabs")
	local current = "Common"
	local built: { Frame } = {}

	local function refresh()
		for _, f in ipairs(built) do f:Destroy() end
		table.clear(built)
		local index = State.Data.Index or {}
		local pool = Planets.ByRarity[current] or {}
		local found = 0
		for i, p in ipairs(pool) do
			local known = index[p.Id] == true
			if known then found += 1 end
			local card = template:Clone()
			card.Name = p.Id
			card.Visible = true
			card.LayoutOrder = i
			local design = card:FindFirstChild("Design") :: ImageLabel
			if known then UI.Tint(design, current, "ImageColor3") else design.ImageColor3 = Color3.fromRGB(90, 95, 110) end;
			(card:FindFirstChild("PlanetName") :: TextLabel).Text = known and p.Name or "???";
			(card:FindFirstChild("Income") :: TextLabel).Text = known and (Format.Money(p.Income) .. "/s") or "";
			(card:FindFirstChild("Unknown") :: TextLabel).Visible = not known
			local view = card:FindFirstChild("View") :: ViewportFrame
			if known then
				UI.Viewport(view, Models.Planet(p.Id, nil, 3), 0.5, 0.95)
			else
				-- silhouette noire
				local m = Models.Planet(p.Id, nil, 3)
				for _, d in ipairs(m:GetDescendants()) do
					if d:IsA("BasePart") then d.Color = Color3.new(0, 0, 0); d.Material = Enum.Material.SmoothPlastic end
					if d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("Fire") then d:Destroy() end
				end
				UI.Viewport(view, m, 0, 0.95)
			end
			-- pastilles des mutations trouvées
			local muts = card:FindFirstChild("Mutations")
			if muts then
				for _, dot in ipairs(muts:GetChildren()) do
					if dot:IsA("Frame") then
						dot.BackgroundTransparency = index[p.Id .. ":" .. dot.Name] and 0 or 0.85
					end
				end
			end
			card.Parent = grid
			table.insert(built, card)
		end;
		(c:FindFirstChild("Progress") :: TextLabel).Text = found .. "/" .. #pool .. " DISCOVERED"
		local claim = c:FindFirstChild("Claim") :: Frame
		local claimed = (State.Data.IndexClaimed or {})[current]
		local bonus = IndexRewards.Bonus[current] or 0
		UI.SetLabel(claim, claimed and "CLAIMED" or ("CLAIM +" .. Format.Percent(bonus)));
		(claim:FindFirstChild("Design") :: ImageLabel).ImageColor3 = (not claimed and found == #pool) and Color3.new(1, 1, 1) or Color3.fromRGB(140, 140, 140)
		for _, t in ipairs(tabs:GetChildren()) do
			if t:IsA("Frame") then
				local d = t:FindFirstChild("Design") :: ImageLabel
				UI.Tint(d, t.Name, "ImageColor3")
				d.ImageTransparency = t.Name == current and 0 or 0.35
			end
		end
	end
	for _, t in ipairs(tabs:GetChildren()) do
		if t:IsA("Frame") then
			UI.Button(t, function()
				current = t.Name
				refresh()
			end)
		end
	end
	UI.Button(c:WaitForChild("Claim"), function() State.Request("ClaimIndex", current) end)
	State.On("Index", function() if UI.IsOpen("Index") then refresh() end end)
	State.On("IndexClaimed", function() if UI.IsOpen("Index") then refresh() end end)
	UI.OnOpen("Index", refresh)
end

-- [ DAILY ] ----------------------------------------------------------------------
do
	local c = content("Daily")
	local days = c:WaitForChild("Days")
	local COOLDOWN = 20 * 3600
	local function rewardText(r: any): string
		if r.Type == "Money" then return r.Minutes .. " min of $" end
		if r.Type == "Galaxy" then
			local g = Galaxies.ById[r.Galaxy]
			return g and g.Name or r.Galaxy
		end
		if r.Type == "Boost" then return "x2 " .. string.upper(r.Boost) end
		return ""
	end
	for i, r in ipairs(DailyRewards.Days) do
		local f = days:FindFirstChild("Day" .. i)
		if f then
			(f:FindFirstChild("Reward") :: TextLabel).Text = rewardText(r)
			if r.Type == "Galaxy" then
				local g = Galaxies.ById[r.Galaxy]
				if g then UI.Tint(f:FindFirstChild("Design") :: ImageLabel, g.Rarity, "ImageColor3") end
			end
		end
	end
	local function claimable(): (boolean, number)
		local d = State.Data.Daily or { Day = 0, Last = 0 }
		if d.Last == 0 then return true, 0 end
		local left = COOLDOWN - (State.Now() - d.Last)
		return left <= 0, left
	end
	local function refresh()
		local d = State.Data.Daily or { Day = 0, Last = 0 }
		local now = State.Now()
		local broken = d.Last > 0 and now - d.Last > DailyRewards.ResetAfterHours * 3600
		local doneDays = broken and 0 or d.Day
		local ok = claimable()
		-- après le jour 7 le cycle recommence
		if ok and doneDays >= #DailyRewards.Days then doneDays = 0 end
		for i = 1, #DailyRewards.Days do
			local f = days:FindFirstChild("Day" .. i)
			if f then
				(f:FindFirstChild("Done") :: TextLabel).Visible = i <= doneDays
				local pop = f:FindFirstChild("Design") :: ImageLabel
				pop.ImageTransparency = (i == doneDays + 1 and ok) and 0 or 0.3
			end
		end
	end
	task.spawn(function()
		while true do
			if UI.IsOpen("Daily") then
				local ok, left = claimable();
				(c:FindFirstChild("Timer") :: TextLabel).Text = ok and "Your reward is ready!" or ("Next reward in " .. Format.Time(left))
				UI.SetLabel(c:FindFirstChild("Claim") :: Frame, ok and "CLAIM" or "WAIT")
			end
			task.wait(1)
		end
	end)
	UI.Button(c:WaitForChild("Claim"), function() State.Request("ClaimDaily") end)
	State.On("Daily", refresh)
	UI.OnOpen("Daily", refresh)
	State.OnEvent("DailyClaimed", function(p)
		UI.Notify("Day " .. p.Day .. " reward: " .. p.Text .. "!", "success")
		UI.Play("Buy")
	end)
end

-- [ CODES ] ----------------------------------------------------------------------
do
	local c = content("Codes")
	local input = c:WaitForChild("Box"):WaitForChild("Input") :: TextBox
	local result = c:WaitForChild("Result") :: TextLabel
	local busy = false
	UI.Button(c:WaitForChild("Redeem"), function()
		if busy or input.Text == "" then return end
		busy = true
		result.Text = "..."
		local res = State.Invoke("Redeem", input.Text)
		busy = false
		if res and res.ok then
			result.TextColor3 = Color3.fromRGB(120, 255, 90)
			result.Text = res.msg
			input.Text = ""
			UI.Play("Buy")
		else
			result.TextColor3 = Color3.fromRGB(255, 90, 90)
			result.Text = res and res.msg or "Error"
		end
	end)
end

-- [ SETTINGS ] -------------------------------------------------------------------
do
	local c = content("Settings")
	local function apply()
		local s = State.Data.Settings or {}
		for _, key in ipairs({ "Music", "Sfx", "LowGfx", "AutoHatch" }) do
			local row = c:FindFirstChild(key)
			if row then
				local on = s[key] ~= false
				if key == "LowGfx" then on = s[key] == true end
				local t = row:FindFirstChild("Toggle") :: Frame
				UI.SetLabel(t, on and "ON" or "OFF");
				(t:FindFirstChild("Design") :: ImageLabel).Image = on and "rbxassetid://118147684330981" or "rbxassetid://139238474736040"
			end
		end
		UI.SfxEnabled = s.Sfx ~= false
		local music = game:GetService("SoundService"):FindFirstChild("Music")
		if music and music:IsA("Sound") then music.Volume = s.Music == false and 0 or 0.35 end
		-- graphismes légers : coupe les effets de lumière
		local low = s.LowGfx == true
		for _, e in ipairs(Lighting:GetChildren()) do
			if e:IsA("BloomEffect") or e:IsA("ColorCorrectionEffect") then e.Enabled = not low end
		end
	end
	for _, key in ipairs({ "Music", "Sfx", "LowGfx", "AutoHatch" }) do
		local row = c:WaitForChild(key)
		UI.Button(row:WaitForChild("Toggle"), function()
			local s = State.Data.Settings or {}
			local cur = if key == "LowGfx" then s[key] == true else s[key] ~= false
			State.Request("Setting", key, not cur)
		end)
	end
	State.On("Settings", apply)
end

-- [ PANNEAUX OUVERTS PAR LES STANDS DU HUB / LE PANNEAU DE LA BASE ] -------------
ProximityPromptService.PromptTriggered:Connect(function(prompt)
	local opens = prompt:GetAttribute("Opens")
	if type(opens) ~= "string" then return end
	if opens == "Sell" then
		UI.Open("Planets")
	else
		UI.Open(opens)
	end
end)

local _ = Rarities
return {}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX44"><Properties><string name="Name">PlanetsController</string><ProtectedString name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Client/PlanetsController
-- Inventaire des planètes : grille (équipées en premier, puis les plus rentables),
-- détail de la planète choisie (Equip / Lock / Sell), EQUIP BEST et SELL ALL.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Util.Format)
local Formulas = require(Shared.Util.Formulas)
local Planets = require(Shared.Config.Planets)
local Rarities = require(Shared.Config.Rarities)
local Mutations = require(Shared.Config.Mutations)
local Upgrades = require(Shared.Config.Upgrades)
local Models = require(Shared.Visuals.Models)

local State = require(script.Parent.State)
local UI = require(script.Parent.UI)

local panel = UI.Panel("Planets")
local content = panel:WaitForChild("Body"):WaitForChild("Content")
local grid = content:WaitForChild("Grid") :: ScrollingFrame
local template = grid:WaitForChild("Template") :: Frame
local detail = content:WaitForChild("Detail") :: Frame
local slotsLabel = content:WaitForChild("Slots") :: TextLabel
local totalLabel = content:WaitForChild("Total") :: TextLabel
local empty = content:WaitForChild("Empty") :: TextLabel

local cards: { [string]: Frame } = {}
local selected: string? = nil
local sellArmed = false

local function rarityOf(id: string): string
	local p = Planets.ById[id]
	return p and p.Rarity or "Common"
end

local function mutationText(mut: string?): (string, Color3)
	local m = mut and Mutations.ById[mut]
	if not m then return "", Color3.new(1, 1, 1) end
	return string.upper(m.Name), m.Color
end

local function showDetail()
	local data = State.Data.Planets or {}
	local p = selected and data[selected]
	local view = detail:FindFirstChild("View") :: ViewportFrame
	if not p then
		(detail:FindFirstChild("PlanetName") :: TextLabel).Text = "Select a planet";
		(detail:FindFirstChild("Rarity") :: TextLabel).Text = "";
		(detail:FindFirstChild("Mutation") :: TextLabel).Text = "";
		(detail:FindFirstChild("Income") :: TextLabel).Text = ""
		UI.Viewport(view, nil)
		for _, n in ipairs({ "Equip", "Lock", "Sell" }) do (detail:FindFirstChild(n) :: Frame).Visible = false end
		return
	end
	local info = Planets.ById[p.Id]
	local rarity = rarityOf(p.Id);
	(detail:FindFirstChild("PlanetName") :: TextLabel).Text = info and info.Name or p.Id
	local rl = detail:FindFirstChild("Rarity") :: TextLabel
	rl.Text = string.upper(rarity)
	UI.Tint(rl, rarity, "TextColor3")
	local mt, mc = mutationText(p.Mut)
	local ml = detail:FindFirstChild("Mutation") :: TextLabel
	ml.Text = mt ~= "" and (mt .. " x" .. Mutations.ById[p.Mut].Multiplier) or ""
	ml.TextColor3 = mc
	local mult = Formulas.MoneyMultiplier(State.Build());
	(detail:FindFirstChild("Income") :: TextLabel).Text = "+" .. Format.Money(Formulas.PlanetIncome(p.Id, p.Mut) * mult) .. "/s"
	UI.Viewport(view, Models.Planet(p.Id, p.Mut, 3), 0.7, 0.95)
	local eq = detail:FindFirstChild("Equip") :: Frame
	local lock = detail:FindFirstChild("Lock") :: Frame
	local sell = detail:FindFirstChild("Sell") :: Frame
	eq.Visible = true; lock.Visible = true; sell.Visible = true
	UI.SetLabel(eq, p.Eq and "UNEQUIP" or "EQUIP")
	UI.SetLabel(lock, p.Lock and "UNLOCK" or "LOCK")
	sellArmed = false
	UI.SetLabel(sell, "SELL " .. Format.Money(Formulas.SellValue(p.Id, p.Mut)))
end

local function makeCard(uid: string, p: any): Frame
	local c = template:Clone()
	c.Name = uid
	c.Visible = true
	local rarity = rarityOf(p.Id)
	local design = c:FindFirstChild("Design") :: ImageLabel
	UI.Tint(design, rarity, "ImageColor3")
	local info = Planets.ById[p.Id];
	(c:FindFirstChild("PlanetName") :: TextLabel).Text = info and info.Name or p.Id
	local mt, mc = mutationText(p.Mut)
	local ml = c:FindFirstChild("Mutation") :: TextLabel
	ml.Text = mt
	ml.TextColor3 = mc
	UI.Viewport(c:FindFirstChild("View") :: ViewportFrame, Models.Planet(p.Id, p.Mut, 3), 0, 0.95)
	UI.Button(c, function()
		selected = uid
		showDetail()
	end)
	c.Parent = grid
	return c
end

local function refresh()
	local data = State.Data.Planets or {}
	local mult = Formulas.MoneyMultiplier(State.Build())
	local list = {}
	local equipped, total = 0, 0
	for uid, p in pairs(data) do
		local income = Formulas.PlanetIncome(p.Id, p.Mut)
		table.insert(list, { uid = uid, p = p, income = income })
		if p.Eq then
			equipped += 1
			total += income
		end
	end
	table.sort(list, function(a, b)
		if a.p.Eq ~= b.p.Eq then return a.p.Eq end
		if a.income ~= b.income then return a.income > b.income end
		return a.uid < b.uid
	end)
	local seen = {}
	for i, e in ipairs(list) do
		seen[e.uid] = true
		local c = cards[e.uid] or makeCard(e.uid, e.p)
		cards[e.uid] = c
		c.LayoutOrder = i;
		(c:FindFirstChild("Income") :: TextLabel).Text = Format.Money(e.income * mult) .. "/s";
		(c:FindFirstChild("Equipped") :: Frame).Visible = e.p.Eq == true;
		(c:FindFirstChild("Lock") :: TextLabel).Visible = e.p.Lock == true
	end
	for uid, c in pairs(cards) do
		if not seen[uid] then
			c:Destroy()
			cards[uid] = nil
		end
	end
	if selected and not data[selected] then selected = nil end
	local slots = Formulas.EquipSlots(State.Build())
	slotsLabel.Text = "EQUIPPED " .. equipped .. "/" .. slots .. "   (" .. #list .. "/" .. Upgrades.Base.InventoryMax .. ")"
	totalLabel.Text = "+" .. Format.Money(total * mult) .. "/s"
	empty.Visible = #list == 0
	showDetail()
end
State.On("Planets", refresh)
State.On("Rebirths", refresh)
State.On("Passes", refresh)

UI.Button(detail:WaitForChild("Equip"), function()
	local p = selected and (State.Data.Planets or {})[selected]
	if not p then return end
	State.Request(p.Eq and "Unequip" or "Equip", selected)
end)
UI.Button(detail:WaitForChild("Lock"), function()
	if selected then State.Request("Lock", selected) end
end)
UI.Button(detail:WaitForChild("Sell"), function()
	local p = selected and (State.Data.Planets or {})[selected]
	if not p then return end
	-- 2 clics pour vendre une planète rare (anti-erreur)
	local order = Rarities.Info[rarityOf(p.Id)].Order
	if (order >= 3 or p.Mut) and not sellArmed then
		sellArmed = true
		UI.SetLabel(detail.Sell, "SURE?")
		return
	end
	State.Request("Sell", selected)
end)
UI.Button(content:WaitForChild("EquipBest"), function()
	State.Request("EquipBest")
end)

-- SELL ALL : vend les planètes non équipées et non verrouillées jusqu'à "Rare" (2 clics)
local sellAllArmed = false
UI.Button(content:WaitForChild("SellAll"), function()
	if not sellAllArmed then
		sellAllArmed = true
		UI.SetLabel(content.SellAll, "SURE?")
		task.delay(3, function()
			sellAllArmed = false
			UI.SetLabel(content.SellAll, "SELL ALL")
		end)
		return
	end
	sellAllArmed = false
	UI.SetLabel(content.SellAll, "SELL ALL")
	State.Request("SellAll", 2)
end)

UI.OnOpen("Planets", function()
	refresh()
end)

return {}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX45"><Properties><string name="Name">ShopController</string><ProtectedString name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Client/ShopController
-- Shop Robux : onglets Featured / Passes / Boosts / Cash / Galaxies.
-- Les galaxies vendues contre des Robux ont un bouton ODDS qui affiche les chances
-- exactes de chaque planète AVANT l'achat (règle Roblox sur les objets aléatoires payants).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Util.Format)
local Formulas = require(Shared.Util.Formulas)
local Gamepasses = require(Shared.Config.Gamepasses)
local Products = require(Shared.Config.Products)
local Galaxies = require(Shared.Config.Galaxies)
local Planets = require(Shared.Config.Planets)
local Rarities = require(Shared.Config.Rarities)
local Models = require(Shared.Visuals.Models)

local State = require(script.Parent.State)
local UI = require(script.Parent.UI)

local player = Players.LocalPlayer
local panel = UI.Panel("Shop")
local content = panel:WaitForChild("Body"):WaitForChild("Content")
local list = content:WaitForChild("List") :: ScrollingFrame
local template = list:WaitForChild("Template") :: Frame
local tabs = content:WaitForChild("Tabs")

local ICON = {
	Robux = "rbxassetid://97272186997275",
	Crown = "rbxassetid://94666332436790",
	Gift = "rbxassetid://112101874744840",
	Rebirth = "rbxassetid://102040339566414",
	Book = "rbxassetid://102082573689395",
	Shop = "rbxassetid://110119422421461",
}

-- description de chaque article
type Item = { Kind: string, Key: string, Desc: string, Icon: string?, Galaxy: string?, Planet: string?, Color: Color3 }
local GOLD = Color3.fromRGB(255, 200, 60)
local BLUE = Color3.fromRGB(80, 180, 255)
local GREEN = Color3.fromRGB(90, 220, 90)
local PURPLE = Color3.fromRGB(170, 90, 255)
local PINK = Color3.fromRGB(255, 80, 140)

local ITEMS: { [string]: { Item } } = {
	Featured = {
		{ Kind = "Product", Key = "StarterPack", Desc = "$25K + Legendary galaxy + x2 money 30 min", Galaxy = "GoldenCrown", Color = GOLD },
		{ Kind = "Pass", Key = "DoubleMoney", Desc = "x2 money forever", Planet = "GoldenSaturn", Color = GREEN },
		{ Kind = "Pass", Key = "VIP", Desc = "+25% money, VIP tag", Icon = ICON.Crown, Color = GOLD },
		{ Kind = "Product", Key = "SecretGalaxy", Desc = "Hatches a SECRET planet!", Galaxy = "PrismCore", Color = PINK },
	},
	Passes = {
		{ Kind = "Pass", Key = "DoubleMoney", Desc = "x2 money forever", Planet = "GoldenSaturn", Color = GREEN },
		{ Kind = "Pass", Key = "DoubleLuck", Desc = "x2 luck forever", Planet = "LimeComet", Color = BLUE },
		{ Kind = "Pass", Key = "FastHatch", Desc = "Galaxies hatch 2x faster", Galaxy = "EmeraldSwirl", Color = BLUE },
		{ Kind = "Pass", Key = "ExtraSlots", Desc = "+2 equipped planets", Planet = "AmethystGiant", Color = PURPLE },
		{ Kind = "Pass", Key = "FourthSpawner", Desc = "A 4th galaxy spawner", Galaxy = "AmethystSpiral", Color = PURPLE },
		{ Kind = "Pass", Key = "AutoHatch", Desc = "Hatches ready galaxies for you", Icon = ICON.Book, Color = GREEN },
		{ Kind = "Pass", Key = "VIP", Desc = "+25% money, VIP tag", Icon = ICON.Crown, Color = GOLD },
	},
	Boosts = {
		{ Kind = "Product", Key = "BoostMoney15", Desc = "x2 money for 15 min", Planet = "SunForge", Color = GREEN },
		{ Kind = "Product", Key = "BoostLuck15", Desc = "x2 luck for 15 min", Planet = "MintRing", Color = BLUE },
		{ Kind = "Product", Key = "SkipAll", Desc = "Finish every timer now", Icon = ICON.Rebirth, Color = GOLD },
	},
	Cash = {
		{ Kind = "Product", Key = "CashSmall", Desc = "", Icon = ICON.Gift, Color = GREEN },
		{ Kind = "Product", Key = "CashMedium", Desc = "", Icon = ICON.Gift, Color = GREEN },
		{ Kind = "Product", Key = "CashLarge", Desc = "", Icon = ICON.Gift, Color = GOLD },
	},
	Galaxies = {
		{ Kind = "Product", Key = "MythicGalaxy", Desc = "Mythic planet (or better!)", Galaxy = "CrimsonEye", Color = PINK },
		{ Kind = "Product", Key = "SecretGalaxy", Desc = "Guaranteed SECRET planet", Galaxy = "PrismCore", Color = PINK },
	},
}

local current = "Featured"
local cardsByItem: { { frame: Frame, item: Item } } = {}

local function info(item: Item): any
	return if item.Kind == "Pass" then Gamepasses[item.Key] else Products[item.Key]
end

local function owned(item: Item): boolean
	if item.Kind == "Pass" then return player:GetAttribute("Pass_" .. item.Key) == true end
	if item.Key == "StarterPack" then return State.Data.StarterPack == true end
	return false
end

-- chances des planètes d'une galaxie, avec la Luck actuelle du joueur
local function showOdds(galaxyId: string)
	local odds = UI.Panel("Odds")
	local c = odds:WaitForChild("Body"):WaitForChild("Content")
	local oList = c:WaitForChild("List")
	local oTemplate = oList:WaitForChild("Template") :: Frame
	for _, ch in ipairs(oList:GetChildren()) do
		if ch:IsA("Frame") and ch ~= oTemplate then ch:Destroy() end
	end
	local g = Galaxies.ById[galaxyId];
	(c:WaitForChild("GalaxyName") :: TextLabel).Text = (g and g.Name or galaxyId) .. " (your luck)"
	local luck = Formulas.Luck(State.Build())
	for i, o in ipairs(Formulas.PlanetOdds(galaxyId, luck)) do
		local row = oTemplate:Clone()
		row.Name = o.id
		row.Visible = true
		row.LayoutOrder = i
		local p = Planets.ById[o.id]
		local name = row:FindFirstChild("PlanetName") :: TextLabel
		name.Text = p and p.Name or o.id
		UI.Tint(name, p and p.Rarity or "Common", "TextColor3");
		(row:FindFirstChild("Chance") :: TextLabel).Text = Format.Percent(o.chance)
		row.Parent = oList
	end
	odds.Visible = true
end

local function buy(item: Item)
	if owned(item) and item.Kind == "Pass" then
		UI.Notify("You already own this!", "success")
		return
	end
	local i = info(item)
	if not i or i.Id == 0 then
		UI.Notify("Coming soon!", "warn")
		return
	end
	if item.Kind == "Pass" then
		MarketplaceService:PromptGamePassPurchase(player, i.Id)
	else
		MarketplaceService:PromptProductPurchase(player, i.Id)
	end
end

local function describe(item: Item): string
	local i = info(item)
	if i and i.Minutes then
		local amount = math.max(i.Min or 0, (player:GetAttribute("Income") or 0) * i.Minutes * 60)
		return "+" .. Format.Money(amount) .. " (" .. (i.Minutes >= 60 and (i.Minutes // 60 .. "h") or (i.Minutes .. " min")) .. " of income)"
	end
	return item.Desc
end

local function refreshCards()
	for _, e in ipairs(cardsByItem) do
		local buyBtn = e.frame:FindFirstChild("Buy") :: Frame
		local i = info(e.item)
		if owned(e.item) and e.item.Kind == "Pass" then
			UI.SetLabel(buyBtn, "OWNED");
			(buyBtn:FindFirstChild("Robux") :: ImageLabel).Visible = false
		else
			UI.SetLabel(buyBtn, "   " .. tostring(i and i.Price or "?"));
			(buyBtn:FindFirstChild("Robux") :: ImageLabel).Visible = true
		end;
		(e.frame:FindFirstChild("Desc") :: TextLabel).Text = describe(e.item)
	end
end

local function show(tab: string)
	current = tab
	for _, e in ipairs(cardsByItem) do e.frame:Destroy() end
	table.clear(cardsByItem)
	for i, item in ipairs(ITEMS[tab] or {}) do
		local c = template:Clone()
		c.Name = item.Key
		c.Visible = true
		c.LayoutOrder = i
		local design = c:FindFirstChild("Design") :: ImageLabel
		design.ImageColor3 = item.Color
		local inf = info(item);
		(c:FindFirstChild("ItemName") :: TextLabel).Text = inf and inf.Name or item.Key
		local icon = c:FindFirstChild("Icon") :: ImageLabel
		local view = c:FindFirstChild("View") :: ViewportFrame
		if item.Galaxy then
			UI.Viewport(view, Models.Galaxy(item.Galaxy, 1), 0.9, 0.8)
			icon.Visible = false
		elseif item.Planet and Planets.ById[item.Planet] then
			UI.Viewport(view, Models.Planet(item.Planet, nil, 3), 0.7, 0.9)
			icon.Visible = false
		else
			icon.Image = item.Icon or ""
			view.Visible = false
		end
		UI.Button(c:FindFirstChild("Buy") :: Frame, function() buy(item) end)
		local oddsBtn = c:FindFirstChild("Odds") :: Frame
		if inf and inf.ShowOdds and item.Galaxy then
			oddsBtn.Visible = true
			local gid = item.Galaxy
			UI.Button(oddsBtn, function() showOdds(gid) end)
		end
		c.Parent = list
		table.insert(cardsByItem, { frame = c, item = item })
	end
	refreshCards()
	for _, t in ipairs(tabs:GetChildren()) do
		if t:IsA("Frame") then
			local pop = t:FindFirstChild("Pop") :: UIScale?
			if pop then pop.Scale = t.Name == tab and 1.06 or 1 end
			local d = t:FindFirstChild("Design") :: ImageLabel?
			if d then d.ImageTransparency = t.Name == tab and 0 or 0.25 end
		end
	end
end

for _, t in ipairs(tabs:GetChildren()) do
	if t:IsA("Frame") then
		UI.Button(t, function() show(t.Name) end)
	end
end

UI.OnOpen("Shop", function() show(current) end)
State.On("StarterPack", refreshCards)
State.On("Passes", refreshCards)

local _ = Rarities
return {}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX46"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Client/State
-- Copie locale des données du joueur, envoyées par le serveur (Remote "Sync").
-- Le client ne modifie JAMAIS ces données : il demande au serveur avec State.Request(...).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Gamepasses = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("Gamepasses"))

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local request = remotes:WaitForChild("Request") :: RemoteEvent
local invoke = remotes:WaitForChild("Invoke") :: RemoteFunction
local player = Players.LocalPlayer

local State = {}
State.Data = {} :: any
State.Loaded = false

local listeners: { [string]: { (any) -> () } } = {}
local eventListeners: { [string]: { (any) -> () } } = {}

-- appelle fn à chaque changement de la clé (et tout de suite si déjà chargée)
function State.On(key: string, fn: (any) -> ())
	listeners[key] = listeners[key] or {}
	table.insert(listeners[key], fn)
	if State.Loaded then task.spawn(fn, State.Data[key]) end
end

local function fire(key: string)
	for _, fn in ipairs(listeners[key] or {}) do
		task.spawn(fn, State.Data[key])
	end
end

-- événements envoyés par le serveur (éclosion, achat...)
function State.OnEvent(name: string, fn: (any) -> ())
	eventListeners[name] = eventListeners[name] or {}
	table.insert(eventListeners[name], fn)
end

function State.Request(action: string, ...: any)
	request:FireServer(action, ...)
end

function State.Invoke(action: string, ...: any): any
	local ok, res = pcall(invoke.InvokeServer, invoke, action, ...)
	return ok and res or nil
end

-- état "calculable" pour Formulas (mêmes calculs que le serveur)
function State.Build()
	local d = State.Data
	local passes = {}
	for name in pairs(Gamepasses) do
		passes[name] = player:GetAttribute("Pass_" .. name) == true
	end
	return {
		Rebirths = d.Rebirths or 0,
		Upgrades = d.Upgrades or {},
		Passes = passes,
		Boosts = d.Boosts or {},
		IndexClaimed = d.IndexClaimed or {},
		Now = workspace:GetServerTimeNow(),
	}
end

-- heure serveur (os.time côté serveur) pour les timers
function State.Now(): number
	return workspace:GetServerTimeNow()
end

remotes:WaitForChild("Sync").OnClientEvent:Connect(function(key: string, value: any)
	if key == "*" then
		State.Data = value
		State.Loaded = true
		for k in pairs(listeners) do fire(k) end
	else
		State.Data[key] = value
		fire(key)
	end
end)

remotes:WaitForChild("Event").OnClientEvent:Connect(function(name: string, payload: any)
	for _, fn in ipairs(eventListeners[name] or {}) do
		task.spawn(fn, payload)
	end
end)

-- les gamepasses changent les calculs : on prévient comme une donnée
player.AttributeChanged:Connect(function(attr)
	if string.sub(attr, 1, 5) == "Pass_" then fire("Passes") end
end)

return State
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX47"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Client/UI
-- Outils communs des interfaces : ouvrir / fermer les menus (un seul à la fois),
-- effets des boutons (comme le kit : grossit au survol, rétrécit au clic, sons),
-- notifications, et modèles 3D dans des ViewportFrame.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rarities = require(Shared.Config.Rarities)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local UI = {}
UI.HUD = playerGui:WaitForChild("HUD") :: ScreenGui
UI.Menus = playerGui:WaitForChild("Menus") :: ScreenGui
UI.Popups = playerGui:WaitForChild("Popups") :: ScreenGui
UI.SfxEnabled = true
UI.MenuScale = 1 -- agrandi sur téléphone (voir en bas)

-- [ SONS ] ---------------------------------------------------------------------
local SOUNDS = {
	Hover = "rbxassetid://408524543",
	Click = "rbxassetid://6042053626",
	Open = "rbxassetid://6042053626",
	-- sons du kit K4LSH ; à remplacer par des sons dédiés (Creator Store) plus tard
	Buy = "rbxassetid://6042053626",
	Error = "rbxassetid://408524543",
	Hatch = "rbxassetid://6042053626",
	Rare = "rbxassetid://6042053626",
}
local soundCache: { [string]: Sound } = {}
function UI.Play(name: string, volume: number?)
	if not UI.SfxEnabled then return end
	local id = SOUNDS[name]
	if not id then return end
	local s = soundCache[name]
	if not s then
		s = Instance.new("Sound")
		s.SoundId = id
		s.Parent = SoundService
		soundCache[name] = s
	end
	s.Volume = volume or 0.5
	SoundService:PlayLocalSound(s)
end

-- [ BOUTONS ] ------------------------------------------------------------------
local HOVER = TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local LEAVE = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local PRESS = TweenInfo.new(0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- branche un bouton du kit : frame avec enfant "Button" (ImageButton) et "Pop" (UIScale)
function UI.Button(frame: Instance, onClick: () -> ()): GuiButton?
	local btn = frame:FindFirstChild("Button") :: GuiButton?
	if not btn then return nil end
	local pop = frame:FindFirstChild("Pop") :: UIScale?
	if pop then
		btn.MouseEnter:Connect(function()
			TweenService:Create(pop, HOVER, { Scale = 1.05 }):Play()
			UI.Play("Hover", 0.3)
		end)
		btn.MouseLeave:Connect(function() TweenService:Create(pop, LEAVE, { Scale = 1 }):Play() end)
		btn.MouseButton1Down:Connect(function() TweenService:Create(pop, PRESS, { Scale = 0.95 }):Play() end)
		btn.MouseButton1Up:Connect(function() TweenService:Create(pop, HOVER, { Scale = 1 }):Play() end)
	end
	btn.Activated:Connect(function()
		UI.Play("Click", 0.6)
		onClick()
	end)
	return btn
end

-- texte d'un bouton barre
function UI.SetLabel(frame: Instance, text: string)
	local l = frame:FindFirstChild("Label") :: TextLabel?
	if l then l.Text = text end
end

-- [ MENUS ] --------------------------------------------------------------------
local openName: string? = nil
local openHooks: { [string]: { () -> () } } = {}
local closeHooks: { [string]: { () -> () } } = {}

function UI.Panel(name: string): Frame
	return UI.Menus:WaitForChild(name) :: Frame
end

function UI.OnOpen(name: string, fn: () -> ())
	openHooks[name] = openHooks[name] or {}
	table.insert(openHooks[name], fn)
end
function UI.OnClose(name: string, fn: () -> ())
	closeHooks[name] = closeHooks[name] or {}
	table.insert(closeHooks[name], fn)
end

function UI.IsOpen(name: string): boolean
	return openName == name
end

function UI.Close(name: string?)
	local n = name or openName
	if not n then return end
	local p = UI.Menus:FindFirstChild(n) :: Frame?
	if p and p.Visible then
		local sc = p:FindFirstChild("Open") :: UIScale?
		if sc then
			local tw = TweenService:Create(sc, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.7 * UI.MenuScale })
			tw:Play()
			tw.Completed:Wait()
		end
		p.Visible = false
		for _, fn in ipairs(closeHooks[n] or {}) do task.spawn(fn) end
	end
	if openName == n then openName = nil end
end

function UI.Open(name: string)
	if openName == name then return end
	if openName and name ~= "Odds" then UI.Close(openName) end
	local p = UI.Menus:FindFirstChild(name) :: Frame?
	if not p then return end
	if name ~= "Odds" then openName = name end
	local sc = p:FindFirstChild("Open") :: UIScale?
	if sc then sc.Scale = 0.6 * UI.MenuScale end
	p.Visible = true
	UI.Play("Open", 0.4)
	if sc then
		TweenService:Create(sc, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = UI.MenuScale }):Play()
	end
	for _, fn in ipairs(openHooks[name] or {}) do task.spawn(fn) end
end

function UI.Toggle(name: string)
	if openName == name then UI.Close(name) else UI.Open(name) end
end

-- croix de fermeture de tous les panneaux
for _, p in ipairs(UI.Menus:GetChildren()) do
	local close = p:FindFirstChild("Header") and p.Header:FindFirstChild("Close")
	if close then
		UI.Button(close, function()
			if p.Name == "Odds" then
				p.Visible = false
			else
				UI.Close(p.Name)
			end
		end)
	end
end

-- [ NOTIFICATIONS ] ------------------------------------------------------------
local notesFrame = UI.Popups:WaitForChild("Notifications")
local noteTemplate = notesFrame:WaitForChild("Template") :: TextLabel
local NOTE_COLORS = {
	info = Color3.fromRGB(255, 255, 255),
	success = Color3.fromRGB(120, 255, 90),
	money = Color3.fromRGB(120, 255, 90),
	warn = Color3.fromRGB(255, 220, 90),
	error = Color3.fromRGB(255, 90, 90),
	rare = Color3.fromRGB(255, 120, 220),
}
local noteOrder = 0
function UI.Notify(text: string, kind: string?)
	noteOrder += 1
	local n = noteTemplate:Clone()
	n.Name = "Note"
	n.Text = text
	n.TextColor3 = NOTE_COLORS[kind or "info"] or NOTE_COLORS.info
	n.LayoutOrder = noteOrder
	n.Visible = true
	n.TextTransparency = 1
	n.Parent = notesFrame
	local st = n:FindFirstChildWhichIsA("UIStroke")
	TweenService:Create(n, TweenInfo.new(0.2), { TextTransparency = 0 }):Play()
	if kind == "error" then UI.Play("Error", 0.4) end
	-- garde au plus 4 messages
	local all = {}
	for _, c in ipairs(notesFrame:GetChildren()) do
		if c.Name == "Note" then table.insert(all, c) end
	end
	if #all > 4 then all[1]:Destroy() end
	task.delay(3, function()
		if not n.Parent then return end
		TweenService:Create(n, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		if st then TweenService:Create(st, TweenInfo.new(0.4), { Transparency = 1 }):Play() end
		task.wait(0.45)
		n:Destroy()
	end)
end

-- [ VIEWPORTS ] ----------------------------------------------------------------
-- affiche un modèle dans un ViewportFrame, cadré automatiquement
local spinning: { [ViewportFrame]: { model: Model, cf: CFrame, speed: number } } = {}
function UI.Viewport(vf: ViewportFrame, model: Model?, spin: number?, distanceMul: number?)
	for _, c in ipairs(vf:GetChildren()) do
		if c:IsA("Model") or c:IsA("Camera") or c:IsA("WorldModel") then c:Destroy() end
	end
	spinning[vf] = nil
	if not model then return end
	model:PivotTo(CFrame.new())
	local _, size = model:GetBoundingBox()
	local radius = size.Magnitude / 2
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	local dist = radius / math.tan(math.rad(20)) * (distanceMul or 1.05)
	cam.CFrame = CFrame.lookAt(Vector3.new(0, radius * 0.25, dist), Vector3.zero)
	cam.Parent = vf
	vf.CurrentCamera = cam
	model.Parent = vf
	if spin and spin ~= 0 then
		spinning[vf] = { model = model, cf = CFrame.new(), speed = spin }
	end
end

RunService.RenderStepped:Connect(function(dt)
	for vf, s in pairs(spinning) do
		if not vf.Parent or not s.model.Parent then
			spinning[vf] = nil
		elseif vf.Visible and vf:FindFirstAncestorWhichIsA("LayerCollector") then
			s.cf *= CFrame.Angles(0, dt * s.speed, 0)
			s.model:PivotTo(s.cf)
		end
	end
end)

-- [ COULEURS ] -----------------------------------------------------------------
local rainbowObjects: { [GuiObject]: string } = {}
function UI.RarityColor(rarity: string): Color3
	local r = Rarities.Info[rarity]
	return r and r.Color or Color3.new(1, 1, 1)
end

-- colore un texte ou une image selon la rareté (Secret = arc-en-ciel animé)
function UI.Tint(obj: GuiObject, rarity: string, prop: string)
	local r = Rarities.Info[rarity]
	rainbowObjects[obj] = nil
	if r and r.Rainbow then
		rainbowObjects[obj] = prop
	else
		(obj :: any)[prop] = r and r.Color or Color3.new(1, 1, 1)
	end
end

RunService.Heartbeat:Connect(function()
	local hue = (os.clock() * 0.25) % 1
	for obj, prop in pairs(rainbowObjects) do
		if not obj.Parent then
			rainbowObjects[obj] = nil
		else
			(obj :: any)[prop] = Color3.fromHSV(hue, 0.65, 1)
		end
	end
end)

-- [ TÉLÉPHONE ] ----------------------------------------------------------------
-- agrandit l'interface sur les petits écrans pour des boutons faciles à toucher
local function applyScale()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local h = cam.ViewportSize.Y
	local s = if h < 450 then 1.25 elseif h < 650 then 1.12 else 1
	UI.MenuScale = math.min(s, 1.12)
	-- HUD : un UIScale par bloc (Top, Left, Bottom, Right)
	for _, f in ipairs(UI.HUD:GetChildren()) do
		if f:IsA("GuiObject") then
			local sc = f:FindFirstChild("MobileScale") :: UIScale?
			if not sc then
				sc = Instance.new("UIScale")
				sc.Name = "MobileScale"
				sc.Parent = f
			end;
			(sc :: UIScale).Scale = s
		end
	end
	-- menus : leur UIScale "Open" sert aussi d'échelle
	for _, p in ipairs(UI.Menus:GetChildren()) do
		local sc = p:FindFirstChild("Open") :: UIScale?
		if sc and p:IsA("GuiObject") and p.Visible then sc.Scale = UI.MenuScale end
	end
end
task.defer(function()
	applyScale()
	local cam = workspace.CurrentCamera
	if cam then cam:GetPropertyChangedSignal("ViewportSize"):Connect(applyScale) end
end)

return UI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX48"><Properties><string name="Name">WorldController</string><ProtectedString name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Client/WorldController
-- Tout ce qui bouge dans le monde, calculé chez le joueur (pas sur le serveur) :
--   * rotation des galaxies / planètes (tag "Spin"), couleurs arc-en-ciel
--   * comptes à rebours au-dessus des galaxies (enclos + spawners)
--   * boutons Buy / Hatch visibles seulement pour le propriétaire de la base
--   * spawners verrouillés ("LOCKED")
--   * planètes équipées en orbite autour du soleil de chaque base

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Util.Format)
local Models = require(Shared.Visuals.Models)

local State = require(script.Parent.State)

local player = Players.LocalPlayer
local plots = workspace:WaitForChild("Map"):WaitForChild("Plots")

-- [ ROTATION + ARC-EN-CIEL ] -----------------------------------------------------
type Spinner = { model: Model, base: CFrame, angle: number, speed: number, rainbow: { BasePart }? }
local spinners: { [Model]: Spinner } = {}

local function addSpinner(m: Instance)
	if not m:IsA("Model") or spinners[m] then return end
	local rainbow: { BasePart }? = nil
	if m:GetAttribute("Rainbow") then
		rainbow = {}
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") and (d.Name == "Ball" or d.Name == "Core" or d.Name == "Arm" or d.Name == "Ring" or d.Name == "Spot") then
				table.insert(rainbow :: { BasePart }, d)
			end
		end
	end
	spinners[m] = { model = m, base = m:GetPivot(), angle = 0, speed = m:GetAttribute("Spin") or 0.5, rainbow = rainbow }
end
CollectionService:GetInstanceAddedSignal("Spin"):Connect(addSpinner)
CollectionService:GetInstanceRemovedSignal("Spin"):Connect(function(m) spinners[m :: Model] = nil end)
for _, m in ipairs(CollectionService:GetTagged("Spin")) do addSpinner(m) end

-- [ ORBITES ] --------------------------------------------------------------------
type Orbit = { sun: BasePart, models: { Model }, key: string }
local orbits: { [Model]: Orbit } = {}
local orbitFolder = Instance.new("Folder")
orbitFolder.Name = "LocalOrbits"
orbitFolder.Parent = workspace

local function rebuildOrbit(plot: Model)
	local o = orbits[plot]
	if o then
		for _, m in ipairs(o.models) do m:Destroy() end
	end
	local sun = plot:FindFirstChild("Sun") :: BasePart?
	local list = plot:GetAttribute("Equipped")
	if not sun or type(list) ~= "string" or list == "" then
		orbits[plot] = nil
		return
	end
	local models = {}
	for entry in string.gmatch(list, "[^,]+") do
		local id, mut = string.match(entry, "^([^:]+):?(.*)$")
		if id then
			local m = Models.Planet(id, mut ~= "" and mut or nil, 3.2)
			CollectionService:RemoveTag(m, "Spin") -- l'orbite gère sa propre rotation
			m.Parent = orbitFolder
			table.insert(models, m)
		end
	end
	orbits[plot] = { sun = sun, models = models, key = list }
end

local function watchPlot(plot: Instance)
	if not plot:IsA("Model") then return end
	plot:GetAttributeChangedSignal("Equipped"):Connect(function() rebuildOrbit(plot) end)
	rebuildOrbit(plot)
end
for _, p in ipairs(plots:GetChildren()) do watchPlot(p) end
plots.ChildAdded:Connect(watchPlot)

-- [ BOUCLE D'ANIMATION ] ---------------------------------------------------------
local hue = 0
RunService.RenderStepped:Connect(function(dt)
	local cam = workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position or Vector3.zero
	hue = (hue + dt * 0.25) % 1
	local rainbowColor = Color3.fromHSV(hue, 0.7, 1)
	for m, s in pairs(spinners) do
		if not m.Parent then
			spinners[m] = nil
		elseif m:IsDescendantOf(workspace) then
			if (s.base.Position - camPos).Magnitude < 250 then
				s.angle += dt * s.speed
				m:PivotTo(s.base * CFrame.Angles(0, s.angle, 0))
				if s.rainbow then
					for _, p in ipairs(s.rainbow) do p.Color = rainbowColor end
				end
			end
		end
	end
	local t = os.clock()
	for plot, o in pairs(orbits) do
		local center = o.sun.Position
		if (center - camPos).Magnitude < 350 then
			local n = #o.models
			for i, m in ipairs(o.models) do
				-- chaque planète sur son anneau, de plus en plus loin et lente
				local ring = 9 + i * 3.2
				local speed = 0.55 / (1 + i * 0.12)
				local a = t * speed + i * (math.pi * 2 / math.max(n, 1))
				local pos = center + Vector3.new(math.cos(a) * ring, math.sin(a * 2 + i) * 1.2, math.sin(a) * ring)
				m:PivotTo(CFrame.new(pos) * CFrame.Angles(0, t * 0.8, 0))
				if m:GetAttribute("Rainbow") then
					for _, d in ipairs(m:GetChildren()) do
						if d:IsA("BasePart") and (d.Name == "Ball" or d.Name == "Ring" or d.Name == "Spot") then d.Color = rainbowColor end
					end
				end
			end
		end
	end
end)

-- [ TIMERS + BOUTONS PROPRIÉTAIRE + SPAWNERS VERROUILLÉS ] -----------------------
local lockBillboards: { [BasePart]: BillboardGui } = {}
local function lockLabel(pad: BasePart): BillboardGui
	local bb = lockBillboards[pad]
	if bb then return bb end
	bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromScale(8, 2)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
	bb.MaxDistance = 60
	bb.LightInfluence = 0
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(1, 1)
	l.Font = Enum.Font.GothamBlack
	l.TextScaled = true
	l.TextColor3 = Color3.fromRGB(255, 210, 80)
	l.TextStrokeTransparency = 0
	l.Text = pad.Name == "Pad4" and "LOCKED\n4th Spawner Pass" or "LOCKED\nUpgrade Spawners"
	l.Parent = bb
	bb.Adornee = pad
	bb.Parent = player:WaitForChild("PlayerGui")
	lockBillboards[pad] = bb
	return bb
end

task.spawn(function()
	while true do
		local now = State.Now()
		local myId = player.UserId
		for _, plot in ipairs(plots:GetChildren()) do
			local mine = plot:GetAttribute("OwnerId") == myId
			local dyn = plot:FindFirstChild("Dynamic")
			if dyn then
				for _, d in ipairs(dyn:GetDescendants()) do
					if d:IsA("ProximityPrompt") and d.Name ~= "HatchPrompt" then
						d.Enabled = mine
					elseif d:IsA("TextLabel") and d.Name == "Time" then
						local model = d:FindFirstAncestorWhichIsA("Model")
						if model then
							local ends = model:GetAttribute("EndsAt")
							local exp = model:GetAttribute("Expires")
							if ends then
								local left = ends - now
								d.Text = left <= 0 and "READY!" or Format.Time(left)
								d.TextColor3 = left <= 0 and Color3.fromRGB(120, 255, 90) or Color3.new(1, 1, 1)
								local prompt = model:FindFirstChild("HatchPrompt", true) :: ProximityPrompt?
								if prompt then prompt.Enabled = mine and left <= 0 end
							elseif exp then
								d.Text = "Leaves in " .. Format.Time(exp - now)
							end
						end
					end
				end
			end
			-- spawners verrouillés (seulement dans ma base)
			local pads = plot:FindFirstChild("Pads")
			if pads then
				for _, pad in ipairs(pads:GetChildren()) do
					if pad:IsA("BasePart") and pad.Name:match("^Pad%d$") then
						local locked = mine and pad:GetAttribute("Locked") == true
						if locked then
							lockLabel(pad).Enabled = true
						elseif lockBillboards[pad] then
							lockBillboards[pad].Enabled = false
						end
					end
				end
			end
		end
		task.wait(0.25)
	end
end)

return {}
]]></ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="RBX53"><Properties><string name="Name">Tools</string></Properties><Item class="ModuleScript" referent="RBX51"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[-- MapBuilder v2 : à exécuter dans Studio (mode Edit). Construit la map en BRIQUES avec studs.
-- Crée Workspace.Map : Hub (3 stands), chemin circulaire, 8 bases, déco, ciel.
-- Relançable : supprime l'ancienne Map avant.
-- Les noms utilisés par les scripts du jeu sont gardés : Plots/PlotN (Floor, Sign, Spawn,
-- Pads/PadN, Slots/SlotN, Sun, UpgradeBoard, Dynamic), Hub (stands avec prompts "Opens").

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Models = require(ReplicatedStorage.Shared.Visuals.Models)

local old = workspace:FindFirstChild("Map")
if old then old:Destroy() end
local map = Instance.new("Folder")
map.Name = "Map"
map.Parent = workspace

local C = Color3.fromRGB
local COL = {
	tileA = C(58, 46, 110),
	tileB = C(74, 58, 138),
	tileHub = C(86, 70, 160),
	path = C(104, 86, 180),
	pathB = C(84, 68, 150),
	curb = C(40, 32, 80),
	edge = C(0, 230, 255),
	rock = C(38, 30, 66),
	rock2 = C(52, 40, 88),
	violet = C(150, 80, 255),
	gold = C(255, 200, 60),
	white = C(240, 240, 250),
	wood = C(150, 95, 55),
	wood2 = C(120, 72, 40),
	bricks = { C(70, 58, 130), C(80, 66, 145), C(62, 50, 118), C(88, 74, 155) },
}
local rng = Random.new(42)

local PLASTIC = Enum.Material.Plastic
local NEON = Enum.Material.Neon

-- [ OUTILS ] -------------------------------------------------------------------

-- brique : Plastic + studs dessus. collide = true par défaut (sol, murs)
local function part(parent, name, size, cf, color, material, props)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	local mat = material or PLASTIC
	p.Material = mat
	p.Anchored = true
	if mat == PLASTIC then
		p.TopSurface = Enum.SurfaceType.Studs
		p.BottomSurface = Enum.SurfaceType.Inlet
	else
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
	end
	if props then for k, v in pairs(props) do p[k] = v end end
	p.Parent = parent
	return p
end

local function deco(parent, name, size, cf, color, material, props)
	local p = part(parent, name, size, cf, color, material, props)
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	return p
end

-- plaque posée à plat dont l'axe X est vertical (les scripts lisent Size.X comme la hauteur)
-- studs sur la face Right, qui pointe vers le haut après rotation
local function flatPad(parent, name, height, width, cf, color, material, props)
	local p = part(parent, name, Vector3.new(height, width, width), cf * CFrame.Angles(0, 0, math.rad(90)), color, material, props)
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if (material or PLASTIC) == PLASTIC then
		p.RightSurface = Enum.SurfaceType.Studs
		p.LeftSurface = Enum.SurfaceType.Inlet
	end
	return p
end

-- "cercle" en blocs SANS chevauchement (sinon les dessus clignotent / se rentrent dedans) :
-- bandes côte à côte de plus en plus courtes. w = largeur (X), d = profondeur (Z)
local function blockyDisc(parent, name, w, d, h, cf, color, material, props)
	local center = part(parent, name, Vector3.new(w, h, d * 0.42), cf, color, material, props)
	for _, sgn in ipairs({ -1, 1 }) do
		part(parent, name, Vector3.new(w * 0.82, h, d * 0.2), cf * CFrame.new(0, 0, sgn * d * 0.31), color, material, props)
		part(parent, name, Vector3.new(w * 0.5, h, d * 0.09), cf * CFrame.new(0, 0, sgn * d * 0.455), color, material, props)
	end
	return center
end

local function octo(parent, name, w, h, cf, color, material, props)
	return blockyDisc(parent, name, w, w, h, cf, color, material, props)
end

local function sign(parent, name, size, cf, text, color, face)
	local p = part(parent, name, size, cf, C(30, 24, 60), PLASTIC)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face or Enum.NormalId.Front
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.LightInfluence = 0
	local l = Instance.new("TextLabel")
	l.Name = "Label"
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBlack
	l.TextScaled = true
	l.Text = text
	l.TextColor3 = color or Color3.new(1, 1, 1)
	local st = Instance.new("UIStroke")
	st.Thickness = 4
	st.Parent = l
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.05, 0); pad.PaddingRight = UDim.new(0.05, 0)
	pad.PaddingTop = UDim.new(0.1, 0); pad.PaddingBottom = UDim.new(0.1, 0)
	pad.Parent = l
	l.Parent = sg
	sg.Parent = p
	-- cadre en briques autour du panneau
	local sx, sy = size.X, size.Y
	local t = 0.6
	deco(parent, name .. "Frame", Vector3.new(sx + t * 2, t, size.Z + 0.3), cf * CFrame.new(0, sy / 2 + t / 2, 0), COL.gold)
	deco(parent, name .. "Frame", Vector3.new(sx + t * 2, t, size.Z + 0.3), cf * CFrame.new(0, -sy / 2 - t / 2, 0), COL.gold)
	deco(parent, name .. "Frame", Vector3.new(t, sy, size.Z + 0.3), cf * CFrame.new(sx / 2 + t / 2, 0, 0), COL.gold)
	deco(parent, name .. "Frame", Vector3.new(t, sy, size.Z + 0.3), cf * CFrame.new(-sx / 2 - t / 2, 0, 0), COL.gold)
	return p
end

local function prompt(parent, action, object, opens)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = 0
	pp.MaxActivationDistance = 14
	pp.RequiresLineOfSight = false
	pp:SetAttribute("Opens", opens)
	pp.Parent = parent
	return pp
end

-- mur de briques décalées. cf = centre du pied du mur, axe X = longueur
local function brickWall(parent, cf, length, rows, thick)
	local BL, BH = 4, 1.5
	for r = 0, rows - 1 do
		local x = -length / 2 - ((r % 2 == 1) and BL / 2 or 0)
		while x < length / 2 do
			local x0 = math.max(x, -length / 2)
			local x1 = math.min(x + BL, length / 2)
			if x1 - x0 > 0.2 then
				part(parent, "Brick", Vector3.new(x1 - x0 - 0.08, BH, thick), cf * CFrame.new((x0 + x1) / 2, BH / 2 + r * BH, 0),
					COL.bricks[rng:NextInteger(1, #COL.bricks)])
			end
			x += BL
		end
	end
	-- chapeau néon
	deco(parent, "WallCap", Vector3.new(length, 0.3, thick + 0.3), cf * CFrame.new(0, rows * BH + 0.15, 0), COL.edge, NEON)
end

-- lampadaire en blocs
local function lamp(parent, cf, color)
	part(parent, "LampBase", Vector3.new(1.6, 0.6, 1.6), cf * CFrame.new(0, 0.3, 0), COL.curb)
	part(parent, "LampPost", Vector3.new(0.6, 6, 0.6), cf * CFrame.new(0, 3.6, 0), COL.curb)
	deco(parent, "LampArm", Vector3.new(0.4, 0.4, 1.6), cf * CFrame.new(0, 6.5, 0.6), COL.curb)
	local head = deco(parent, "LampHead", Vector3.new(1.3, 1.3, 1.3), cf * CFrame.new(0, 7.2, 0), color or COL.edge, NEON)
	local l = Instance.new("PointLight"); l.Color = color or COL.edge; l.Range = 14; l.Brightness = 1.2; l.Parent = head
end

-- plante extraterrestre en blocs
local function plant(parent, cf, color)
	local h = rng:NextInteger(3, 5)
	part(parent, "Pot", Vector3.new(2.4, 1.4, 2.4), cf * CFrame.new(0, 0.7, 0), COL.wood2)
	for i = 1, h do
		deco(parent, "Stem", Vector3.new(0.5, 1, 0.5), cf * CFrame.new(0, 1.4 + i - 0.5, 0), C(40, 140, 90))
	end
	for i = 1, 4 do
		local a = i / 4 * math.pi * 2 + rng:NextNumber()
		deco(parent, "Leaf", Vector3.new(1.6, 0.35, 0.8), cf * CFrame.new(0, 1.4 + h * 0.6 + i * 0.4, 0) * CFrame.Angles(0, a, math.rad(20)) * CFrame.new(0.8, 0, 0), C(60, 200, 110))
	end
	deco(parent, "Bulb", Vector3.new(1, 1, 1), cf * CFrame.new(0, 1.9 + h, 0) * CFrame.Angles(0, math.rad(45), math.rad(45)), color or C(255, 120, 220), NEON)
end

-- amas de cristaux
local function crystals(parent, cf, color)
	for i = 1, 4 do
		local h = rng:NextNumber(1.5, 4)
		deco(parent, "Crystal", Vector3.new(0.8, h, 0.8), cf * CFrame.new(rng:NextNumber(-1, 1), h / 2, rng:NextNumber(-1, 1)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber() * 3, rng:NextNumber(-0.3, 0.3)),
			color or COL.violet, NEON, { Transparency = 0.1 })
	end
	part(parent, "CrystalRock", Vector3.new(2.6, 0.8, 2.6), cf * CFrame.new(0, 0.4, 0), COL.rock2)
end

-- dessous d'île flottante : étages de roche qui rétrécissent + cristaux qui pendent
local function islandUnder(parent, cf, w, d, depth)
	local steps = 4
	for k = 1, steps do
		local f = 1 - k * 0.18
		local h = depth / steps
		local lcf = cf * CFrame.new(0, -(k - 0.5) * h, 0)
		local col = k % 2 == 0 and COL.rock or COL.rock2
		-- arrondi en bandes de blocs (sans chevauchement), ne dépasse pas du dessus
		blockyDisc(parent, "Under", w * f, d * f, h, lcf, col, Enum.Material.Slate)
	end
	for i = 1, 5 do
		local x = rng:NextNumber(-w * 0.3, w * 0.3)
		local z = rng:NextNumber(-d * 0.3, d * 0.3)
		local h = rng:NextNumber(3, 7)
		deco(parent, "HangCrystal", Vector3.new(1, h, 1), cf * CFrame.new(x, -depth * 0.7 - h / 2, z) * CFrame.Angles(0, math.rad(45), 0), i % 2 == 0 and COL.edge or COL.violet, NEON)
	end
end

-- [ HUB ] ----------------------------------------------------------------------
local hub = Instance.new("Model")
hub.Name = "Hub"
hub.Parent = map

local HUB_R = 46
local RIM_IN = HUB_R - 3 -- bord intérieur du rebord : aucune dalle ne dépasse ce rayon
local T = 8
-- vrai si le carré (centre x,z, côté t) est entièrement dans le cercle de rayon r
local function inside(x, z, t, r)
	local h = t / 2
	for _, c in ipairs({ { x - h, z - h }, { x + h, z - h }, { x - h, z + h }, { x + h, z + h } }) do
		if c[1] * c[1] + c[2] * c[2] > r * r then return false end
	end
	return true
end
-- dalles 8x8 en damier ; au bord, on découpe en dalles 4x4 pour mieux remplir le cercle
for gx = -6, 5 do
	for gz = -6, 5 do
		local x, z = (gx + 0.5) * T, (gz + 0.5) * T
		local col = (gx + gz) % 2 == 0 and COL.tileHub or COL.tileB
		if inside(x, z, T, RIM_IN) then
			part(hub, "Floor", Vector3.new(T - 0.1, 2, T - 0.1), CFrame.new(x, -1, z), col)
		else
			for _, o in ipairs({ { -2, -2 }, { 2, -2 }, { -2, 2 }, { 2, 2 } }) do
				local sx, sz = x + o[1], z + o[2]
				if inside(sx, sz, T / 2, RIM_IN) then
					part(hub, "Floor", Vector3.new(T / 2 - 0.1, 2, T / 2 - 0.1), CFrame.new(sx, -1, sz), col)
				end
			end
		end
	end
end
-- joint sous les dalles (un peu plus bas : visible seulement dans les fentes, ne clignote pas)
blockyDisc(hub, "Grout", RIM_IN * 2 + 2, RIM_IN * 2 + 2, 1.8, CFrame.new(0, -1.05, 0), COL.tileA)
-- bord du hub : rebord surélevé en briques (longueur = corde au rayon intérieur → aucun chevauchement) + bande néon
local RIM_N = 60
for i = 1, RIM_N do
	local a = i / RIM_N * math.pi * 2
	local rot = CFrame.Angles(0, -a + math.pi / 2, 0)
	local len = 2 * RIM_IN * math.sin(math.pi / RIM_N) - 0.05
	part(hub, "Rim", Vector3.new(len, 2.4, 4), CFrame.new(math.cos(a) * (RIM_IN + 2), -0.8, math.sin(a) * (RIM_IN + 2)) * rot, i % 2 == 0 and COL.tileA or COL.tileB)
	local llen = 2 * (RIM_IN + 4) * math.sin(math.pi / RIM_N) - 0.02
	deco(hub, "RimLight", Vector3.new(llen, 0.4, 0.4), CFrame.new(math.cos(a) * (RIM_IN + 4.2), 0.2, math.sin(a) * (RIM_IN + 4.2)) * rot, COL.edge, NEON)
end
islandUnder(hub, CFrame.new(0, -2, 0), 88, 88, 18)

-- piédestal central en marches
octo(hub, "Step1", 26, 1, CFrame.new(0, 0.5, 0), COL.tileA)
octo(hub, "Step2", 19, 1, CFrame.new(0, 1.5, 0), COL.tileB)
octo(hub, "Step3", 12, 1, CFrame.new(0, 2.5, 0), COL.violet)
for i = 1, 8 do
	local a = i / 8 * math.pi * 2
	deco(hub, "StepLight", Vector3.new(1, 1, 1), CFrame.new(math.cos(a) * 12.5, 1.2, math.sin(a) * 12.5) * CFrame.Angles(0, a, 0), COL.edge, NEON)
end
local spawnLoc = Instance.new("SpawnLocation")
spawnLoc.Name = "HubSpawn"
spawnLoc.Size = Vector3.new(10, 1, 10)
spawnLoc.CFrame = CFrame.new(0, 3.5, 0)
spawnLoc.Anchored = true
spawnLoc.Transparency = 1
spawnLoc.CanCollide = false
spawnLoc.Neutral = true
spawnLoc.Duration = 0
spawnLoc.Parent = hub

-- grosse planète en briques au centre (même modèle que dans le jeu, en géant)
local statue = Models.Planet("GoldenSaturn", nil, 14)
statue.Name = "BigPlanet"
statue:PivotTo(CFrame.new(0, 19, 0))
statue:SetAttribute("Spin", 0.2)
statue.Parent = hub
-- colonne lumineuse qui la "porte"
deco(hub, "Beam", Vector3.new(1.5, 9, 1.5), CFrame.new(0, 7.5, 0), COL.edge, NEON, { Transparency = 0.4 })

-- 3 stands en forme de petit marché
local stands = {
	{ name = "Shop", color = C(40, 170, 255), opens = "Shop", angle = 90 },
	{ name = "Sell", color = C(255, 70, 70), opens = "Sell", angle = 210 },
	{ name = "Upgrade", color = C(70, 220, 90), opens = "Upgrades", angle = 330 },
}
for _, s in ipairs(stands) do
	local a = math.rad(s.angle)
	local pos = Vector3.new(math.cos(a) * 30, 0, math.sin(a) * 30)
	local cf = CFrame.lookAt(pos, Vector3.new(0, 0, 0)) -- face vers le centre
	local m = Instance.new("Model")
	m.Name = s.name .. "Stand"
	m.Parent = hub
	part(m, "Base", Vector3.new(18, 1, 12), cf * CFrame.new(0, 0.5, 0.5), COL.curb)
	-- comptoir en briques (2 rangées) + plateau blanc
	for row = 0, 1 do
		for i = -3, 3 do
			local off = (row % 2 == 1) and 1 or 0
			if i + off <= 3 then
				part(m, "CounterBrick", Vector3.new(1.95, 1.5, 3), cf * CFrame.new(i * 2 + off, 1.75 + row * 1.5, -2.5), row == 0 and s.color or s.color:Lerp(Color3.new(1, 1, 1), 0.2))
			end
		end
	end
	local counter = part(m, "Counter", Vector3.new(15, 0.8, 4), cf * CFrame.new(0, 4.4, -2.5), COL.white)
	-- piliers en bois + lanternes
	for _, x in ipairs({ -7.5, 7.5 }) do
		for _, z in ipairs({ -4, 4.5 }) do
			part(m, "Pillar", Vector3.new(1, 10, 1), cf * CFrame.new(x, 6, z), COL.wood)
		end
		local lan = deco(m, "Lantern", Vector3.new(1.2, 1.4, 1.2), cf * CFrame.new(x, 8, -4.8), C(255, 220, 120), NEON)
		local l = Instance.new("PointLight"); l.Color = C(255, 210, 140); l.Range = 12; l.Brightness = 1; l.Parent = lan
	end
	-- auvent rayé (bandes couleur / blanc) en pente
	for i = 0, 8 do
		part(m, "Awning", Vector3.new(2, 0.6, 12), cf * CFrame.new(-8 + i * 2, 11.6, 0.2) * CFrame.Angles(math.rad(-10), 0, 0), i % 2 == 0 and s.color or COL.white)
	end
	deco(m, "AwningEdge", Vector3.new(18.2, 0.4, 0.4), cf * CFrame.new(0, 10.6, -6), COL.edge, NEON)
	sign(m, "Sign", Vector3.new(14, 4, 0.6), cf * CFrame.new(0, 15, 1), string.upper(s.name), Color3.new(1, 1, 1), Enum.NormalId.Front)
	-- caisses
	part(m, "Crate", Vector3.new(2.4, 2.4, 2.4), cf * CFrame.new(10.5, 2.2, -1), COL.wood)
	part(m, "Crate", Vector3.new(1.8, 1.8, 1.8), cf * CFrame.new(10.2, 4.3, -1) * CFrame.Angles(0, 0.4, 0), COL.wood2)
	part(m, "Crate", Vector3.new(2.2, 2.2, 2.2), cf * CFrame.new(-10.5, 2.1, 0), COL.wood2)
	prompt(counter, "Open", s.name, s.opens)
	m.PrimaryPart = counter
end

-- lampadaires autour du piédestal
for i = 1, 6 do
	local a = i / 6 * math.pi * 2 + 0.5
	lamp(hub, CFrame.new(math.cos(a) * 40, 0, math.sin(a) * 40), i % 2 == 0 and COL.violet or COL.edge)
end

-- [ CHEMIN ] -------------------------------------------------------------------
local path = Instance.new("Model")
path.Name = "Path"
path.Parent = map
local SEG = 64
local PATH_R = 54 -- dalles de 47.1 à 60.9 : commence juste après le rebord du hub (47)
local PATH_OUT = PATH_R + 6.9
-- angle des 8 ponts (pas de bordure ni de lampadaire devant un pont)
local function nearBridge(a)
	for k = 1, 8 do
		local b = math.rad((k - 1) * 45 + 22.5)
		local diff = math.abs((a - b + math.pi) % (math.pi * 2) - math.pi)
		if diff < math.rad(8.5) then return true end
	end
	return false
end
local chord = function(r) return 2 * r * math.sin(math.pi / SEG) end
for i = 1, SEG do
	local a = (i / SEG) * math.pi * 2
	local rot = CFrame.Angles(0, -a + math.pi / 2, 0)
	local function at(r, y) return CFrame.new(math.cos(a) * r, y, math.sin(a) * r) * rot end
	-- 2 rangées de dalles décalées d'une demi-dalle. Longueur = corde au bord INTÉRIEUR
	-- de la rangée → les dalles se touchent sans jamais se chevaucher (petit joint côté extérieur)
	local ai = a + (math.pi / SEG)
	local roti = CFrame.Angles(0, -ai + math.pi / 2, 0)
	part(path, "Seg", Vector3.new(chord(PATH_R - 6.9) - 0.08, 1, 6.8), at(PATH_R - 3.5, -0.5), i % 2 == 0 and COL.path or COL.pathB)
	part(path, "Seg", Vector3.new(chord(PATH_R + 0.1) - 0.08, 1, 6.8), CFrame.new(math.cos(ai) * (PATH_R + 3.5), -0.5, math.sin(ai) * (PATH_R + 3.5)) * roti, i % 2 == 1 and COL.path or COL.pathB)
	-- dessous en roche, un sur deux légèrement plus bas (pas de clignotement dans les joints)
	part(path, "Under", Vector3.new(chord(PATH_OUT), 4, 14), at(PATH_R, i % 2 == 0 and -3 or -3.06), COL.rock, Enum.Material.Slate)
	if not nearBridge(a) then
		part(path, "Curb", Vector3.new(chord(PATH_OUT) - 0.05, 1.2, 1), at(PATH_OUT + 0.5, -0.4), COL.curb)
		deco(path, "Light", Vector3.new(chord(PATH_OUT + 1), 0.3, 0.4), at(PATH_OUT + 1.2, -0.1), COL.edge, NEON)
		if i % 8 == 0 then
			lamp(path, at(PATH_OUT + 0.5, 0.2), i % 16 == 0 and COL.violet or COL.edge)
		end
	end
end

-- [ BASES ] --------------------------------------------------------------------
local plots = Instance.new("Folder")
plots.Name = "Plots"
plots.Parent = map

local PLOT_R = 128 -- distance du centre
local W, D = 70, 60 -- largeur (gauche-droite), profondeur

for k = 1, 8 do
	local a = math.rad((k - 1) * 45 + 22.5)
	local center = Vector3.new(math.cos(a) * PLOT_R, 0, math.sin(a) * PLOT_R)
	-- repère local : -Z = vers le hub (entrée)
	local cf = CFrame.lookAt(center, Vector3.new(0, 0, 0))
	local plot = Instance.new("Model")
	plot.Name = "Plot" .. k
	plot:SetAttribute("Index", k)
	plot.Parent = plots

	-- sol en dalles 10x10 (damier) + dalle invisible "Floor" pour le pivot
	local floor = part(plot, "Floor", Vector3.new(W, 2, D), cf * CFrame.new(0, -1.05, 0), COL.tileA, PLASTIC, { Transparency = 1, CanCollide = false, CanQuery = false })
	plot.PrimaryPart = floor
	for gx = 0, 6 do
		for gz = 0, 5 do
			local x = -W / 2 + 5 + gx * 10
			local z = -D / 2 + 5 + gz * 10
			part(plot, "Tile", Vector3.new(9.9, 2, 9.9), cf * CFrame.new(x, -1, z), (gx + gz) % 2 == 0 and COL.tileA or COL.tileB)
		end
	end
	islandUnder(plot, cf * CFrame.new(0, -2, 0), W - 4, D - 4, 16)

	-- murs en briques (côtés + fond + devant avec ouverture)
	brickWall(plot, cf * CFrame.new(0, 0, D / 2 - 0.75), W, 2, 1.5)
	brickWall(plot, cf * CFrame.new(W / 2 - 0.75, 0, 0) * CFrame.Angles(0, math.rad(90), 0), D - 3, 2, 1.5)
	brickWall(plot, cf * CFrame.new(-W / 2 + 0.75, 0, 0) * CFrame.Angles(0, math.rad(90), 0), D - 3, 2, 1.5)
	-- murs de devant : de l'arche (x = 10.2) jusqu'au coin, sans rentrer dans l'arche
	local fw = W / 2 - 10.2
	brickWall(plot, cf * CFrame.new(10.2 + fw / 2, 0, -D / 2 + 0.75), fw, 2, 1.5)
	brickWall(plot, cf * CFrame.new(-10.2 - fw / 2, 0, -D / 2 + 0.75), fw, 2, 1.5)
	-- piliers d'angle avec cube néon
	for _, x in ipairs({ -W / 2 + 1, W / 2 - 1 }) do
		for _, z in ipairs({ -D / 2 + 1, D / 2 - 1 }) do
			part(plot, "Corner", Vector3.new(3, 5, 3), cf * CFrame.new(x, 2.5, z), COL.rock2)
			deco(plot, "CornerLight", Vector3.new(1.6, 1.6, 1.6), cf * CFrame.new(x, 5.8, z) * CFrame.Angles(0, math.rad(45), 0), COL.edge, NEON)
		end
	end

	-- pont vers le chemin (dalles + bordures)
	-- le pont va du bord de la base jusqu'au bord EXTÉRIEUR du chemin, sans le chevaucher
	local bridgeLen = PLOT_R - D / 2 - PATH_OUT
	local bz = -D / 2 - bridgeLen / 2
	local nb = math.max(1, math.floor(bridgeLen / 4))
	for i = 1, nb do
		local z0 = -D / 2 - (i - 0.5) * bridgeLen / nb
		part(plot, "Bridge", Vector3.new(14, 1, bridgeLen / nb - 0.1), cf * CFrame.new(0, -0.5, z0), i % 2 == 0 and COL.path or COL.pathB)
	end
	part(plot, "BridgeRail", Vector3.new(1, 1.6, bridgeLen), cf * CFrame.new(7.5, 0, bz), COL.curb)
	part(plot, "BridgeRail", Vector3.new(1, 1.6, bridgeLen), cf * CFrame.new(-7.5, 0, bz), COL.curb)
	deco(plot, "BridgeLight", Vector3.new(0.4, 0.3, bridgeLen), cf * CFrame.new(7.5, 0.9, bz), COL.edge, NEON)
	deco(plot, "BridgeLight", Vector3.new(0.4, 0.3, bridgeLen), cf * CFrame.new(-7.5, 0.9, bz), COL.edge, NEON)

	-- arche d'entrée en briques + panneau avec le nom
	for _, x in ipairs({ -9, 9 }) do
		for r = 0, 7 do
			part(plot, "ArchBrick", Vector3.new(2.4, 1.5, 2.4), cf * CFrame.new(x, 0.75 + r * 1.5, -D / 2), r % 2 == 0 and COL.violet or C(120, 60, 220))
		end
		deco(plot, "ArchLight", Vector3.new(1.6, 1.6, 1.6), cf * CFrame.new(x, 13, -D / 2) * CFrame.Angles(0, math.rad(45), 0), COL.gold, NEON)
	end
	part(plot, "ArchTop", Vector3.new(21, 1.5, 2.4), cf * CFrame.new(0, 12.75, -D / 2), COL.violet)
	sign(plot, "Sign", Vector3.new(18, 4, 1), cf * CFrame.new(0, 16.2, -D / 2), "Empty Base", Color3.new(1, 1, 1), Enum.NormalId.Front)

	local spawn = part(plot, "Spawn", Vector3.new(4, 1, 4), cf * CFrame.new(0, 0.5, -D / 2 + 6) * CFrame.Angles(0, math.pi, 0), COL.tileA, nil, { Transparency = 1, CanCollide = false, CanQuery = false })
	spawn.Name = "Spawn"

	-- spawners à gauche (+X) : socle en marches + plaque à studs + coins néon
	local pads = Instance.new("Folder")
	pads.Name = "Pads"
	pads.Parent = plot
	for i = 1, 4 do
		local z = -16 + (i - 1) * 11
		local pcf = cf * CFrame.new(20, 0, z)
		part(plot, "PadBase", Vector3.new(10, 0.5, 10), pcf * CFrame.new(0, 0.25, 0), COL.curb)
		local pad = flatPad(pads, "Pad" .. i, 1, 8, pcf * CFrame.new(0, 1, 0), i == 4 and C(120, 90, 30) or COL.tileB)
		pad:SetAttribute("Index", i)
		for _, cx in ipairs({ -4.4, 4.4 }) do
			for _, cz in ipairs({ -4.4, 4.4 }) do
				deco(plot, "PadLight", Vector3.new(1, 1, 1), pcf * CFrame.new(cx, 1.15, cz), i == 4 and COL.gold or COL.edge, NEON)
			end
		end
		-- numéro du spawner
		deco(plot, "PadMark", Vector3.new(0.6, 0.2, 3), pcf * CFrame.new(-4.6, 0.6, 0), i == 4 and COL.gold or COL.edge, NEON)
	end
	-- panneau d'upgrades à côté des spawners (pieds en briques)
	local board = sign(plot, "UpgradeBoard", Vector3.new(12, 7, 0.8), cf * CFrame.new(30, 5.5, 6) * CFrame.Angles(0, math.rad(90), 0), "UPGRADES", C(120, 255, 120), Enum.NormalId.Front)
	for _, dz in ipairs({ -4.5, 4.5 }) do
		part(plot, "BoardLeg", Vector3.new(1, 1.3, 1), cf * CFrame.new(30, 0.65, 6 + dz), COL.wood)
	end
	prompt(board, "Open", "Upgrades", "Upgrades")

	-- incubateur à droite (-X) : socle octogonal à marches + dôme en arceaux de briques
	local icf = cf * CFrame.new(-16, 0, 2)
	octo(plot, "IncubatorBase", 30, 0.8, icf * CFrame.new(0, 0.4, 0), COL.tileB)
	octo(plot, "IncubatorBase2", 26, 0.6, icf * CFrame.new(0, 1.1, 0), COL.tileA)
	for i = 1, 16 do
		local aa = i / 16 * math.pi * 2
		deco(plot, "IncubatorRim", Vector3.new(5.6, 0.4, 0.5), icf * CFrame.Angles(0, aa, 0) * CFrame.new(0, 0.9, 14.6), COL.violet, NEON)
	end
	-- arceaux (6 demi-cercles de blocs)
	local DR = 14.5
	for rib = 0, 5 do
		local ra = rib / 6 * math.pi
		for j = 1, 11 do
			local t = (j - 0.5) / 11 * math.pi
			local pos = Vector3.new(math.cos(t) * DR, math.sin(t) * DR * 0.9, 0)
			deco(plot, "DomeRib", Vector3.new(1.2, 4.2, 0.8), icf * CFrame.Angles(0, ra, 0) * CFrame.new(pos) * CFrame.Angles(0, 0, t - math.pi / 2),
				j % 2 == 0 and C(150, 200, 255) or C(200, 230, 255), Enum.Material.Glass, { Transparency = 0.45 })
		end
	end
	deco(plot, "DomeTop", Vector3.new(3, 1, 3), icf * CFrame.new(0, DR * 0.9 + 0.4, 0) * CFrame.Angles(0, math.rad(45), 0), COL.edge, NEON)
	part(plot, "Dome", Vector3.new(29, 26, 29), icf * CFrame.new(0, 0, 0), C(150, 200, 255), Enum.Material.Glass,
		{ Shape = Enum.PartType.Ball, Transparency = 0.9, CanCollide = false, CanQuery = false, CastShadow = false })
	local slots = Instance.new("Folder")
	slots.Name = "Slots"
	slots.Parent = plot
	local n = 0
	for row = 0, 1 do
		for col = 0, 2 do
			n += 1
			local scf = cf * CFrame.new(-10 - row * 12, 1.4, -8 + col * 10)
			part(plot, "SlotStand", Vector3.new(6, 0.6, 6), scf * CFrame.new(0, -0.1, 0), COL.curb)
			local s = flatPad(slots, "Slot" .. n, 0.6, 5, scf * CFrame.new(0, 0.5, 0), COL.violet, NEON, { Transparency = 0.25, CanCollide = false })
			s:SetAttribute("Index", n)
		end
	end
	sign(plot, "IncubatorSign", Vector3.new(14, 3, 0.6), cf * CFrame.new(-16, 4.5, -14), "INCUBATOR", C(220, 170, 255), Enum.NormalId.Front)

	-- soleil en blocs au-dessus de la base (les planètes équipées tournent autour, côté client)
	local scf = cf * CFrame.new(0, 26, 8)
	local sun = part(plot, "Sun", Vector3.new(6, 6, 6), scf, C(255, 190, 60), NEON, { CanCollide = false, CastShadow = false })
	local sl = Instance.new("PointLight"); sl.Color = C(255, 200, 120); sl.Range = 45; sl.Brightness = 2.5; sl.Parent = sun
	deco(plot, "SunCore", Vector3.new(7.5, 4.5, 4.5), scf, C(255, 160, 40), NEON)
	deco(plot, "SunCore", Vector3.new(4.5, 7.5, 4.5), scf, C(255, 160, 40), NEON)
	deco(plot, "SunCore", Vector3.new(4.5, 4.5, 7.5), scf, C(255, 160, 40), NEON)
	for i = 1, 8 do
		local ra = i / 8 * math.pi * 2
		deco(plot, "SunRay", Vector3.new(1.2, 1.2, 3), scf * CFrame.Angles(0, ra, 0) * CFrame.new(0, 0, 6) * CFrame.Angles(0, 0, math.rad(45)), C(255, 220, 90), NEON)
		deco(plot, "SunRay", Vector3.new(1, 1, 2.4), scf * CFrame.Angles(ra, 0, math.rad(90)) * CFrame.new(0, 0, 6), C(255, 200, 70), NEON, { Transparency = 0.2 })
	end
	deco(plot, "SunGlow", Vector3.new(10, 10, 10), scf * CFrame.Angles(0, math.rad(45), math.rad(45)), C(255, 140, 40), NEON, { Transparency = 0.8 })

	-- déco de la base : plantes, cristaux, lampadaires à l'entrée
	plant(plot, cf * CFrame.new(W / 2 - 5, 0, D / 2 - 5), C(255, 120, 220))
	plant(plot, cf * CFrame.new(-W / 2 + 5, 0, D / 2 - 5), C(120, 220, 255))
	plant(plot, cf * CFrame.new(-W / 2 + 5, 0, -D / 2 + 5), C(255, 220, 90))
	crystals(plot, cf * CFrame.new(4, 0, D / 2 - 5), COL.edge)
	crystals(plot, cf * CFrame.new(W / 2 - 6, 0, -D / 2 + 6), COL.violet)
	lamp(plot, cf * CFrame.new(6, 0, -D / 2 + 3), COL.gold)
	lamp(plot, cf * CFrame.new(-6, 0, -D / 2 + 3), COL.gold)

	local dyn = Instance.new("Folder")
	dyn.Name = "Dynamic"
	dyn.Parent = plot
end

-- [ DÉCO : astéroïdes en blocs, cristaux, satellites ] ---------------------------
local decor = Instance.new("Folder")
decor.Name = "Decor"
decor.Parent = map
for i = 1, 40 do
	local a = rng:NextNumber() * math.pi * 2
	local r = rng:NextNumber(195, 330)
	local s = rng:NextNumber(4, 12)
	local cf = CFrame.new(math.cos(a) * r, rng:NextNumber(-60, 80), math.sin(a) * r) * CFrame.Angles(rng:NextNumber() * 6, rng:NextNumber() * 6, rng:NextNumber() * 6)
	-- astéroïde = 3 à 5 blocs collés
	for j = 1, rng:NextInteger(3, 5) do
		local bs = s * rng:NextNumber(0.45, 0.8)
		deco(decor, "Asteroid", Vector3.new(bs, bs * rng:NextNumber(0.6, 1), bs * rng:NextNumber(0.7, 1.1)),
			cf * CFrame.new(rng:NextNumber(-0.4, 0.4) * s, rng:NextNumber(-0.3, 0.3) * s, rng:NextNumber(-0.4, 0.4) * s),
			j % 2 == 0 and C(84, 70, 120) or C(70, 58, 104), PLASTIC)
	end
	if i % 3 == 0 then
		deco(decor, "Crystal", Vector3.new(s * 0.22, s * 0.7, s * 0.22), cf * CFrame.new(0, s * 0.55, 0) * CFrame.Angles(0, 0.7, 0), i % 2 == 0 and COL.edge or COL.violet, NEON)
	end
end
-- satellites
for i = 1, 6 do
	local a = i / 6 * math.pi * 2 + 0.3
	local cf = CFrame.new(math.cos(a) * 240, rng:NextNumber(40, 90), math.sin(a) * 240) * CFrame.Angles(0, a, rng:NextNumber(-0.4, 0.4))
	deco(decor, "Satellite", Vector3.new(3, 3, 4), cf, C(220, 220, 230), PLASTIC)
	deco(decor, "SatDish", Vector3.new(2.4, 0.4, 2.4), cf * CFrame.new(0, 2, 0), C(200, 200, 210), PLASTIC)
	for _, side in ipairs({ -1, 1 }) do
		deco(decor, "SolarPanel", Vector3.new(6, 0.3, 2.6), cf * CFrame.new(side * 5, 0, 0), C(40, 80, 200), PLASTIC)
		deco(decor, "SatArm", Vector3.new(2, 0.3, 0.3), cf * CFrame.new(side * 2, 0, 0), C(160, 160, 170), PLASTIC)
	end
	deco(decor, "SatLight", Vector3.new(0.6, 0.6, 0.6), cf * CFrame.new(0, 2.6, 0), C(255, 60, 60), NEON)
end
-- nébuleuses : grandes formes néon très transparentes, très loin
for i = 1, 10 do
	local a = rng:NextNumber() * math.pi * 2
	local r = rng:NextNumber(700, 900)
	local s = rng:NextNumber(200, 400)
	deco(decor, "Nebula", Vector3.new(s, s * 0.6, s), CFrame.new(math.cos(a) * r, rng:NextNumber(50, 300), math.sin(a) * r),
		i % 2 == 0 and C(120, 50, 220) or C(40, 120, 255), NEON,
		{ Shape = Enum.PartType.Ball, Transparency = 0.93 })
end

-- [ CIEL / LUMIÈRE ] -----------------------------------------------------------
Lighting.ClockTime = 0
Lighting.Brightness = 2
Lighting.Ambient = C(80, 70, 120)
Lighting.OutdoorAmbient = C(120, 105, 170)
Lighting.EnvironmentDiffuseScale = 0.4
Lighting.EnvironmentSpecularScale = 0.4
Lighting.GlobalShadows = true
for _, c in ipairs(Lighting:GetChildren()) do
	if c:IsA("Sky") or c:IsA("Atmosphere") or c:IsA("BloomEffect") or c:IsA("ColorCorrectionEffect") or c:IsA("SunRaysEffect") or c:IsA("DepthOfFieldEffect") then c:Destroy() end
end
local sky = Instance.new("Sky")
sky.StarCount = 6000
sky.CelestialBodiesShown = false
sky.Parent = Lighting
local bloom = Instance.new("BloomEffect")
bloom.Intensity = 0.6; bloom.Size = 30; bloom.Threshold = 1.6
bloom.Parent = Lighting
local cc = Instance.new("ColorCorrectionEffect")
cc.Saturation = 0.25; cc.Contrast = 0.08; cc.TintColor = C(240, 235, 255)
cc.Parent = Lighting
workspace.FallenPartsDestroyHeight = -120
workspace.StreamingEnabled = false -- petite map : tout est chargé, les orbites trouvent toujours le soleil
workspace.Gravity = 160

pcall(function() game:GetService("Players").MaxPlayers = 8 end)
local count = 0
for _, d in ipairs(map:GetDescendants()) do if d:IsA("BasePart") then count += 1 end end
local _ = CollectionService
return "Map construite (" .. count .. " parts)"
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX52"><Properties><string name="Name">GuiBuilder</string><ProtectedString name="Source"><![CDATA[-- GuiBuilder : à exécuter dans Studio (mode Edit). Construit TOUTES les interfaces dans StarterGui,
-- dans le style du kit K4LSH (images du kit + police Gotham ExtraBold + contour noir).
-- Les scripts du jeu ne créent pas d'interface : ils trouvent les éléments par leur nom.
-- Relançable : remplace HUD / Menus / Popups.

local StarterGui = game:GetService("StarterGui")

local IMG = {
	SquareDark = "rbxassetid://127062449162498",
	SquareOrange = "rbxassetid://73646313229415",
	SquarePink = "rbxassetid://77317040960880",
	BarGrey = "rbxassetid://103553873357333",
	BarLight = "rbxassetid://105496683105089",
	BarHeader = "rbxassetid://112249404449276",
	BarGreen = "rbxassetid://118147684330981",
	BarGreen2 = "rbxassetid://72484859487238",
	BarGold = "rbxassetid://130202638558172",
	BarRed = "rbxassetid://139238474736040",
	Body = "rbxassetid://75109179445868",
	Rebirth = "rbxassetid://102040339566414",
	Book = "rbxassetid://102082573689395",
	Shop = "rbxassetid://110119422421461",
	Gift = "rbxassetid://112101874744840",
	Index = "rbxassetid://134306875683469",
	Pencil = "rbxassetid://139929725096333",
	Crown = "rbxassetid://94666332436790",
	Robux = "rbxassetid://97272186997275",
	Gear = "rbxasset://textures/ui/Settings/MenuBarIcons/GameSettingsTab.png",
}
local FONT = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.ExtraBold)
local INK = Color3.fromRGB(5, 17, 40)

for _, n in ipairs({ "HUD", "Menus", "Popups" }) do
	local o = StarterGui:FindFirstChild(n)
	if o then o:Destroy() end
end

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end

local function ratio(parent, r)
	return new("UIAspectRatioConstraint", { AspectRatio = r }, parent)
end

local function stroke(parent, th)
	local s = new("UIStroke", { Color = INK, Thickness = th or 0.12, LineJoinMode = Enum.LineJoinMode.Round }, parent)
	pcall(function() s.StrokeSizingMode = Enum.StrokeSizingMode.ScaledSize end)
	return s
end

local function text(parent, name, str, pos, size, props)
	local t = new("TextLabel", {
		Name = name, Text = str, Position = pos, Size = size,
		BackgroundTransparency = 1, FontFace = FONT, TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1), ZIndex = 3,
	}, parent)
	if props then for k, v in pairs(props) do if k ~= "StrokeTh" then t[k] = v end end end
	stroke(t, props and props.StrokeTh or 0.12)
	return t
end

local function image(parent, name, img, pos, size, props)
	local i = new("ImageLabel", {
		Name = name, Image = img, Position = pos, Size = size,
		BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Stretch, ZIndex = 2,
	}, parent)
	if props then for k, v in pairs(props) do i[k] = v end end
	return i
end

-- bouton invisible qui couvre son parent (les effets survol/clic sont gérés par le client)
local function hit(parent, name)
	return new("ImageButton", {
		Name = name or "Button", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
		ImageTransparency = 1, ZIndex = 6, AutoButtonColor = false,
	}, parent)
end

-- bouton barre du kit (vert, rouge, or...) avec texte
local function barButton(parent, name, img, label, pos, size, r)
	-- ZIndex 4 : sinon le bouton passe SOUS l'image de fond de la ligne / carte qui le contient
	local f = new("Frame", { Name = name, Position = pos, Size = size, BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 4 }, parent)
	if r then ratio(f, r) end
	image(f, "Design", img, UDim2.fromScale(0, 0), UDim2.fromScale(1, 1))
	text(f, "Label", label, UDim2.fromScale(0.08, 0.14), UDim2.fromScale(0.84, 0.66))
	new("UIScale", { Name = "Pop" }, f)
	hit(f)
	return f
end

local function badge(parent)
	local b = new("Frame", { Name = "Badge", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.88, 0.12), Size = UDim2.fromScale(0.34, 0.34),
		BackgroundColor3 = Color3.fromRGB(255, 50, 70), Visible = false, ZIndex = 8 }, parent)
	ratio(b, 1)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, b)
	new("UIStroke", { Color = INK, Thickness = 2 }, b)
	text(b, "Label", "!", UDim2.fromScale(0.15, 0.1), UDim2.fromScale(0.7, 0.8), { ZIndex = 9 })
	return b
end

-- ============================================================================ HUD
local hud = new("ScreenGui", { Name = "HUD", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 1 }, StarterGui)
pcall(function() hud.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets end)

-- [ haut : argent ]
local top = new("Frame", { Name = "Top", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.01), Size = UDim2.fromScale(0.34, 0.15), BackgroundTransparency = 1 }, hud)
ratio(top, 3.4)
image(top, "MoneyIcon", "", UDim2.fromScale(0, 0.04), UDim2.fromScale(0.2, 0.62), { Visible = false })
text(top, "Money", "$0", UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.62), { TextColor3 = Color3.fromRGB(120, 255, 90) })
text(top, "Income", "+$0/s", UDim2.fromScale(0.15, 0.6), UDim2.fromScale(0.7, 0.32), { TextColor3 = Color3.fromRGB(255, 255, 255) })
local boosts = new("Frame", { Name = "Boosts", Position = UDim2.fromScale(0, 0.95), Size = UDim2.fromScale(1, 0.3), BackgroundTransparency = 1 }, top)
new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0.02, 0) }, boosts)
for _, b in ipairs({ { "Money", IMG.BarGreen2, "x2 $" }, { "Luck", IMG.BarLight, "x2 LUCK" } }) do
	local f = new("Frame", { Name = b[1], Size = UDim2.fromScale(0.3, 1), BackgroundTransparency = 1, Visible = false }, boosts)
	image(f, "Design", b[2], UDim2.fromScale(0, 0), UDim2.fromScale(1, 1))
	text(f, "Label", b[3] .. " 0s", UDim2.fromScale(0.06, 0.12), UDim2.fromScale(0.88, 0.7))
end

-- [ gauche : 2 colonnes de boutons carrés comme le kit ]
local left = new("Frame", { Name = "Left", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0.01, 0.52), Size = UDim2.fromScale(0.14, 0.5), BackgroundTransparency = 1 }, hud)
ratio(left, 0.62)
new("UIGridLayout", { CellSize = UDim2.fromScale(0.47, 0.3), CellPadding = UDim2.fromScale(0.06, 0.04), SortOrder = Enum.SortOrder.LayoutOrder }, left)
local leftButtons = {
	{ "VIP", IMG.Crown, "VIP", true },
	{ "Daily", IMG.Gift, "Rewards" },
	{ "Index", IMG.Index, "Index" },
	{ "Rebirth", IMG.Rebirth, "Rebirth" },
	{ "Codes", IMG.Pencil, "Codes" },
	{ "Settings", IMG.Gear, "Settings" },
}
for i, b in ipairs(leftButtons) do
